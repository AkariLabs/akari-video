{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_chapter_tag",
  "kind": "corner",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.3,
    "outDur": 0.25,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "chapterLabel",
      "type": "text",
      "label": "章ラベル",
      "default": "第1章"
    },
    {
      "key": "chapterTitle",
      "type": "text",
      "label": "章タイトル",
      "default": "問題の本質"
    },
    {
      "key": "color_primary",
      "type": "color",
      "label": "キーカラー（帯）",
      "default": "#1B4FD8"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "タイトル文字色",
      "default": "#ffffff"
    },
    {
      "key": "color_text_2",
      "type": "color",
      "label": "章ラベル文字色",
      "default": "#ffffff"
    },
    {
      "key": "color_shadow",
      "type": "color",
      "label": "タイトルのシャドウ色",
      "default": "rgba(0,0,0,0.5)"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "system-ui",
      "options": [
        "system-ui",
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ]
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 600
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（ずらし）",
      "default": 0
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（ずらし）",
      "default": 0
    }
  ],
  "layers": [
    {
      "id": "ref3_chapter_tag_badge",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "color_primary"
        },
        "cornerRadius": 6
      },
      "size": {
        "w": {
          "expr": "@ref3_chapter_tag_label.width + 40"
        },
        "h": {
          "expr": "@ref3_chapter_tag_label.height + 20"
        }
      },
      "transform": {
        "x": {
          "expr": "posX + 60"
        },
        "y": {
          "expr": "posY + 60"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -120,
              "ease": "out-cubic"
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.3,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.25,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_chapter_tag_label",
      "type": "text",
      "content": {
        "text": {
          "var": "chapterLabel"
        },
        "size": 25,
        "font": {
          "var": "fontFamily"
        },
        "weight": 600,
        "color": {
          "var": "color_text_2"
        },
        "align": "left"
      },
      "transform": {
        "x": {
          "expr": "posX + 80"
        },
        "y": {
          "expr": "posY + 70"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -120,
              "ease": "out-cubic"
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.3,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.25,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_chapter_tag_title",
      "type": "text",
      "content": {
        "text": {
          "var": "chapterTitle"
        },
        "size": 30,
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_text"
        },
        "align": "left",
        "shadow": {
          "color": {
            "var": "color_shadow"
          },
          "blur": 6,
          "x": 1,
          "y": 2
        }
      },
      "transform": {
        "x": {
          "expr": "posX + (60 + @ref3_chapter_tag_label.width + 40 + 12)"
        },
        "y": {
          "expr": "posY + (60 + (@ref3_chapter_tag_label.height + 20) / 2)"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -120,
              "ease": "out-cubic"
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.3,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.25,
              "v": 0
            }
          ]
        }
      ]
    }
  ]
}
