{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_chapter_tag",
  "kind": "corner",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.3,
    "outDur": 0.25,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "chapterLabel",
      "type": "text",
      "label": "章ラベル",
      "default": "第1章",
      "group": "badge",
      "role": "text"
    },
    {
      "key": "chapterTitle",
      "type": "text",
      "label": "章タイトル",
      "default": "問題の本質",
      "group": "main",
      "role": "text"
    },
    {
      "key": "color_primary",
      "type": "color",
      "label": "キーカラー（帯）",
      "default": "#1B4FD8",
      "group": "badge",
      "role": "color-accent"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "タイトル文字色",
      "default": "#ffffff",
      "group": "main",
      "role": "color"
    },
    {
      "key": "color_text_2",
      "type": "color",
      "label": "章ラベル文字色",
      "default": "#ffffff",
      "group": "badge",
      "role": "color"
    },
    {
      "key": "chapterLabelFontSize",
      "type": "number",
      "label": "章ラベル文字サイズ",
      "default": 25,
      "group": "badge",
      "role": "size"
    },
    {
      "key": "chapterTitleFontSize",
      "type": "number",
      "label": "章タイトル文字サイズ",
      "default": 30,
      "group": "main",
      "role": "size"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "system-ui",
      "options": [
        "system-ui",
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ],
      "group": "global",
      "role": "font"
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 600,
      "group": "global",
      "role": "weight"
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（中央基準）",
      "default": -900,
      "group": "global",
      "role": "pos-x"
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（中央基準）",
      "default": -480,
      "group": "global",
      "role": "pos-y"
    },
    {
      "key": "bgEnabled",
      "type": "bool",
      "label": "座布団",
      "default": true,
      "group": "fx",
      "role": "toggle"
    },
    {
      "key": "strokeEnabled",
      "type": "bool",
      "label": "縁取り",
      "default": false,
      "group": "fx",
      "role": "toggle"
    },
    {
      "key": "strokeWidth",
      "type": "number",
      "label": "縁取り太さ",
      "default": 2.1,
      "group": "fx",
      "role": "stroke-width"
    },
    {
      "key": "color_stroke",
      "type": "color",
      "label": "縁取り色",
      "default": "#000000",
      "group": "fx",
      "role": "color-stroke"
    },
    {
      "key": "shadowEnabled",
      "type": "bool",
      "label": "影",
      "default": true,
      "group": "fx",
      "role": "toggle"
    },
    {
      "key": "color_shadow",
      "type": "color",
      "label": "影色",
      "default": "rgba(0,0,0,0.5)",
      "group": "fx",
      "role": "color-shadow"
    },
    {
      "key": "glowEnabled",
      "type": "bool",
      "label": "グロー",
      "default": false,
      "group": "fx",
      "role": "toggle"
    },
    {
      "key": "color_glow",
      "type": "color",
      "label": "グロー色",
      "default": "#ffffff",
      "group": "fx",
      "role": "color-glow"
    },
    {
      "key": "glowStrength",
      "type": "number",
      "label": "グロー強度",
      "default": 1,
      "group": "fx",
      "role": "strength"
    },
    {
      "key": "letterSpacing",
      "type": "number",
      "label": "字間",
      "default": 0,
      "group": "fx",
      "role": "spacing"
    },
    {
      "key": "animIn",
      "type": "select",
      "label": "入りアニメ",
      "default": "original",
      "options": [
        "original",
        "none",
        "fade-in-out",
        "soft-fade",
        "fade-up",
        "fade-down",
        "cinematic-fade",
        "slide-left",
        "slide-right",
        "slide-up",
        "slide-down",
        "push-left",
        "push-right",
        "push-up",
        "push-down",
        "rise-soft",
        "drop-in",
        "zoom-in-out",
        "zoom-pop",
        "zoom-pulse",
        "pop",
        "bounce",
        "squash-pop",
        "stretch-in",
        "stomp",
        "snap",
        "rotate-in",
        "spin-in",
        "roll-in",
        "spiral-in",
        "swing",
        "shake",
        "jitter",
        "glitch",
        "flash",
        "heartbeat",
        "typewriter",
        "wipe-left",
        "wipe-right",
        "caption-rise"
      ],
      "group": "anim",
      "role": "anim-in"
    },
    {
      "key": "animOut",
      "type": "select",
      "label": "抜けアニメ",
      "default": "original",
      "options": [
        "original",
        "none",
        "fade-in-out",
        "soft-fade",
        "fade-up",
        "fade-down",
        "cinematic-fade",
        "slide-left",
        "slide-right",
        "slide-up",
        "slide-down",
        "push-left",
        "push-right",
        "push-up",
        "push-down",
        "rise-soft",
        "drop-in",
        "zoom-in-out",
        "zoom-pop",
        "zoom-pulse",
        "pop",
        "bounce",
        "squash-pop",
        "stretch-in",
        "stomp",
        "snap",
        "rotate-in",
        "spin-in",
        "roll-in",
        "spiral-in",
        "swing",
        "shake",
        "jitter",
        "glitch",
        "flash",
        "heartbeat",
        "typewriter",
        "wipe-left",
        "wipe-right",
        "caption-rise"
      ],
      "group": "anim",
      "role": "anim-out"
    },
    {
      "key": "animLoop",
      "type": "select",
      "label": "ループアニメ",
      "default": "original",
      "options": [
        "original",
        "none",
        "wobble",
        "float",
        "breath",
        "neon-flicker",
        "hologram",
        "retro-flicker",
        "news-ticker",
        "marquee-left",
        "crawl-up"
      ],
      "group": "anim",
      "role": "anim-loop"
    },
    {
      "key": "animInSec",
      "type": "number",
      "label": "入り時間（秒）",
      "default": 0.6,
      "group": "anim",
      "role": "anim-duration"
    },
    {
      "key": "animOutSec",
      "type": "number",
      "label": "抜け時間（秒）",
      "default": 0.6,
      "group": "anim",
      "role": "anim-duration"
    }
  ],
  "layers": [
    {
      "id": "ref3_chapter_tag_badge",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "color_primary"
        },
        "cornerRadius": 6
      },
      "size": {
        "w": {
          "expr": "@ref3_chapter_tag_label.width + 40"
        },
        "h": {
          "expr": "@ref3_chapter_tag_label.height + 20"
        }
      },
      "transform": {
        "x": {
          "expr": "0 + 60"
        },
        "y": {
          "expr": "0 + 60"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -120,
              "ease": "out-cubic"
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.3,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.25,
              "v": 0
            }
          ]
        }
      ],
      "fxTag": "bg"
    },
    {
      "id": "ref3_chapter_tag_label",
      "type": "text",
      "content": {
        "text": {
          "var": "chapterLabel"
        },
        "size": {
          "var": "chapterLabelFontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": 600,
        "color": {
          "var": "color_text_2"
        },
        "align": "left"
      },
      "transform": {
        "x": {
          "expr": "0 + 80"
        },
        "y": {
          "expr": "0 + 70"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -120,
              "ease": "out-cubic"
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.3,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.25,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_chapter_tag_title",
      "type": "text",
      "content": {
        "text": {
          "var": "chapterTitle"
        },
        "size": {
          "var": "chapterTitleFontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_text"
        },
        "align": "left",
        "shadow": {
          "color": {
            "var": "color_shadow"
          },
          "blur": 6,
          "x": 1,
          "y": 2
        }
      },
      "transform": {
        "x": {
          "expr": "0 + (60 + @ref3_chapter_tag_label.width + 40 + 12)"
        },
        "y": {
          "expr": "0 + (60 + (@ref3_chapter_tag_label.height + 20) / 2)"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -120,
              "ease": "out-cubic"
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.3,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.25,
              "v": 0
            }
          ]
        }
      ]
    }
  ],
  "groups": [
    {
      "id": "main",
      "label": "本文"
    },
    {
      "id": "badge",
      "label": "ラベル・バッジ"
    },
    {
      "id": "global",
      "label": "全体"
    },
    {
      "id": "fx",
      "label": "装飾"
    },
    {
      "id": "anim",
      "label": "アニメ"
    }
  ],
  "anchor": "tl"
}
