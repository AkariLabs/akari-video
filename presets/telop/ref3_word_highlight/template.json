{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_word_highlight",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.14,
    "outDur": 0.16,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "captionText",
      "type": "text",
      "label": "本文テキスト",
      "default": "THIS IS THE IMPORTANT PART"
    },
    {
      "key": "color_accent",
      "type": "color",
      "label": "アクティブカラー",
      "default": "#FFD93D"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "ベースカラー",
      "default": "#FFFFFF"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "フォントサイズ",
      "default": 72
    },
    {
      "key": "plateOpacity",
      "type": "number",
      "label": "プレート透明度",
      "default": 0.72
    },
    {
      "key": "staggerAdjust",
      "type": "number",
      "label": "stagger調整",
      "default": 0.45
    },
    {
      "key": "color_bg",
      "type": "color",
      "label": "プレート背景色",
      "default": "#000000"
    },
    {
      "key": "color_stroke",
      "type": "color",
      "label": "縁色（外）",
      "default": "rgba(0,0,0,0.92)"
    },
    {
      "key": "color_stroke_2",
      "type": "color",
      "label": "縁色（内）",
      "default": "rgba(0,0,0,0.45)"
    },
    {
      "key": "color_shadow",
      "type": "color",
      "label": "影色",
      "default": "rgba(0,0,0,0.65)"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "'Noto Sans JP', sans-serif",
      "options": [
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ]
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 900
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（ずらし）",
      "default": 0
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（ずらし）",
      "default": 0
    }
  ],
  "layers": [
    {
      "id": "ref3_word_highlight_plate",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "color_bg"
        },
        "cornerRadius": 18
      },
      "size": {
        "w": {
          "expr": "min(max(@ref3_word_highlight_text.width + 128, 720), @stage.width - 32)"
        },
        "h": {
          "expr": "@ref3_word_highlight_text.height + 56"
        }
      },
      "transform": {
        "x": {
          "expr": "posX + (@stage.width / 2)"
        },
        "y": {
          "expr": "posY + (@stage.height * 0.72)"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        },
        "opacity": {
          "var": "plateOpacity"
        }
      }
    },
    {
      "id": "ref3_word_highlight_text",
      "type": "text",
      "content": {
        "text": {
          "var": "captionText"
        },
        "size": {
          "var": "fontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_text"
        },
        "align": "center",
        "letterSpacing": 12,
        "strokes": [
          {
            "color": {
              "var": "color_stroke"
            },
            "width": 8
          },
          {
            "color": {
              "var": "color_stroke_2"
            },
            "width": 3
          }
        ],
        "shadow": {
          "color": {
            "var": "color_shadow"
          },
          "blur": 10,
          "x": 0,
          "y": 4
        }
      },
      "transform": {
        "x": {
          "expr": "posX + (@stage.width / 2)"
        },
        "y": {
          "expr": "posY + (@stage.height * 0.72)"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.14,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.16,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ],
      "perChar": {
        "split": "word",
        "stagger": 0.45,
        "tracks": [],
        "active": {
          "color": "#FFD93D",
          "mode": "flash"
        }
      },
      "fit": {
        "maxWidth": {
          "expr": "@stage.width - 32 - 128"
        },
        "minScale": 0.12
      }
    },
    {
      "id": "ref3_word_highlight_active",
      "type": "text",
      "content": {
        "text": {
          "var": "captionText"
        },
        "size": {
          "var": "fontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": 900,
        "color": {
          "var": "color_accent"
        },
        "align": "center",
        "letterSpacing": 12,
        "strokes": [
          {
            "color": {
              "var": "color_stroke"
            },
            "width": 8
          },
          {
            "color": {
              "var": "color_stroke_2"
            },
            "width": 3
          }
        ],
        "shadow": {
          "color": {
            "var": "color_shadow"
          },
          "blur": 10,
          "x": 0,
          "y": 4
        }
      },
      "transform": {
        "x": {
          "expr": "posX + (@stage.width / 2)"
        },
        "y": {
          "expr": "posY + (@stage.height * 0.72)"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.14,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.16,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ],
      "perChar": {
        "split": "word",
        "stagger": 0.45,
        "tracks": [
          {
            "prop": "opacity",
            "phase": "in",
            "keys": [
              {
                "t": 0,
                "v": 0,
                "ease": "step"
              },
              {
                "t": 0.02,
                "v": 1
              }
            ]
          }
        ]
      },
      "fit": {
        "maxWidth": {
          "expr": "@stage.width - 32 - 128"
        },
        "minScale": 0.12
      }
    }
  ]
}
