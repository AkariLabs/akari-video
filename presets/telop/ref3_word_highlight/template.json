{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_word_highlight",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.14,
    "outDur": 0.16,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "captionText",
      "type": "text",
      "label": "本文テキスト",
      "default": "THIS IS THE IMPORTANT PART",
      "group": "main",
      "role": "text"
    },
    {
      "key": "color_accent",
      "type": "color",
      "label": "アクティブカラー",
      "default": "#FFD93D",
      "group": "main",
      "role": "color-accent"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "ベースカラー",
      "default": "#FFFFFF",
      "group": "main",
      "role": "color"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "フォントサイズ",
      "default": 72,
      "group": "main",
      "role": "size"
    },
    {
      "key": "plateOpacity",
      "type": "number",
      "label": "プレート透明度",
      "default": 0.72,
      "group": "band",
      "role": "strength"
    },
    {
      "key": "staggerAdjust",
      "type": "number",
      "label": "stagger調整",
      "default": 0.45,
      "group": "global",
      "role": "interval"
    },
    {
      "key": "color_bg",
      "type": "color",
      "label": "プレート背景色",
      "default": "#000000",
      "group": "band",
      "role": "color-bg"
    },
    {
      "key": "color_stroke",
      "type": "color",
      "label": "縁色（外）",
      "default": "rgba(0,0,0,0.92)",
      "group": "main",
      "role": "color-stroke"
    },
    {
      "key": "color_stroke_2",
      "type": "color",
      "label": "縁色（内）",
      "default": "rgba(0,0,0,0.45)",
      "group": "main",
      "role": "color-stroke"
    },
    {
      "key": "color_shadow",
      "type": "color",
      "label": "影色",
      "default": "rgba(0,0,0,0.65)",
      "group": "main",
      "role": "color-shadow"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "'Noto Sans JP', sans-serif",
      "options": [
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ],
      "group": "global",
      "role": "font"
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 900,
      "group": "global",
      "role": "weight"
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（中央基準）",
      "default": 0,
      "group": "global",
      "role": "pos-x"
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（中央基準）",
      "default": 237.6,
      "group": "global",
      "role": "pos-y"
    },
    {
      "key": "animIn",
      "type": "select",
      "label": "入りアニメ",
      "default": "original",
      "options": [
        "original",
        "none",
        "fade-in-out",
        "soft-fade",
        "fade-up",
        "fade-down",
        "cinematic-fade",
        "slide-left",
        "slide-right",
        "slide-up",
        "slide-down",
        "push-left",
        "push-right",
        "push-up",
        "push-down",
        "rise-soft",
        "drop-in",
        "zoom-in-out",
        "zoom-pop",
        "zoom-pulse",
        "pop",
        "bounce",
        "squash-pop",
        "stretch-in",
        "stomp",
        "snap",
        "rotate-in",
        "spin-in",
        "roll-in",
        "spiral-in",
        "swing",
        "shake",
        "jitter",
        "glitch",
        "flash",
        "heartbeat",
        "typewriter",
        "wipe-left",
        "wipe-right",
        "caption-rise"
      ],
      "group": "anim",
      "role": "anim-in"
    },
    {
      "key": "animOut",
      "type": "select",
      "label": "抜けアニメ",
      "default": "original",
      "options": [
        "original",
        "none",
        "fade-in-out",
        "soft-fade",
        "fade-up",
        "fade-down",
        "cinematic-fade",
        "slide-left",
        "slide-right",
        "slide-up",
        "slide-down",
        "push-left",
        "push-right",
        "push-up",
        "push-down",
        "rise-soft",
        "drop-in",
        "zoom-in-out",
        "zoom-pop",
        "zoom-pulse",
        "pop",
        "bounce",
        "squash-pop",
        "stretch-in",
        "stomp",
        "snap",
        "rotate-in",
        "spin-in",
        "roll-in",
        "spiral-in",
        "swing",
        "shake",
        "jitter",
        "glitch",
        "flash",
        "heartbeat",
        "typewriter",
        "wipe-left",
        "wipe-right",
        "caption-rise"
      ],
      "group": "anim",
      "role": "anim-out"
    },
    {
      "key": "animLoop",
      "type": "select",
      "label": "ループアニメ",
      "default": "original",
      "options": [
        "original",
        "none",
        "wobble",
        "float",
        "breath",
        "neon-flicker",
        "hologram",
        "retro-flicker",
        "news-ticker",
        "marquee-left",
        "crawl-up"
      ],
      "group": "anim",
      "role": "anim-loop"
    },
    {
      "key": "animInSec",
      "type": "number",
      "label": "入り時間（秒）",
      "default": 0.6,
      "group": "anim",
      "role": "anim-duration"
    },
    {
      "key": "animOutSec",
      "type": "number",
      "label": "抜け時間（秒）",
      "default": 0.6,
      "group": "anim",
      "role": "anim-duration"
    }
  ],
  "layers": [
    {
      "id": "ref3_word_highlight_plate",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "color_bg"
        },
        "cornerRadius": 18
      },
      "size": {
        "w": {
          "expr": "min(max(@ref3_word_highlight_text.width + 128, 720), @stage.width - 32)"
        },
        "h": {
          "expr": "@ref3_word_highlight_text.height + 56"
        }
      },
      "transform": {
        "x": {
          "expr": "0 + (@stage.width / 2)"
        },
        "y": {
          "expr": "0 + (@stage.height * 0.72)"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        },
        "opacity": {
          "var": "plateOpacity"
        }
      }
    },
    {
      "id": "ref3_word_highlight_text",
      "type": "text",
      "content": {
        "text": {
          "var": "captionText"
        },
        "size": {
          "var": "fontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_text"
        },
        "align": "center",
        "letterSpacing": 12,
        "strokes": [
          {
            "color": {
              "var": "color_stroke"
            },
            "width": 8
          },
          {
            "color": {
              "var": "color_stroke_2"
            },
            "width": 3
          }
        ],
        "shadow": {
          "color": {
            "var": "color_shadow"
          },
          "blur": 10,
          "x": 0,
          "y": 4
        }
      },
      "transform": {
        "x": {
          "expr": "0 + (@stage.width / 2)"
        },
        "y": {
          "expr": "0 + (@stage.height * 0.72)"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.14,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.16,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ],
      "perChar": {
        "split": "word",
        "stagger": 0.45,
        "tracks": [],
        "active": {
          "color": "#FFD93D",
          "mode": "flash"
        }
      },
      "fit": {
        "maxWidth": {
          "expr": "@stage.width - 32 - 128"
        },
        "minScale": 0.12
      }
    },
    {
      "id": "ref3_word_highlight_active",
      "type": "text",
      "content": {
        "text": {
          "var": "captionText"
        },
        "size": {
          "var": "fontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": 900,
        "color": {
          "var": "color_accent"
        },
        "align": "center",
        "letterSpacing": 12,
        "strokes": [
          {
            "color": {
              "var": "color_stroke"
            },
            "width": 8
          },
          {
            "color": {
              "var": "color_stroke_2"
            },
            "width": 3
          }
        ],
        "shadow": {
          "color": {
            "var": "color_shadow"
          },
          "blur": 10,
          "x": 0,
          "y": 4
        }
      },
      "transform": {
        "x": {
          "expr": "0 + (@stage.width / 2)"
        },
        "y": {
          "expr": "0 + (@stage.height * 0.72)"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.14,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.16,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ],
      "perChar": {
        "split": "word",
        "stagger": 0.45,
        "tracks": [
          {
            "prop": "opacity",
            "phase": "in",
            "keys": [
              {
                "t": 0,
                "v": 0,
                "ease": "step"
              },
              {
                "t": 0.02,
                "v": 1
              }
            ]
          }
        ]
      },
      "fit": {
        "maxWidth": {
          "expr": "@stage.width - 32 - 128"
        },
        "minScale": 0.12
      }
    }
  ],
  "groups": [
    {
      "id": "main",
      "label": "本文"
    },
    {
      "id": "band",
      "label": "帯・背景"
    },
    {
      "id": "global",
      "label": "全体"
    },
    {
      "id": "anim",
      "label": "アニメ"
    }
  ],
  "anchor": "mc"
}
