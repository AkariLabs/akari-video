{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_bilingual_lesson",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 1,
    "outDur": 0.3,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "foreignText",
      "type": "text",
      "label": "外国語テキスト",
      "default": "Could you say that again?"
    },
    {
      "key": "japaneseText",
      "type": "text",
      "label": "日本語訳テキスト",
      "default": "もう一度言ってもらえますか？"
    },
    {
      "key": "color_bg",
      "type": "color",
      "label": "帯色",
      "default": "rgba(0,0,0,0.72)"
    },
    {
      "key": "color_bg_2",
      "type": "color",
      "label": "帯ハイライト色",
      "default": "rgba(255,255,255,0.10)"
    },
    {
      "key": "color_accent",
      "type": "color",
      "label": "強調色（外国語）",
      "default": "#FFD940"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "日本語訳色",
      "default": "#FFFFFF"
    },
    {
      "key": "color_stroke",
      "type": "color",
      "label": "縁取り色",
      "default": "rgba(0,0,0,0.92)"
    },
    {
      "key": "color_shadow",
      "type": "color",
      "label": "影色",
      "default": "rgba(0,0,0,0.50)"
    },
    {
      "key": "foreignFontSize",
      "type": "number",
      "label": "外国語フォントサイズ",
      "default": 60
    },
    {
      "key": "japaneseFontSize",
      "type": "number",
      "label": "日本語訳フォントサイズ",
      "default": 47
    },
    {
      "key": "bandHeight",
      "type": "number",
      "label": "帯の高さ",
      "default": 190
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "'Helvetica Neue', Arial, system-ui, sans-serif",
      "options": [
        "'Helvetica Neue', Arial, system-ui, sans-serif",
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ]
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 800
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（ずらし）",
      "default": 0
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（ずらし）",
      "default": 0
    }
  ],
  "layers": [
    {
      "id": "ref3_bilingual_lesson_band",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "color_bg"
        },
        "cornerRadius": 18
      },
      "size": {
        "w": {
          "expr": "max(max(@ref3_bilingual_lesson_foreign.width, @ref3_bilingual_lesson_japanese.width) + 180, 980)"
        },
        "h": {
          "var": "bandHeight"
        }
      },
      "transform": {
        "x": {
          "expr": "posX + (@stage.width / 2)"
        },
        "y": {
          "expr": "posY + 785"
        },
        "anchor": {
          "x": 0.5,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.3,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_bilingual_lesson_band_highlight",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "color_bg_2"
        },
        "cornerRadius": 18
      },
      "size": {
        "w": {
          "expr": "max(max(@ref3_bilingual_lesson_foreign.width, @ref3_bilingual_lesson_japanese.width) + 180, 980)"
        },
        "h": {
          "expr": "bandHeight / 2"
        }
      },
      "transform": {
        "x": {
          "expr": "posX + (@stage.width / 2)"
        },
        "y": {
          "expr": "posY + 785"
        },
        "anchor": {
          "x": 0.5,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.3,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_bilingual_lesson_foreign",
      "type": "text",
      "content": {
        "text": {
          "var": "foreignText"
        },
        "size": 60,
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_accent"
        },
        "align": "center",
        "strokes": [
          {
            "color": {
              "var": "color_stroke"
            },
            "width": 7
          }
        ],
        "shadow": {
          "color": {
            "var": "color_shadow"
          },
          "blur": 2,
          "x": 0,
          "y": 2
        }
      },
      "transform": {
        "x": {
          "expr": "posX + (@stage.width / 2)"
        },
        "y": {
          "expr": "posY + 845"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.3,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_bilingual_lesson_japanese",
      "type": "text",
      "content": {
        "text": {
          "var": "japaneseText"
        },
        "size": 47,
        "font": "'Noto Sans JP', sans-serif",
        "weight": 700,
        "color": {
          "var": "color_text"
        },
        "align": "center",
        "strokes": [
          {
            "color": {
              "var": "color_stroke"
            },
            "width": 5
          }
        ],
        "shadow": {
          "color": {
            "var": "color_shadow"
          },
          "blur": 2,
          "x": 0,
          "y": 2
        }
      },
      "transform": {
        "x": {
          "expr": "posX + (@stage.width / 2)"
        },
        "y": {
          "expr": "posY + 925"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0.5,
              "v": 0
            },
            {
              "t": 1,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ]
    }
  ]
}
