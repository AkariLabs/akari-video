{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_linear_h_gradient",
  "kind": "lower-third",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.32,
    "outDur": 0.28,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "color_bg",
      "type": "color",
      "label": "キーカラー",
      "default": "#1168D8"
    },
    {
      "key": "label",
      "type": "text",
      "label": "表示テキスト",
      "default": "現場から最新情報"
    },
    {
      "key": "textSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 68
    },
    {
      "key": "bannerHeight",
      "type": "number",
      "label": "帯の高さ",
      "default": 118
    },
    {
      "key": "color_accent",
      "type": "color",
      "label": "下線色",
      "default": "#F5C84B"
    },
    {
      "key": "xOffset",
      "type": "number",
      "label": "X位置調整",
      "default": 0
    },
    {
      "key": "color_bg_2",
      "type": "color",
      "label": "帯グラデ終端（既定は透明フェード）",
      "default": "rgba(0,0,0,0)"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "文字色",
      "default": "#FFFFFF"
    },
    {
      "key": "color_shadow",
      "type": "color",
      "label": "影色",
      "default": "rgba(0,0,0,0.38)"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "'Noto Sans JP', sans-serif",
      "options": [
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ]
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 900
    }
  ],
  "layers": [
    {
      "id": "ref3_linear_h_gradient_band",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "color_bg"
        },
        "fillGradient": {
          "type": "linear-h",
          "stops": [
            {
              "at": 0,
              "color": {
                "var": "color_bg"
              }
            },
            {
              "at": 1,
              "color": {
                "var": "color_bg_2"
              }
            }
          ]
        },
        "cornerRadius": 0
      },
      "size": {
        "w": {
          "expr": "max(@ref3_linear_h_gradient_label.width + 128, 820)"
        },
        "h": {
          "var": "bannerHeight"
        }
      },
      "transform": {
        "x": {
          "expr": "96 + xOffset"
        },
        "y": {
          "expr": "@stage.height * 0.74"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -360,
              "ease": "out-cubic"
            },
            {
              "t": 0.32,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.12,
              "v": 1
            }
          ]
        },
        {
          "prop": "x",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "in-cubic"
            },
            {
              "t": 0.28,
              "v": 260
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.28,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_linear_h_gradient_underline",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "color_accent"
        },
        "cornerRadius": 0
      },
      "size": {
        "w": {
          "expr": "max(@ref3_linear_h_gradient_label.width + 128, 820)"
        },
        "h": 6
      },
      "transform": {
        "x": {
          "expr": "96 + xOffset"
        },
        "y": {
          "expr": "@stage.height * 0.74 + bannerHeight"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -360,
              "ease": "out-cubic"
            },
            {
              "t": 0.32,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.12,
              "v": 1
            }
          ]
        },
        {
          "prop": "x",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "in-cubic"
            },
            {
              "t": 0.28,
              "v": 260
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.28,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_linear_h_gradient_label",
      "type": "text",
      "content": {
        "text": {
          "var": "label"
        },
        "size": {
          "var": "textSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_text"
        },
        "align": "left",
        "letterSpacing": 0,
        "shadow": {
          "color": {
            "var": "color_shadow"
          },
          "blur": 8,
          "x": 2,
          "y": 3
        }
      },
      "transform": {
        "x": {
          "expr": "136 + xOffset"
        },
        "y": {
          "expr": "@stage.height * 0.74 + bannerHeight / 2"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -360,
              "ease": "out-cubic"
            },
            {
              "t": 0.32,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.12,
              "v": 1
            }
          ]
        },
        {
          "prop": "x",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "in-cubic"
            },
            {
              "t": 0.28,
              "v": 260
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.28,
              "v": 0
            }
          ]
        }
      ]
    }
  ]
}
