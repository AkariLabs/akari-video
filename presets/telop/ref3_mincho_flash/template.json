{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_mincho_flash",
  "kind": "free",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 2,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.04,
    "outDur": 0.04,
    "hold": "stretch",
    "previewTotal": 2.5
  },
  "variables": [
    {
      "key": "word",
      "type": "text",
      "label": "本文（1行目）",
      "default": "絶望",
      "group": "main",
      "role": "text"
    },
    {
      "key": "text2",
      "type": "text",
      "label": "2行目（省略可）",
      "default": "",
      "optional": true,
      "group": "sub",
      "role": "text"
    },
    {
      "key": "color_bg",
      "type": "color",
      "label": "背景色",
      "default": "#ffffff",
      "group": "band",
      "role": "color-bg"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "文字色",
      "default": "#111111",
      "group": "global",
      "role": "color"
    },
    {
      "key": "wordFontSize",
      "type": "number",
      "label": "本文（1行目）文字サイズ",
      "default": 486,
      "group": "main",
      "role": "size"
    },
    {
      "key": "text2FontSize",
      "type": "number",
      "label": "2行目（省略可）文字サイズ",
      "default": 216,
      "group": "sub",
      "role": "size"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "'Noto Serif JP', serif",
      "options": [
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ],
      "group": "global",
      "role": "font"
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 800,
      "group": "global",
      "role": "weight"
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（中央基準）",
      "default": 0,
      "group": "global",
      "role": "pos-x"
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（中央基準）",
      "default": 0,
      "group": "global",
      "role": "pos-y"
    },
    {
      "key": "animIn",
      "type": "select",
      "label": "入りアニメ",
      "default": "original",
      "options": [
        "original",
        "none",
        "fade-in-out",
        "soft-fade",
        "fade-up",
        "fade-down",
        "cinematic-fade",
        "slide-left",
        "slide-right",
        "slide-up",
        "slide-down",
        "push-left",
        "push-right",
        "push-up",
        "push-down",
        "rise-soft",
        "drop-in",
        "zoom-in-out",
        "zoom-pop",
        "zoom-pulse",
        "pop",
        "bounce",
        "squash-pop",
        "stretch-in",
        "stomp",
        "snap",
        "rotate-in",
        "spin-in",
        "roll-in",
        "spiral-in",
        "swing",
        "shake",
        "jitter",
        "glitch",
        "flash",
        "heartbeat",
        "typewriter",
        "wipe-left",
        "wipe-right",
        "caption-rise"
      ],
      "group": "anim",
      "role": "anim-in"
    },
    {
      "key": "animOut",
      "type": "select",
      "label": "抜けアニメ",
      "default": "original",
      "options": [
        "original",
        "none",
        "fade-in-out",
        "soft-fade",
        "fade-up",
        "fade-down",
        "cinematic-fade",
        "slide-left",
        "slide-right",
        "slide-up",
        "slide-down",
        "push-left",
        "push-right",
        "push-up",
        "push-down",
        "rise-soft",
        "drop-in",
        "zoom-in-out",
        "zoom-pop",
        "zoom-pulse",
        "pop",
        "bounce",
        "squash-pop",
        "stretch-in",
        "stomp",
        "snap",
        "rotate-in",
        "spin-in",
        "roll-in",
        "spiral-in",
        "swing",
        "shake",
        "jitter",
        "glitch",
        "flash",
        "heartbeat",
        "typewriter",
        "wipe-left",
        "wipe-right",
        "caption-rise"
      ],
      "group": "anim",
      "role": "anim-out"
    },
    {
      "key": "animLoop",
      "type": "select",
      "label": "ループアニメ",
      "default": "original",
      "options": [
        "original",
        "none",
        "wobble",
        "float",
        "breath",
        "neon-flicker",
        "hologram",
        "retro-flicker",
        "news-ticker",
        "marquee-left",
        "crawl-up"
      ],
      "group": "anim",
      "role": "anim-loop"
    },
    {
      "key": "animInSec",
      "type": "number",
      "label": "入り時間（秒）",
      "default": 0.6,
      "group": "anim",
      "role": "anim-duration"
    },
    {
      "key": "animOutSec",
      "type": "number",
      "label": "抜け時間（秒）",
      "default": 0.6,
      "group": "anim",
      "role": "anim-duration"
    }
  ],
  "layers": [
    {
      "id": "ref3_mincho_flash_bg",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "color_bg"
        }
      },
      "size": {
        "w": {
          "expr": "@stage.width"
        },
        "h": {
          "expr": "@stage.height"
        }
      },
      "transform": {
        "x": {
          "expr": "0 + 0"
        },
        "y": {
          "expr": "0 + 0"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.04,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "step"
            },
            {
              "t": 0.04,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_mincho_flash_text1",
      "type": "text",
      "content": {
        "text": {
          "var": "word"
        },
        "size": {
          "var": "wordFontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_text"
        },
        "align": "center"
      },
      "transform": {
        "x": {
          "expr": "0 + (@stage.width / 2)"
        },
        "y": {
          "expr": "0 + (@stage.height / 2)"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.04,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "step"
            },
            {
              "t": 0.04,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_mincho_flash_text2",
      "type": "text",
      "content": {
        "text": {
          "var": "text2"
        },
        "size": {
          "var": "text2FontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": 800,
        "color": {
          "var": "color_text"
        },
        "align": "center"
      },
      "transform": {
        "x": {
          "expr": "0 + (@stage.width / 2)"
        },
        "y": {
          "expr": "0 + (@stage.height / 2 + 300)"
        },
        "anchor": {
          "x": 0.5,
          "y": 0
        }
      },
      "visibleIf": {
        "expr": "has(text2)"
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.04,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "step"
            },
            {
              "t": 0.04,
              "v": 0
            }
          ]
        }
      ]
    }
  ],
  "groups": [
    {
      "id": "main",
      "label": "本文"
    },
    {
      "id": "sub",
      "label": "補足"
    },
    {
      "id": "band",
      "label": "帯・背景"
    },
    {
      "id": "global",
      "label": "全体"
    },
    {
      "id": "anim",
      "label": "アニメ"
    }
  ],
  "anchor": "mc"
}
