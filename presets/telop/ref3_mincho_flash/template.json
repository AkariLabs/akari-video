{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_mincho_flash",
  "kind": "free",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 2,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.04,
    "outDur": 0.04,
    "hold": "stretch",
    "previewTotal": 2.5
  },
  "variables": [
    {
      "key": "word",
      "type": "text",
      "label": "本文（1行目）",
      "default": "絶望"
    },
    {
      "key": "text2",
      "type": "text",
      "label": "2行目（省略可）",
      "default": "",
      "optional": true
    },
    {
      "key": "color_bg",
      "type": "color",
      "label": "背景色",
      "default": "#ffffff"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "文字色",
      "default": "#111111"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "'Noto Serif JP', serif",
      "options": [
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ]
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 800
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（ずらし）",
      "default": 0
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（ずらし）",
      "default": 0
    }
  ],
  "layers": [
    {
      "id": "ref3_mincho_flash_bg",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "color_bg"
        }
      },
      "size": {
        "w": {
          "expr": "@stage.width"
        },
        "h": {
          "expr": "@stage.height"
        }
      },
      "transform": {
        "x": {
          "expr": "posX + 0"
        },
        "y": {
          "expr": "posY + 0"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.04,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "step"
            },
            {
              "t": 0.04,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_mincho_flash_text1",
      "type": "text",
      "content": {
        "text": {
          "var": "word"
        },
        "size": 486,
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_text"
        },
        "align": "center"
      },
      "transform": {
        "x": {
          "expr": "posX + (@stage.width / 2)"
        },
        "y": {
          "expr": "posY + (@stage.height / 2)"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.04,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "step"
            },
            {
              "t": 0.04,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_mincho_flash_text2",
      "type": "text",
      "content": {
        "text": {
          "var": "text2"
        },
        "size": 216,
        "font": {
          "var": "fontFamily"
        },
        "weight": 800,
        "color": {
          "var": "color_text"
        },
        "align": "center"
      },
      "transform": {
        "x": {
          "expr": "posX + (@stage.width / 2)"
        },
        "y": {
          "expr": "posY + (@stage.height / 2 + 300)"
        },
        "anchor": {
          "x": 0.5,
          "y": 0
        }
      },
      "visibleIf": {
        "expr": "has(text2)"
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.04,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "step"
            },
            {
              "t": 0.04,
              "v": 0
            }
          ]
        }
      ]
    }
  ]
}
