{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_hormozi_snap",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.1,
    "outDur": 0.12,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "normalText",
      "type": "text",
      "label": "前半テキスト（通常語）",
      "default": "この動画を見れば",
      "group": "main",
      "role": "text"
    },
    {
      "key": "emphasisText",
      "type": "text",
      "label": "強調語",
      "default": "全部わかる",
      "group": "accent",
      "role": "text"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "通常語の文字色",
      "default": "#ffffff",
      "group": "main",
      "role": "color"
    },
    {
      "key": "color_accent",
      "type": "color",
      "label": "強調語の文字色（アクセント）",
      "default": "#ffd400",
      "group": "accent",
      "role": "color-accent"
    },
    {
      "key": "color_stroke",
      "type": "color",
      "label": "縁取り色（両レイヤー共通）",
      "default": "#000000",
      "group": "global",
      "role": "color-stroke"
    },
    {
      "key": "color_shadow",
      "type": "color",
      "label": "ドロップシャドウ色",
      "default": "rgba(0,0,0,0.75)",
      "group": "global",
      "role": "color-shadow"
    },
    {
      "key": "normalTextFontSize",
      "type": "number",
      "label": "前半テキスト（通常語）文字サイズ",
      "default": 108,
      "group": "main",
      "role": "size"
    },
    {
      "key": "emphasisTextFontSize",
      "type": "number",
      "label": "強調語文字サイズ",
      "default": 128,
      "group": "accent",
      "role": "size"
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（中央基準）",
      "default": 160,
      "group": "global",
      "role": "pos-y"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "system-ui",
      "options": [
        "system-ui",
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ],
      "group": "global",
      "role": "font"
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 900,
      "group": "global",
      "role": "weight"
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（中央基準）",
      "default": -110,
      "group": "global",
      "role": "pos-x"
    }
  ],
  "layers": [
    {
      "id": "ref3_hormozi_snap_normal",
      "type": "text",
      "content": {
        "text": {
          "var": "normalText"
        },
        "size": {
          "var": "normalTextFontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": 900,
        "color": {
          "var": "color_text"
        },
        "align": "left",
        "strokes": [
          {
            "color": {
              "var": "color_stroke"
            },
            "width": 12
          }
        ],
        "shadow": {
          "color": {
            "var": "color_shadow"
          },
          "blur": 8,
          "x": 3,
          "y": 3
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2 - 20"
        },
        "y": 700,
        "anchor": {
          "x": 1,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.01,
              "v": 1
            }
          ]
        },
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 1.18,
              "ease": "out-cubic"
            },
            {
              "t": 0.1,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.12,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_hormozi_snap_emphasis",
      "type": "text",
      "content": {
        "text": {
          "var": "emphasisText"
        },
        "size": {
          "var": "emphasisTextFontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_accent"
        },
        "align": "left",
        "strokes": [
          {
            "color": {
              "var": "color_stroke"
            },
            "width": 14
          }
        ],
        "shadow": {
          "color": {
            "var": "color_shadow"
          },
          "blur": 8,
          "x": 3,
          "y": 3
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2 + 20"
        },
        "y": 700,
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.01,
              "v": 1
            }
          ]
        },
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 1.18,
              "ease": "out-cubic"
            },
            {
              "t": 0.1,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.12,
              "v": 0
            }
          ]
        }
      ]
    }
  ],
  "groups": [
    {
      "id": "main",
      "label": "本文"
    },
    {
      "id": "accent",
      "label": "強調"
    },
    {
      "id": "global",
      "label": "全体"
    }
  ],
  "anchor": "mc"
}
