{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_webvtt_shadow",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.18,
    "outDur": 0.2,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "字幕テキスト（メイン）",
      "default": "これはテロップのサンプルです",
      "group": "main",
      "role": "text"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "文字色",
      "default": "#FFFFFF",
      "group": "main",
      "role": "color"
    },
    {
      "key": "color_shadow",
      "type": "color",
      "label": "影色",
      "default": "#000000",
      "group": "main",
      "role": "color-shadow"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "字幕テキスト（メイン）文字サイズ",
      "default": 64,
      "group": "main",
      "role": "size"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "system-ui",
      "options": [
        "system-ui",
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ],
      "group": "global",
      "role": "font"
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 600,
      "group": "global",
      "role": "weight"
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（中央基準）",
      "default": 0,
      "group": "global",
      "role": "pos-x"
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（中央基準）",
      "default": 418.4,
      "group": "global",
      "role": "pos-y"
    }
  ],
  "layers": [
    {
      "id": "ref3_webvtt_shadow_text",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_text"
        },
        "align": "center",
        "shadow": {
          "color": {
            "var": "color_shadow"
          },
          "blur": 3,
          "x": 1,
          "y": 1
        }
      },
      "transform": {
        "x": {
          "expr": "0 + (@stage.width / 2)"
        },
        "y": {
          "expr": "0 + 920"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.18,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0
            }
          ]
        }
      ]
    }
  ],
  "groups": [
    {
      "id": "main",
      "label": "本文"
    },
    {
      "id": "global",
      "label": "全体"
    }
  ],
  "anchor": "bc"
}
