{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_ruby_caption",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.2,
    "outDur": 0.2,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "本文",
      "default": "字幕テキスト",
      "group": "main",
      "role": "text"
    },
    {
      "key": "rubyText",
      "type": "text",
      "label": "ルビ（空で非表示）",
      "default": "じまくテキスト",
      "group": "ruby",
      "role": "text"
    },
    {
      "key": "color_bg",
      "type": "color",
      "label": "プレート色",
      "default": "rgba(0,0,0,0.8)",
      "group": "band",
      "role": "color-bg"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "本文色",
      "default": "#ffffff",
      "group": "main",
      "role": "color"
    },
    {
      "key": "color_stroke",
      "type": "color",
      "label": "縁取り色",
      "default": "#000000",
      "group": "global",
      "role": "color-stroke"
    },
    {
      "key": "color_text_2",
      "type": "color",
      "label": "ルビ色",
      "default": "#ffffff",
      "group": "ruby",
      "role": "color"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "本文文字サイズ",
      "default": 72,
      "group": "main",
      "role": "size"
    },
    {
      "key": "rubyTextFontSize",
      "type": "number",
      "label": "ルビ（空で非表示）文字サイズ",
      "default": 28,
      "group": "ruby",
      "role": "size"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "'Noto Sans JP', sans-serif",
      "options": [
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ],
      "group": "global",
      "role": "font"
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 700,
      "group": "global",
      "role": "weight"
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（中央基準）",
      "default": 0,
      "group": "global",
      "role": "pos-x"
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（中央基準）",
      "default": 434,
      "group": "global",
      "role": "pos-y"
    },
    {
      "key": "animIn",
      "type": "select",
      "label": "入りアニメ",
      "default": "original",
      "options": [
        "original",
        "none",
        "fade-in-out",
        "soft-fade",
        "fade-up",
        "fade-down",
        "cinematic-fade",
        "slide-left",
        "slide-right",
        "slide-up",
        "slide-down",
        "push-left",
        "push-right",
        "push-up",
        "push-down",
        "rise-soft",
        "drop-in",
        "zoom-in-out",
        "zoom-pop",
        "zoom-pulse",
        "pop",
        "bounce",
        "squash-pop",
        "stretch-in",
        "stomp",
        "snap",
        "rotate-in",
        "spin-in",
        "roll-in",
        "spiral-in",
        "swing",
        "shake",
        "jitter",
        "glitch",
        "flash",
        "heartbeat",
        "typewriter",
        "wipe-left",
        "wipe-right",
        "caption-rise"
      ],
      "group": "anim",
      "role": "anim-in"
    },
    {
      "key": "animOut",
      "type": "select",
      "label": "抜けアニメ",
      "default": "original",
      "options": [
        "original",
        "none",
        "fade-in-out",
        "soft-fade",
        "fade-up",
        "fade-down",
        "cinematic-fade",
        "slide-left",
        "slide-right",
        "slide-up",
        "slide-down",
        "push-left",
        "push-right",
        "push-up",
        "push-down",
        "rise-soft",
        "drop-in",
        "zoom-in-out",
        "zoom-pop",
        "zoom-pulse",
        "pop",
        "bounce",
        "squash-pop",
        "stretch-in",
        "stomp",
        "snap",
        "rotate-in",
        "spin-in",
        "roll-in",
        "spiral-in",
        "swing",
        "shake",
        "jitter",
        "glitch",
        "flash",
        "heartbeat",
        "typewriter",
        "wipe-left",
        "wipe-right",
        "caption-rise"
      ],
      "group": "anim",
      "role": "anim-out"
    },
    {
      "key": "animLoop",
      "type": "select",
      "label": "ループアニメ",
      "default": "original",
      "options": [
        "original",
        "none",
        "wobble",
        "float",
        "breath",
        "neon-flicker",
        "hologram",
        "retro-flicker",
        "news-ticker",
        "marquee-left",
        "crawl-up"
      ],
      "group": "anim",
      "role": "anim-loop"
    },
    {
      "key": "animInSec",
      "type": "number",
      "label": "入り時間（秒）",
      "default": 0.6,
      "group": "anim",
      "role": "anim-duration"
    },
    {
      "key": "animOutSec",
      "type": "number",
      "label": "抜け時間（秒）",
      "default": 0.6,
      "group": "anim",
      "role": "anim-duration"
    }
  ],
  "layers": [
    {
      "id": "ref3_ruby_caption_plate",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "color_bg"
        },
        "cornerRadius": 8
      },
      "size": {
        "w": {
          "expr": "max(@ref3_ruby_caption_main.width + 96, 520)"
        },
        "h": 104
      },
      "transform": {
        "x": {
          "expr": "0 + 960"
        },
        "y": {
          "expr": "0 + 922"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.2,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_ruby_caption_main",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_text"
        },
        "align": "center",
        "stroke": {
          "color": {
            "var": "color_stroke"
          },
          "width": 8
        }
      },
      "transform": {
        "x": {
          "expr": "0 + 960"
        },
        "y": {
          "expr": "0 + 922"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.2,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_ruby_caption_ruby",
      "type": "text",
      "content": {
        "text": {
          "var": "rubyText"
        },
        "size": {
          "var": "rubyTextFontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": 700,
        "color": {
          "var": "color_text_2"
        },
        "align": "center",
        "stroke": {
          "color": {
            "var": "color_stroke"
          },
          "width": 4
        }
      },
      "transform": {
        "x": {
          "expr": "0 + 960"
        },
        "y": {
          "expr": "0 + 866"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.2,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0
            }
          ]
        }
      ],
      "visibleIf": {
        "expr": "has(rubyText)"
      }
    }
  ],
  "groups": [
    {
      "id": "main",
      "label": "本文"
    },
    {
      "id": "ruby",
      "label": "ルビ・ふりがな"
    },
    {
      "id": "band",
      "label": "帯・背景"
    },
    {
      "id": "global",
      "label": "全体"
    },
    {
      "id": "anim",
      "label": "アニメ"
    }
  ],
  "anchor": "bc"
}
