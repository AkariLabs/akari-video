{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_edu_speaker",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.25,
    "outDur": 0.25,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "字幕本文",
      "default": "いっしょに やってみよう"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "話者色",
      "default": "#ffe27a"
    },
    {
      "key": "color_stroke",
      "type": "color",
      "label": "縁色",
      "default": "#000000"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
      "options": [
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ]
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 800
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（ずらし）",
      "default": 0
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（ずらし）",
      "default": 0
    }
  ],
  "layers": [
    {
      "id": "ref3_edu_speaker_caption",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": 92,
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_text"
        },
        "align": "center",
        "strokes": [
          {
            "color": {
              "var": "color_stroke"
            },
            "width": 6
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "posX + (@stage.width / 2)"
        },
        "y": {
          "expr": "posY + (@stage.height - 72)"
        },
        "anchor": {
          "x": 0.5,
          "y": 1
        }
      },
      "tracks": [
        {
          "prop": "y",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 6,
              "ease": "out-cubic"
            },
            {
              "t": 0.25,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.2,
              "v": 1
            }
          ]
        },
        {
          "prop": "y",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "in-cubic"
            },
            {
              "t": 0.25,
              "v": 6
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.25,
              "v": 0
            }
          ]
        }
      ]
    }
  ]
}
