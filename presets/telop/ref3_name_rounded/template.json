{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_name_rounded",
  "kind": "lower-third",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.5,
    "outDur": 0.3,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "title",
      "type": "text",
      "label": "肩書き",
      "default": "コメンテーター"
    },
    {
      "key": "name",
      "type": "text",
      "label": "氏名",
      "default": "山田 太郎"
    },
    {
      "key": "color_primary",
      "type": "color",
      "label": "キーカラー",
      "default": "#e82b2b"
    },
    {
      "key": "color_bg",
      "type": "color",
      "label": "帯色",
      "default": "#ffffff"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "名前テキスト色",
      "default": "#1a1a1a"
    },
    {
      "key": "color_text_2",
      "type": "color",
      "label": "肩書きテキスト色",
      "default": "#e82b2b"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "'Noto Sans JP', sans-serif",
      "options": [
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ]
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 900
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（ずらし）",
      "default": 0
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（ずらし）",
      "default": 0
    }
  ],
  "layers": [
    {
      "id": "ref3_name_rounded_band",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "color_bg"
        },
        "cornerRadius": 12
      },
      "size": {
        "w": {
          "expr": "max(@ref3_name_rounded_name.width, @ref3_name_rounded_title.width) + 64"
        },
        "h": {
          "expr": "@ref3_name_rounded_name.bottom - @ref3_name_rounded_title.top + 44"
        }
      },
      "transform": {
        "x": {
          "expr": "posX + 96"
        },
        "y": {
          "expr": "(@ref3_name_rounded_title.top + @ref3_name_rounded_name.bottom) / 2"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -80,
              "ease": "out-cubic"
            },
            {
              "t": 0.25,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.08,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_name_rounded_underline",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "color_primary"
        },
        "cornerRadius": 3
      },
      "size": {
        "w": {
          "expr": "max(@ref3_name_rounded_name.width, @ref3_name_rounded_title.width) + 64"
        },
        "h": 6
      },
      "transform": {
        "x": {
          "expr": "posX + 96"
        },
        "y": {
          "expr": "@ref3_name_rounded_name.bottom + 22 - 3"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0.05,
              "v": -80,
              "ease": "out-cubic"
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0.05,
              "v": 0
            },
            {
              "t": 0.13,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_name_rounded_title",
      "type": "text",
      "content": {
        "text": {
          "var": "title"
        },
        "size": 40,
        "font": {
          "var": "fontFamily"
        },
        "weight": 700,
        "color": {
          "var": "color_text_2"
        },
        "align": "left"
      },
      "transform": {
        "x": {
          "expr": "posX + 128"
        },
        "y": {
          "expr": "@ref3_name_rounded_name.top - 6"
        },
        "anchor": {
          "x": 0,
          "y": 1
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0.08,
              "v": -80,
              "ease": "out-cubic"
            },
            {
              "t": 0.33,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0.08,
              "v": 0
            },
            {
              "t": 0.16,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_name_rounded_name",
      "type": "text",
      "content": {
        "text": {
          "var": "name"
        },
        "size": 72,
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_text"
        },
        "align": "left"
      },
      "transform": {
        "x": {
          "expr": "posX + 128"
        },
        "y": {
          "expr": "posY + 910"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0.08,
              "v": -80,
              "ease": "out-cubic"
            },
            {
              "t": 0.33,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0.08,
              "v": 0
            },
            {
              "t": 0.16,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ]
    }
  ]
}
