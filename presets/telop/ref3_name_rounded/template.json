          "var": "color_bg"
        },
        "cornerRadius": 12
      },
      "size": {
        "w": {
          "expr": "max(@ref3_name_rounded_name.width, @ref3_name_rounded_title.width) + 64"
        },
        "h": {
          "expr": "@ref3_name_rounded_name.bottom - @ref3_name_rounded_title.top + 44"
        }
      },
      "transform": {
        "x": {
          "expr": "0 + 96"
        },
        "y": {
          "expr": "(@ref3_name_rounded_title.top + @ref3_name_rounded_name.bottom) / 2"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -80,
              "ease": "out-cubic"
