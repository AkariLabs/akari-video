{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_particle_min",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.25,
    "outDur": 0.2,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "本文",
      "default": "今日のゲストはなんと芸能界の大物です",
      "group": "main",
      "role": "text"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "文字色",
      "default": "#ffffff",
      "group": "main",
      "role": "color"
    },
    {
      "key": "color_stroke_2",
      "type": "color",
      "label": "縁色（内・黒縁）",
      "default": "#111111",
      "group": "main",
      "role": "color-stroke"
    },
    {
      "key": "color_stroke",
      "type": "color",
      "label": "縁色（外・色縁）",
      "default": "#3b82f6",
      "group": "main",
      "role": "color-stroke"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "本文文字サイズ",
      "default": 86,
      "group": "main",
      "role": "size"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "system-ui",
      "options": [
        "system-ui",
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ],
      "group": "global",
      "role": "font"
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 900,
      "group": "global",
      "role": "weight"
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（中央基準）",
      "default": 0,
      "group": "global",
      "role": "pos-x"
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（中央基準）",
      "default": 518.6,
      "group": "global",
      "role": "pos-y"
    }
  ],
  "layers": [
    {
      "id": "ref3_particle_min_text",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_text"
        },
        "align": "center",
        "strokes": [
          {
            "color": {
              "var": "color_stroke"
            },
            "width": 13
          },
          {
            "color": {
              "var": "color_stroke_2"
            },
            "width": 9
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "0 + (@stage.width / 2)"
        },
        "y": {
          "expr": "0 + 994"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "y",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 14,
              "ease": "out-cubic"
            },
            {
              "t": 0.25,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.25,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0
            }
          ]
        }
      ],
      "perChar": {
        "split": "grapheme",
        "stagger": 0,
        "classStyles": {
          "hiragana": {
            "sizeScale": 0.72,
            "dy": {
              "expr": "size * 23 / 86"
            },
            "opacity": 0.9
          }
        },
        "tracks": []
      }
    }
  ],
  "groups": [
    {
      "id": "main",
      "label": "本文"
    },
    {
      "id": "global",
      "label": "全体"
    }
  ],
  "anchor": "bc"
}
