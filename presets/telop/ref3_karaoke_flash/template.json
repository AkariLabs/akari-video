  "layers": [
    {
      "id": "ref3_karaoke_flash_glow",
      "type": "text",
      "content": {
        "text": {
          "var": "lyric"
        },
        "size": {
          "var": "fontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_accent"
        },
        "align": "center",
        "letterSpacing": 4,
        "shadows": [
          {
            "color": {
              "var": "color_accent"
            },
            "blur": 12,
            "x": 0,
            "y": 0
          },
          {
            "color": {
              "var": "color_accent"
            },
            "blur": 30,
            "x": 0,
            "y": 0
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "0 + (@stage.width / 2)"
        },
        "y": {
          "expr": "0 + (@stage.height * 0.78)"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        },
        "opacity": {
          "expr": "clamp(glowStrength, 0, 1)"
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.12,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0.96,
              "ease": "out-cubic"
            },
            {
              "t": 0.12,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.18,
              "v": 0
            }
          ]
        }
      ],
      "perChar": {
        "split": "grapheme",
        "stagger": 0.3,
        "order": "ltr",
        "tracks": [
          {
            "prop": "opacity",
            "phase": "in",
            "keys": [
              {
                "t": 0,
                "v": 0,
                "ease": "step"
              },
              {
                "t": 0.02,
                "v": 1
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ref3_karaoke_flash_lyric",
      "type": "text",
      "content": {
        "text": {
          "var": "lyric"
        },
        "size": {
          "var": "fontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": 900,
        "color": {
          "var": "color_text"
        },
        "align": "center",
        "letterSpacing": 4,
        "strokes": [
          {
            "color": {
              "var": "color_stroke"
            },
            "width": 18
          },
          {
            "color": {
              "var": "color_stroke_2"
            },
            "width": 6
          }
        ],
        "shadows": [
          {
            "color": {
              "var": "color_shadow"
            },
            "blur": 10,
            "x": 0,
            "y": 4
          },
          {
            "color": {
              "var": "color_accent"
            },
            "blur": 18,
            "x": 0,
            "y": 0
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "0 + (@stage.width / 2)"
        },
        "y": {
          "expr": "0 + (@stage.height * 0.78)"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.12,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0.96,
              "ease": "out-cubic"
            },
            {
              "t": 0.12,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.18,
              "v": 0
            }
          ]
        }
      ],
      "perChar": {
        "split": "grapheme",
        "stagger": 0.3,
        "order": "ltr",
        "tracks": [],
        "active": {
          "color": "#FFD84A",
          "mode": "flash"
        }
      }
    }
  ],
  "groups": [
    {
      "id": "main",
      "label": "本文"
    },
    {
      "id": "global",
      "label": "全体"
    },
    {
      "id": "fx",
      "label": "装飾"
    },
    {
      "id": "anim",
      "label": "アニメ"
    }
  ],
  "anchor": "mc"
}
