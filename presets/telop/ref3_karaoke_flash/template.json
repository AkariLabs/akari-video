{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_karaoke_flash",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.12,
    "outDur": 0.18,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "lyric",
      "type": "text",
      "label": "歌詞",
      "default": "君の声が光になる",
      "group": "main",
      "role": "text"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "待機文字色",
      "default": "#FFFFFF",
      "group": "main",
      "role": "color"
    },
    {
      "key": "color_accent",
      "type": "color",
      "label": "点灯色",
      "default": "#FFD84A",
      "group": "main",
      "role": "color-accent"
    },
    {
      "key": "color_stroke",
      "type": "color",
      "label": "外縁色",
      "default": "rgba(0,0,0,0.90)",
      "group": "main",
      "role": "color-stroke"
    },
    {
      "key": "color_stroke_2",
      "type": "color",
      "label": "内縁色",
      "default": "rgba(255,255,255,0.92)",
      "group": "main",
      "role": "color-stroke"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 104,
      "group": "main",
      "role": "size"
    },
    {
      "key": "glowStrength",
      "type": "number",
      "label": "グロー強度",
      "default": 0.9,
      "group": "main",
      "role": "strength"
    },
    {
      "key": "staggerSec",
      "type": "number",
      "label": "点灯間隔（秒）",
      "default": 0.15,
      "group": "global",
      "role": "interval"
    },
    {
      "key": "letterSpacing",
      "type": "number",
      "label": "字間",
      "default": 4,
      "group": "main",
      "role": "other"
    },
    {
      "key": "color_shadow",
      "type": "color",
      "label": "影色",
      "default": "rgba(0,0,0,0.62)",
      "group": "main",
      "role": "color-shadow"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "'Noto Sans JP', sans-serif",
      "options": [
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ],
      "group": "global",
      "role": "font"
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 900,
      "group": "global",
      "role": "weight"
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（中央基準）",
      "default": 0,
      "group": "global",
      "role": "pos-x"
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（中央基準）",
      "default": 302.4,
      "group": "global",
      "role": "pos-y"
    }
  ],
  "layers": [
    {
      "id": "ref3_karaoke_flash_glow",
      "type": "text",
      "content": {
        "text": {
          "var": "lyric"
        },
        "size": {
          "var": "fontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_accent"
        },
        "align": "center",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "shadows": [
          {
            "color": {
              "var": "color_accent"
            },
            "blur": 12,
            "x": 0,
            "y": 0
          },
          {
            "color": {
              "var": "color_accent"
            },
            "blur": 30,
            "x": 0,
            "y": 0
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "0 + (@stage.width / 2)"
        },
        "y": {
          "expr": "0 + (@stage.height * 0.78)"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        },
        "opacity": {
          "expr": "clamp(glowStrength, 0, 1)"
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.12,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0.96,
              "ease": "out-cubic"
            },
            {
              "t": 0.12,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.18,
              "v": 0
            }
          ]
        }
      ],
      "perChar": {
        "split": "grapheme",
        "stagger": 0.3,
        "order": "ltr",
        "tracks": [
          {
            "prop": "opacity",
            "phase": "in",
            "keys": [
              {
                "t": 0,
                "v": 0,
                "ease": "step"
              },
              {
                "t": 0.02,
                "v": 1
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ref3_karaoke_flash_lyric",
      "type": "text",
      "content": {
        "text": {
          "var": "lyric"
        },
        "size": {
          "var": "fontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": 900,
        "color": {
          "var": "color_text"
        },
        "align": "center",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "strokes": [
          {
            "color": {
              "var": "color_stroke"
            },
            "width": 18
          },
          {
            "color": {
              "var": "color_stroke_2"
            },
            "width": 6
          }
        ],
        "shadows": [
          {
            "color": {
              "var": "color_shadow"
            },
            "blur": 10,
            "x": 0,
            "y": 4
          },
          {
            "color": {
              "var": "color_accent"
            },
            "blur": 18,
            "x": 0,
            "y": 0
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "0 + (@stage.width / 2)"
        },
        "y": {
          "expr": "0 + (@stage.height * 0.78)"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.12,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0.96,
              "ease": "out-cubic"
            },
            {
              "t": 0.12,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.18,
              "v": 0
            }
          ]
        }
      ],
      "perChar": {
        "split": "grapheme",
        "stagger": 0.3,
        "order": "ltr",
        "tracks": [],
        "active": {
          "color": "#FFD84A",
          "mode": "flash"
        }
      }
    }
  ],
  "groups": [
    {
      "id": "main",
      "label": "本文"
    },
    {
      "id": "global",
      "label": "全体"
    }
  ],
  "anchor": "mc"
}
