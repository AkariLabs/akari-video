{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_corner_title_line",
  "kind": "corner",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.3,
    "outDur": 0.2,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "title",
      "type": "text",
      "label": "タイトル",
      "default": "特集",
      "group": "main",
      "role": "text"
    },
    {
      "key": "color_primary",
      "type": "color",
      "label": "キーカラー（下線）",
      "default": "#1B4FD8",
      "group": "line",
      "role": "color-accent"
    },
    {
      "key": "color_text",
      "type": "color",
      "label": "文字色",
      "default": "#ffffff",
      "group": "main",
      "role": "color"
    },
    {
      "key": "color_shadow",
      "type": "color",
      "label": "シャドウ色",
      "default": "rgba(0,0,0,0.45)",
      "group": "main",
      "role": "color-shadow"
    },
    {
      "key": "titleFontSize",
      "type": "number",
      "label": "タイトル文字サイズ",
      "default": 88,
      "group": "main",
      "role": "size"
    },
    {
      "key": "fontFamily",
      "type": "font",
      "label": "フォント",
      "default": "system-ui",
      "options": [
        "system-ui",
        "'Noto Sans JP', sans-serif",
        "'Noto Serif JP', serif",
        "'M PLUS Rounded 1c', 'Noto Sans JP', sans-serif",
        "'BIZ UDGothic', 'Noto Sans JP', sans-serif",
        "'Dela Gothic One', 'Noto Sans JP', sans-serif",
        "'Zen Maru Gothic', 'M PLUS Rounded 1c', sans-serif",
        "'Shippori Mincho', 'Noto Serif JP', serif",
        "'DotGothic16', 'Noto Sans JP', sans-serif",
        "'Klee One', 'Noto Sans JP', sans-serif"
      ],
      "group": "global",
      "role": "font"
    },
    {
      "key": "fontWeight",
      "type": "number",
      "label": "太さ（100〜900）",
      "default": 800,
      "group": "global",
      "role": "weight"
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置（中央基準）",
      "default": -900,
      "group": "global",
      "role": "pos-x"
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（中央基準）",
      "default": -480,
      "group": "global",
      "role": "pos-y"
    }
  ],
  "layers": [
    {
      "id": "ref3_corner_title_line_title",
      "type": "text",
      "content": {
        "text": {
          "var": "title"
        },
        "size": {
          "var": "titleFontSize"
        },
        "font": {
          "var": "fontFamily"
        },
        "weight": {
          "var": "fontWeight"
        },
        "color": {
          "var": "color_text"
        },
        "align": "left",
        "shadow": {
          "color": {
            "var": "color_shadow"
          },
          "blur": 6,
          "x": 2,
          "y": 3
        }
      },
      "transform": {
        "x": {
          "expr": "0 + 60"
        },
        "y": {
          "expr": "0 + 60"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.2,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_corner_title_line_underline",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "color_primary"
        },
        "cornerRadius": 0
      },
      "size": {
        "w": {
          "expr": "@ref3_corner_title_line_title.width"
        },
        "h": 5
      },
      "transform": {
        "x": {
          "expr": "0 + 60"
        },
        "y": {
          "expr": "0 + (60 + @ref3_corner_title_line_title.height + 8)"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -140,
              "ease": "out-cubic"
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.3,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0
            }
          ]
        },
        {
          "prop": "x",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "in-cubic"
            },
            {
              "t": 0.2,
              "v": -140
            }
          ]
        }
      ]
    }
  ],
  "groups": [
    {
      "id": "main",
      "label": "本文"
    },
    {
      "id": "line",
      "label": "線・装飾"
    },
    {
      "id": "global",
      "label": "全体"
    }
  ],
  "anchor": "tl"
}
