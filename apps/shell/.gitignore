# build / generated (theia build, esbuild)
/lib/
/src-gen/
/gen-esbuild.*.mjs
/esbuild.mjs

# packaging output
/electron-builder-out/
/*.app/

# generated third-party license notices (prepackage で毎回再生成)
/resources/generated-notices/

# bundled ffmpeg/ffprobe binaries (prepackage で毎回再生成。task/2026-07-31-shell-ffmpeg-bundle)
/resources/vendor-ffmpeg/

# 同梱 CLI（render-cut / gpu-export）が実行時に使う npm 依存の staging
# （prepackage の bundle-cli-node-modules.mjs が毎回再生成）
/resources/cli-node-modules/

# dependencies
/node_modules/
/extensions/*/node_modules/
/extensions/*/lib/

# apps/shell/package-lock.json は **追跡する**（2026-08-19 / task shell-webpack-pin）。
# 開発・L1 の導線は `npm ci --no-workspaces` で、この lock が唯一の再現性の担保。
# （以前はここで ignore していたが、その結果 `npm install` した日のレジストリ次第で
#   1400 パッケージが漂い、1 か月で 63 パッケージがずれることを実測した）
# 拡張ディレクトリ側の lock は入れ子 install の副産物なので引き続き無視する
/extensions/*/package-lock.json

# downloaded / unpacked plugins (large, reproducible via ovsx)
/plugins/
/plugins-unpacked/
/plugins-empty/

# scratch project used for S18 startup-failsafe test
/dev-fixtures/**/node_modules/

# OS
.DS_Store
