{
  "private": true,
  "name": "@akari-video/shell",
  "version": "0.1.11",
  "description": "AKARI Video shell — Theia Electron app, S-A shell foundation (tabshell v0 contract).",
  "dependencies": {
    "@theia/core": "1.73.1",
    "@theia/editor": "1.73.1",
    "@theia/filesystem": "1.73.1",
    "@theia/workspace": "1.73.1",
    "@theia/navigator": "1.73.1",
    "@theia/terminal": "1.73.1",
    "@theia/monaco": "1.73.1",
    "@theia/preferences": "1.73.1",
    "@theia/plugin-ext": "1.73.1",
    "@theia/plugin-ext-vscode": "1.73.1",
    "@theia/vsx-registry": "1.73.1",
    "@theia/scm": "1.73.1",
    "@theia/search-in-workspace": "1.73.1",
    "@theia/electron": "1.73.1",
    "@theia/keymaps": "1.73.1",
    "@theia/userstorage": "1.73.1",
    "akari-shell-strip": "file:./extensions/akari-shell-strip",
    "akari-surfaces": "file:./extensions/akari-surfaces",
    "akari-project": "file:./extensions/akari-project",
    "akari-partner": "file:./extensions/akari-partner",
    "akari-tabs": "file:./extensions/akari-tabs",
    "akari-preview": "file:./extensions/akari-preview",
    "akari-transcript": "file:./extensions/akari-transcript",
    "akari-annotations": "file:./extensions/akari-annotations",
    "akari-theme": "file:./extensions/akari-theme",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@theia/cli": "1.73.1",
    "electron": "39.8.7",
    "electron-builder": "^26.0.0",
    "typescript": "~5.4.5",
    "rimraf": "^5.0.5",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0"
  },
  "main": "lib/backend/electron-main.js",
  "theia": {
    "target": "electron",
    "backend": {
      "config": {
        "singleInstance": true
      }
    },
    "frontend": {
      "config": {
        "applicationName": "AKARI Video",
        "defaultTheme": "dark",
        "preferences": {
          "security.workspace.trust.enabled": false,
          "editor.unusualLineTerminators": "off"
        }
      }
    },
    "electron": {
      "splashScreenOptions": {
        "content": "./resources/splash.html"
      }
    }
  },
  "scripts": {
    "prebuild": "node resources/scripts/ensure-file-deps-linked.mjs",
    "build:ext": "tsc -b extensions/akari-shell-strip extensions/akari-project extensions/akari-surfaces extensions/akari-partner extensions/akari-tabs extensions/akari-preview extensions/akari-annotations extensions/akari-transcript extensions/akari-theme",
    "build": "npm run build:ext && theia build --mode production",
    "postbuild": "node scripts/resign-electron.mjs",
    "postinstall": "node scripts/resign-electron.mjs",
    "lint": "eslint \"extensions/*/src/**/*.{ts,tsx}\"",
    "start": "theia start --plugins=local-dir:plugins",
    "prepackage": "node resources/scripts/copy-native-helpers.mjs && node resources/scripts/patch-ripgrep-asar-path.mjs && node resources/scripts/bundle-ffmpeg-binaries.mjs && node resources/scripts/generate-third-party-notices.mjs",
    "package": "electron-builder --dir",
    "postpackage": "node resources/scripts/verify-asar-contents.mjs",
    "watch": "theia build --watch --mode development"
  },
  "build": {
    "appId": "org.akarivideo.shell",
    "productName": "AKARI Video",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "electron-builder-out",
      "buildResources": "resources/icons"
    },
    "files": [
      "src-gen/**/*",
      "lib/**/*",
      "package.json",
      "!lib/**/*.map",
      "!node_modules/**/*.map",
      "!node_modules/**/*.md",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/README*",
      "!node_modules/**/*.ts",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/*.spec.js",
      "!node_modules/**/docs/**",
      "!**/evidence/**",
      "!node_modules/**/*.flow",
      "!node_modules/@theia/**/src/**",
      "!node_modules/*/evidence/**"
    ],
    "asarUnpack": [
      "**/*.node",
      "lib/prebuilds/**/spawn-helper",
      "lib/backend/native/**",
      "**/vscode-ripgrep/**",
      "**/@vscode/ripgrep/**"
    ],
    "extraResources": [
      {
        "from": "resources/generated-notices",
        "to": "."
      },
      {
        "from": "../../assets/font",
        "to": "assets/font"
      },
      {
        "from": "../../packages/edit-lint",
        "to": "packages/edit-lint",
        "filter": [
          "package.json",
          "bin/**/*",
          "src/**/*"
        ]
      },
      {
        "from": "../../packages/asset-resolver",
        "to": "packages/asset-resolver",
        "filter": [
          "package.json",
          "bin/**/*",
          "src/**/*"
        ]
      },
      {
        "from": "resources/vendor-ffmpeg",
        "to": "media-bin"
      },
      {
        "from": "../../packages/audio-library-setup/shared",
        "to": "packages/audio-library-setup/shared"
      },
      {
        "from": "../../packages/media-bin/src",
        "to": "packages/media-bin/src"
      },
      {
        "from": "../../packages/edit-store/lib",
        "to": "packages/edit-store/lib"
      },
      {
        "from": "../../packages/schemas",
        "to": "packages/schemas",
        "filter": [
          "captions.schema.json",
          "bin/validate-asset.mjs"
        ]
      },
      {
        "from": "../../presets/textanim",
        "to": "presets/textanim",
        "filter": [
          "index.jsonl"
        ]
      },
      {
        "from": "../../presets/telop",
        "to": "presets/telop",
        "filter": [
          "index.jsonl"
        ]
      },
      {
        "from": "../../presets/luts",
        "to": "presets/luts",
        "filter": [
          "index.jsonl"
        ]
      }
    ],
    "mac": {
      "icon": "resources/icons/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "target": "dir",
      "category": "public.app-category.video",
      "artifactName": "shell-mac.${ext}"
    },
    "win": {
      "icon": "resources/icons/icon.png",
      "target": "dir"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "shell-win-setup.${ext}",
      "shortcutName": "AKARI Video"
    },
    "linux": {
      "icon": "resources/icons/icon.png",
      "target": "dir"
    },
    "publish": {
      "provider": "github",
      "owner": "AkariLabs",
      "repo": "akari-video"
    }
  },
  "allowScripts": {
    "electron@39.8.7": true,
    "drivelist@12.0.2": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.24.2": true,
    "keytar@7.9.0": true,
    "msgpackr-extract@3.0.4": true,
    "native-keymap@2.5.0": true,
    "node-pty@1.2.0-beta.12": true,
    "puppeteer@25.1.0": true,
    "@parcel/watcher@2.6.0": true,
    "@theia/ffmpeg@1.73.1": true
  }
}
