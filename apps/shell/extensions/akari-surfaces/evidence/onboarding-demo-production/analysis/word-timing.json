 "captions_after_realign": [
  {
   "id": "c-0001",
   "start": 0.29,
   "end": 1.26,
   "text": "こんにちは。"
  },
  {
   "id": "c-0002",
   "start": 2.35,
   "end": 3.59,
   "text": "今日はですね、"
  },
  {
   "id": "c-0003",
   "start": 3.59,
   "end": 5.01,
   "text": "アカリビデオっていう"
  },
  {
   "id": "c-0004",
   "start": 5.1,
   "end": 6.36,
   "text": "動画編集ツールを"
  },
  {
   "id": "c-0005",
   "start": 6.43,
   "end": 7.17,
   "text": "試してみてます。"
  },
  {
   "id": "c-0006",
   "start": 7.84,
   "end": 9.9,
   "text": "これ、AIと対話する"
  },
  {
   "id": "c-0007",
   "start": 9.9,
   "end": 10.72,
   "text": "だけでいいんですよ。"
  },
  {
   "id": "c-0008",
   "start": 11.3,
   "end": 12.57,
   "text": "喋ってるだけで、"
  },
  {
   "id": "c-0009",
   "start": 12.57,
   "end": 14.05,
   "text": "編集はもう終わってる"
  },
  {
   "id": "c-0010",
   "start": 14.05,
   "end": 14.49,
   "text": "感じです。"
  },
  {
   "id": "c-0011",
   "start": 15.31,
   "end": 16.9,
   "text": "例えば、喋ってる"
  },
  {
   "id": "c-0012",
   "start": 16.9,
   "end": 18.44,
   "text": "途中に効果音とか"
  },
  {
   "id": "c-0013",
   "start": 18.74,
   "end": 20.55,
   "text": "エフェクトをパッと、"
  },
  {
   "id": "c-0014",
   "start": 20.55,
   "end": 21.68,
   "text": "ほら、こんな感じで。"
  },
  {
   "id": "c-0015",
   "start": 22.64,
   "end": 23.78,
   "text": "あと、こういう"
  },
  {
   "id": "c-0016",
   "start": 23.78,
   "end": 25.01,
   "text": "図解も出せますし、"
  },
  {
   "id": "c-0017",
   "start": 27.07,
   "end": 27.77,
   "text": "スマホの"
  },
  {
   "id": "c-0018",
   "start": 27.77,
   "end": 29.45,
   "text": "モックアップとかも、"
  },
  {
   "id": "c-0019",
   "start": 29.45,
   "end": 31.82,
   "text": "BGMも、字幕のカラオケ"
  },
  {
   "id": "c-0020",
   "start": 31.88,
   "end": 32.54,
   "text": "表示もいけます。"
  },
  {
   "id": "c-0021",
   "start": 33.3,
   "end": 34.79,
   "text": "まあ、僕は喋ってる"
  },
  {
   "id": "c-0022",
   "start": 34.79,
   "end": 35.64,
   "text": "だけなんですけどね。"
  }
 ],
