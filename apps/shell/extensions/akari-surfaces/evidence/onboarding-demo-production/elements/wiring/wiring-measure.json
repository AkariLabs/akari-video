 "findings_outside_boundary": [
  {
   "id": "preview-audio-keyframes-dropped",
   "severity": "high",
   "what": "出力プレビュー（シェル）で音声 item の keyframes が全部捨てられる。akari-preview の keyframes() 正規化が {t, gainDb} を返し、edit-store の audioKeyframeEnvelope（audio-schedule.ts）は point.gain_db だけを読むため envelopeEvents が 0 件になる（node で buildWebAudioSchedule に同じ形を渡して 0 件・gain_db 形なら 77 件を確認）。書き出しは効く",
   "effect": "お手本の『BGM も』の +8 dB と締めの +10 dB がプレビューでは鳴らない（BGM は -14 dB のまま）",
   "fix": "audioKeyframeEnvelope が gainDb も読む、または正規化が gain_db を返す（1 行）"
  },
  {
   "id": "no-speech-duck-key",
   "severity": "medium",
   "what": "声の下のダッキングは、書き出しはプロジェクト直下の analysis.json、プレビューは narration だけを鍵にする。お手本（sidecar だけ）ではどちらも効かない",
   "effect": "構成表の ducking（発話中 -8）は実現できないので使わず、定常 -14 dB にした"
  },
  {
   "id": "audio-keyframes-bag",
   "severity": "medium",
   "what": "edit-store の保存（project.ts distributeKeyframes）は 9 点以上の keyframes を motion 袋へ出すが、音声 item の袋参照は edit-lint が error（audio keyframes must contain at least two points）にする",
   "effect": "BGM の keyframes は 7 点に抑えた"
  },
  {
