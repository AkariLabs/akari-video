{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AKARI Video vision-tracks v0",
  "description": "顔ランドマーク・手ポーズ・3D ボディポーズのトラックファイル形式（analysis.json の tracks.face_landmarks / tracks.hand_pose / tracks.body_pose_3d が path で指す実体）。正本は docs/contract-2026-08-11-analysis-vision-tracks-v0.md §2。1 ファイル 1 kind（face-landmarks / hand-pose / body-pose-3d を混在させない）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "source",
    "sample_fps",
    "provider",
    "samples"
  ],
  "properties": {
    "version": {
      "const": 0
    },
    "kind": {
      "enum": [
        "face-landmarks",
        "hand-pose",
        "body-pose-3d"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "元動画へのパス。相対パスはこのトラックファイル自身の所在ディレクトリを基準に解決する。"
        },
        "duration": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "元動画の尺（秒）。ffprobe で取得できなかった場合は null。"
        }
      }
    },
    "sample_fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "検出プロバイダの自由文字列。apple-vision を例示するが enum 強制はしない（プロバイダ中立の原則 — 契約 §0 設計原則 4）。"
        },
        "os": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sample"
      }
    }
  },
  "$defs": {
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "point": {
      "description": "正規化 0〜1・左上原点の [x, y]。",
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/unit" },
        { "$ref": "#/$defs/unit" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "pointList": {
      "type": "array",
      "items": { "$ref": "#/$defs/point" }
    },
    "box": {
      "description": "正規化 0〜1・左上原点の [x, y, w, h]。",
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/unit" },
        { "$ref": "#/$defs/unit" },
        { "$ref": "#/$defs/unit" },
        { "$ref": "#/$defs/unit" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "conf": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "point3d": {
      "description": "Vision のモデル座標（root/hip 相対メートル）の [x, y, z]。画像座標のような 0〜1 クランプはしない。",
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "faceLandmarks": {
      "$comment": "v0 で必須なのは従来の 6 キー。face_contour は 2026-08-12 に additive 追加した任意の開曲線であり、額側の閉曲線補完は消費者が決定論的に行う。古いトラックは引き続き valid。",
      "type": "object",
      "required": [
        "left_pupil",
        "right_pupil",
        "left_eye",
        "right_eye",
        "outer_lips",
        "inner_lips"
      ],
      "properties": {
        "left_pupil": { "$ref": "#/$defs/point" },
        "right_pupil": { "$ref": "#/$defs/point" },
        "left_eye": { "$ref": "#/$defs/pointList" },
        "right_eye": { "$ref": "#/$defs/pointList" },
        "outer_lips": { "$ref": "#/$defs/pointList" },
        "inner_lips": { "$ref": "#/$defs/pointList" },
        "left_eyebrow": {
          "$ref": "#/$defs/pointList",
          "description": "額補完の基準に使える任意の左眉観測点。"
        },
        "right_eyebrow": {
          "$ref": "#/$defs/pointList",
          "description": "額補完の基準に使える任意の右眉観測点。"
        },
        "face_contour": {
          "$ref": "#/$defs/pointList",
          "description": "Vision faceContour の観測点（正規化 0〜1・左上原点）。あご線中心の開曲線で額側は含まない。"
        }
      }
    },
    "faceDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "box",
        "conf",
        "landmarks"
      ],
      "properties": {
        "box": { "$ref": "#/$defs/box" },
        "conf": { "$ref": "#/$defs/conf" },
        "landmarks": { "$ref": "#/$defs/faceLandmarks" }
      }
    },
    "handJoints": {
      "$comment": "v0 で必須なのは thumb_tip / index_tip のみ（契約 §2.2）。信頼度が閾値未満の関節はキーごと省略するため、他の 19 関節は required にしない。additionalProperties: true により他の VNHumanHandPoseObservation.JointName も追加のみで拡張できる。",
      "type": "object",
      "properties": {
        "wrist": { "$ref": "#/$defs/point" },
        "thumb_cmc": { "$ref": "#/$defs/point" },
        "thumb_mp": { "$ref": "#/$defs/point" },
        "thumb_ip": { "$ref": "#/$defs/point" },
        "thumb_tip": { "$ref": "#/$defs/point" },
        "index_mcp": { "$ref": "#/$defs/point" },
        "index_pip": { "$ref": "#/$defs/point" },
        "index_dip": { "$ref": "#/$defs/point" },
        "index_tip": { "$ref": "#/$defs/point" },
        "middle_mcp": { "$ref": "#/$defs/point" },
        "middle_pip": { "$ref": "#/$defs/point" },
        "middle_dip": { "$ref": "#/$defs/point" },
        "middle_tip": { "$ref": "#/$defs/point" },
        "ring_mcp": { "$ref": "#/$defs/point" },
        "ring_pip": { "$ref": "#/$defs/point" },
        "ring_dip": { "$ref": "#/$defs/point" },
        "ring_tip": { "$ref": "#/$defs/point" },
        "little_mcp": { "$ref": "#/$defs/point" },
        "little_pip": { "$ref": "#/$defs/point" },
        "little_dip": { "$ref": "#/$defs/point" },
        "little_tip": { "$ref": "#/$defs/point" }
      }
    },
    "handDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chirality",
        "conf",
        "joints"
      ],
      "properties": {
        "chirality": {
          "enum": ["left", "right", "unknown"]
        },
        "conf": { "$ref": "#/$defs/conf" },
        "joints": { "$ref": "#/$defs/handJoints" }
      }
    },
    "bodyPose3DJoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "projection", "conf"],
      "properties": {
        "position": { "$ref": "#/$defs/point3d" },
        "projection": { "$ref": "#/$defs/point" },
        "conf": {
          "$ref": "#/$defs/conf",
          "description": "Vision 3D API は関節別 confidence を公開しないため、v0 apple-vision provider では observation.confidence を各関節へ複製した値。"
        }
      }
    },
    "bodyPose3DJoints": {
      "$comment": "VNDetectHumanBodyPose3DRequest revision 1 の 17 関節。欠けた観測は detection ごと省略し、部分的な捏造をしない。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root", "right_hip", "right_knee", "right_ankle",
        "left_hip", "left_knee", "left_ankle", "spine", "center_shoulder",
        "center_head", "top_head", "left_shoulder", "left_elbow", "left_wrist",
        "right_shoulder", "right_elbow", "right_wrist"
      ],
      "properties": {
        "root": { "$ref": "#/$defs/bodyPose3DJoint" },
        "right_hip": { "$ref": "#/$defs/bodyPose3DJoint" },
        "right_knee": { "$ref": "#/$defs/bodyPose3DJoint" },
        "right_ankle": { "$ref": "#/$defs/bodyPose3DJoint" },
        "left_hip": { "$ref": "#/$defs/bodyPose3DJoint" },
        "left_knee": { "$ref": "#/$defs/bodyPose3DJoint" },
        "left_ankle": { "$ref": "#/$defs/bodyPose3DJoint" },
        "spine": { "$ref": "#/$defs/bodyPose3DJoint" },
        "center_shoulder": { "$ref": "#/$defs/bodyPose3DJoint" },
        "center_head": { "$ref": "#/$defs/bodyPose3DJoint" },
        "top_head": { "$ref": "#/$defs/bodyPose3DJoint" },
        "left_shoulder": { "$ref": "#/$defs/bodyPose3DJoint" },
        "left_elbow": { "$ref": "#/$defs/bodyPose3DJoint" },
        "left_wrist": { "$ref": "#/$defs/bodyPose3DJoint" },
        "right_shoulder": { "$ref": "#/$defs/bodyPose3DJoint" },
        "right_elbow": { "$ref": "#/$defs/bodyPose3DJoint" },
        "right_wrist": { "$ref": "#/$defs/bodyPose3DJoint" }
      }
    },
    "bodyPose3DDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conf", "joints"],
      "properties": {
        "conf": { "$ref": "#/$defs/conf" },
        "joints": { "$ref": "#/$defs/bodyPose3DJoints" }
      }
    },
    "detection": {
      "$comment": "kind ごとに detections[] の要素形が決まる（faceDetection | handDetection | bodyPose3DDetection）。トップレベルの kind と要素形の対応は本 schema では表せない意味制約であり、vision-tracks.md の検証手順が担う（analysis.schema.json の event 判別ユニオンと違い、kind はファイル全体に 1 つだけなので oneOf 判別は不要）。",
      "anyOf": [
        { "$ref": "#/$defs/faceDetection" },
        { "$ref": "#/$defs/handDetection" },
        { "$ref": "#/$defs/bodyPose3DDetection" }
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "detections"
      ],
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0
        },
        "detections": {
          "type": "array",
          "items": { "$ref": "#/$defs/detection" }
        }
      }
    }
  }
}
