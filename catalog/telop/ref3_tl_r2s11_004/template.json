{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_tl_r2s11_004",
  "kind": "corner",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.45,
    "outDur": 0.3,
    "hold": "stretch",
    "previewTotal": 4
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "ラベルテキスト",
      "default": "LIVE"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 40
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "文字色",
      "default": "#FFFFFF"
    },
    {
      "key": "badgeFill",
      "type": "color",
      "label": "バッジ背景色",
      "default": "rgba(0,0,0,0.72)"
    },
    {
      "key": "borderColor",
      "type": "color",
      "label": "縁線色",
      "default": "rgba(255,255,255,0.6)"
    },
    {
      "key": "padX",
      "type": "number",
      "label": "横余白",
      "default": 32
    },
    {
      "key": "padY",
      "type": "number",
      "label": "縦余白",
      "default": 16
    },
    {
      "key": "marginRight",
      "type": "number",
      "label": "右端マージン",
      "default": 80
    },
    {
      "key": "marginTop",
      "type": "number",
      "label": "上端マージン",
      "default": 60
    }
  ],
  "layers": [
    {
      "id": "ref3_tl_r2s11_004_label",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Helvetica Neue', 'Arial', system-ui, sans-serif",
        "weight": 700,
        "color": {
          "var": "textColor"
        },
        "align": "center",
        "letterSpacing": 6
      },
      "transform": {
        "x": {
          "expr": "@stage.width - marginRight - padX"
        },
        "y": {
          "expr": "marginTop + fontSize / 2 + padY"
        },
        "anchor": {
          "x": 1,
          "y": 0.5
        }
      },
      "perChar": {
        "split": "grapheme",
        "stagger": 0.06,
        "order": "ltr",
        "tracks": [
          {
            "prop": "opacity",
            "phase": "in",
            "keys": [
              {
                "t": 0,
                "v": 0
              },
              {
                "t": 0.12,
                "v": 1
              }
            ]
          },
          {
            "prop": "y",
            "phase": "in",
            "keys": [
              {
                "t": 0,
                "v": 8,
                "ease": "out-cubic"
              },
              {
                "t": 0.14,
                "v": 0
              }
            ]
          }
        ]
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.3,
              "v": 0
            },
            {
              "t": 1,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "in-cubic"
            },
            {
              "t": 1,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r2s11_004_badge",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "badgeFill"
        },
        "cornerRadius": 4
      },
      "size": {
        "w": {
          "expr": "@ref3_tl_r2s11_004_label.width + padX * 2"
        },
        "h": {
          "expr": "fontSize + padY * 2"
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width - marginRight - (@ref3_tl_r2s11_004_label.width + padX * 2)"
        },
        "y": {
          "var": "marginTop"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "wipe": {
        "axis": "x",
        "from": "end"
      },
      "tracks": [
        {
          "prop": "wipe",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "out-cubic"
            },
            {
              "t": 1,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "in-cubic"
            },
            {
              "t": 1,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r2s11_004_border",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": "transparent",
        "cornerRadius": 4,
        "fillGradient": {
          "type": "linear-v",
          "stops": [
            {
              "at": 0,
              "color": "rgba(255,255,255,0.22)"
            },
            {
              "at": 1,
              "color": "rgba(255,255,255,0.06)"
            }
          ]
        }
      },
      "size": {
        "w": {
          "expr": "@ref3_tl_r2s11_004_badge.width"
        },
        "h": {
          "expr": "@ref3_tl_r2s11_004_badge.height"
        }
      },
      "transform": {
        "x": {
          "expr": "@ref3_tl_r2s11_004_badge.left"
        },
        "y": {
          "var": "marginTop"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.3,
              "v": 0
            },
            {
              "t": 1,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "in-cubic"
            },
            {
              "t": 1,
              "v": 0
            }
          ]
        }
      ]
    }
  ]
}
