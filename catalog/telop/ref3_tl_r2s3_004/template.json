{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_tl_r2s3_004",
  "kind": "lower-third",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.42,
    "outDur": 0.22,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "テキスト",
      "default": "まとめ"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 80
    },
    {
      "key": "chalkTop",
      "type": "color",
      "label": "チョーク上端色",
      "default": "#FFFFFF"
    },
    {
      "key": "chalkMid",
      "type": "color",
      "label": "チョーク中間色",
      "default": "#D8D8D8"
    },
    {
      "key": "chalkBottom",
      "type": "color",
      "label": "チョーク下端色",
      "default": "#B0B0B0"
    },
    {
      "key": "lineColor",
      "type": "color",
      "label": "下線色",
      "default": "#FFFFFF"
    },
    {
      "key": "lineOpacity",
      "type": "number",
      "label": "下線不透明度",
      "default": 0.75
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置",
      "default": 200
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置",
      "default": 870
    },
    {
      "key": "padX",
      "type": "number",
      "label": "下線の横余白",
      "default": 16
    },
    {
      "key": "letterSpacing",
      "type": "number",
      "label": "字間",
      "default": 4
    }
  ],
  "layers": [
    {
      "id": "ref3_tl_r2s3_004_line",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "lineColor"
        },
        "cornerRadius": 2
      },
      "size": {
        "w": {
          "expr": "@ref3_tl_r2s3_004_text.width + padX * 2"
        },
        "h": 6
      },
      "transform": {
        "x": {
          "var": "posX"
        },
        "y": {
          "expr": "posY + fontSize * 0.58"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        },
        "opacity": {
          "var": "lineOpacity"
        }
      },
      "wipe": {
        "axis": "x",
        "from": "start"
      },
      "tracks": [
        {
          "prop": "wipe",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.2,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.02,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.22,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r2s3_004_text",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Hiragino Mincho ProN', 'Yu Mincho', 'Noto Serif JP', 'Times New Roman', serif",
        "weight": 600,
        "color": "#FFFFFF",
        "align": "left",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "fill": {
          "type": "linear-v",
          "stops": [
            {
              "at": 0,
              "color": {
                "var": "chalkTop"
              }
            },
            {
              "at": 0.45,
              "color": {
                "var": "chalkMid"
              }
            },
            {
              "at": 1,
              "color": {
                "var": "chalkBottom"
              }
            }
          ]
        },
        "strokes": [
          {
            "color": "rgba(0,0,0,0.45)",
            "width": 6
          }
        ],
        "shadow": {
          "color": "rgba(255,255,255,0.25)",
          "blur": 10,
          "x": 0,
          "y": 0
        }
      },
      "transform": {
        "x": {
          "var": "posX"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0.16,
              "v": 0
            },
            {
              "t": 0.42,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.22,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    }
  ]
}
