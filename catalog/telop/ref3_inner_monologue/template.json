{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_inner_monologue",
  "kind": "popup",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.82,
    "outDur": 0.35,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "本文",
      "default": "ほんとは少し不安"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 48
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "文字色",
      "default": "#3D2B1F"
    },
    {
      "key": "plateColor",
      "type": "color",
      "label": "プレート背景色",
      "default": "#FFF8E7"
    },
    {
      "key": "rotation",
      "type": "number",
      "label": "傾き角度",
      "default": 2
    },
    {
      "key": "dotStagger",
      "type": "number",
      "label": "三点リーダー間隔(ms)",
      "default": 200,
      "optional": true
    }
  ],
  "layers": [
    {
      "id": "ref3_inner_monologue_plate",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "plateColor"
        },
        "cornerRadius": 28
      },
      "size": {
        "w": {
          "expr": "max(@ref3_inner_monologue_text.width + @ref3_inner_monologue_dots.width + fontSize * 1.8, 360)"
        },
        "h": {
          "expr": "fontSize * 1.9"
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": 660,
        "anchor": {
          "x": 0.5,
          "y": 0.5
        },
        "rotation": {
          "var": "rotation"
        },
        "opacity": 0.86
      },
      "tracks": [
        {
          "prop": "y",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 12,
              "ease": "out-cubic"
            },
            {
              "t": 0.42,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.36,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.35,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_inner_monologue_text",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Klee One', '游教科書体', 'UD デジタル 教科書体', cursive",
        "weight": 600,
        "color": {
          "var": "textColor"
        },
        "align": "center",
        "strokes": [
          {
            "color": "rgba(255,255,255,0.78)",
            "width": 5
          },
          {
            "color": "rgba(120,108,92,0.24)",
            "width": 2
          }
        ],
        "shadow": {
          "color": "rgba(61,43,31,0.18)",
          "blur": 10,
          "x": 0,
          "y": 4
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2 - fontSize * 0.9"
        },
        "y": 660,
        "anchor": {
          "x": 0.5,
          "y": 0.5
        },
        "rotation": {
          "var": "rotation"
        }
      },
      "tracks": [
        {
          "prop": "y",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 12,
              "ease": "out-cubic"
            },
            {
              "t": 0.42,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.36,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.35,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_inner_monologue_dots",
      "type": "text",
      "content": {
        "text": "...",
        "size": {
          "var": "fontSize"
        },
        "font": "'Klee One', '游教科書体', 'UD デジタル 教科書体', cursive",
        "weight": 600,
        "color": {
          "var": "textColor"
        },
        "align": "left",
        "strokes": [
          {
            "color": "rgba(255,255,255,0.78)",
            "width": 5
          },
          {
            "color": "rgba(120,108,92,0.24)",
            "width": 2
          }
        ],
        "shadow": {
          "color": "rgba(61,43,31,0.18)",
          "blur": 10,
          "x": 0,
          "y": 4
        }
      },
      "transform": {
        "x": {
          "expr": "@ref3_inner_monologue_text.right + 6"
        },
        "y": 660,
        "anchor": {
          "x": 0,
          "y": 0.5
        },
        "rotation": {
          "var": "rotation"
        }
      },
      "tracks": [
        {
          "prop": "y",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 12,
              "ease": "out-cubic"
            },
            {
              "t": 0.42,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.36,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.35,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ],
      "perChar": {
        "split": "grapheme",
        "stagger": 0.2,
        "tracks": [
          {
            "prop": "y",
            "phase": "in",
            "keys": [
              {
                "t": 0,
                "v": 8,
                "ease": "out-cubic"
              },
              {
                "t": 0.22,
                "v": 0
              }
            ]
          },
          {
            "prop": "opacity",
            "phase": "in",
            "keys": [
              {
                "t": 0,
                "v": 0
              },
              {
                "t": 0.18,
                "v": 1,
                "ease": "out-cubic"
              }
            ]
          }
        ]
      }
    }
  ]
}
