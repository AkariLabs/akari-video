{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_marker_wipe",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.4,
    "outDur": 0.18,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "caption",
      "type": "text",
      "label": "キャプション",
      "default": "ワイプ実証"
    },
    {
      "key": "highlightColor",
      "type": "color",
      "label": "ハイライト色",
      "default": "#FFFF00"
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "文字色",
      "default": "#000000"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "フォントサイズ",
      "default": 56
    },
    {
      "key": "highlightOpacity",
      "type": "number",
      "label": "ハイライト透明度",
      "default": 0.68
    },
    {
      "key": "highlightPaddingX",
      "type": "number",
      "label": "ハイライト横余白",
      "default": 18
    },
    {
      "key": "animationDuration",
      "type": "number",
      "label": "アニメーション秒数",
      "default": 0.4
    }
  ],
  "layers": [
    {
      "id": "ref3_marker_wipe_highlight",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "highlightColor"
        },
        "cornerRadius": 4
      },
      "size": {
        "w": {
          "expr": "@ref3_marker_wipe_caption.width + highlightPaddingX * 2"
        },
        "h": {
          "expr": "fontSize * 0.68"
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "expr": "@stage.height * 0.62 + fontSize * 0.08"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        },
        "opacity": {
          "var": "highlightOpacity"
        }
      },
      "wipe": {
        "axis": "x",
        "from": "start"
      },
      "tracks": [
        {
          "prop": "wipe",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.4,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.02,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.18,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_marker_wipe_caption",
      "type": "text",
      "content": {
        "text": {
          "var": "caption"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Yu Gothic', sans-serif",
        "weight": 900,
        "color": {
          "var": "textColor"
        },
        "align": "center"
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "expr": "@stage.height * 0.62"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.18,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    }
  ]
}
