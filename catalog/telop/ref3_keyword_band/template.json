{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_keyword_band",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.35,
    "outDur": 0.26,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "word",
      "type": "text",
      "label": "重要語句",
      "default": "光合成"
    },
    {
      "key": "bandColor",
      "type": "color",
      "label": "帯の背景色",
      "default": "#FFE44D"
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "文字色",
      "default": "#1A1A4E"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 52
    },
    {
      "key": "bandPaddingX",
      "type": "number",
      "label": "帯の横パディング",
      "default": 40
    }
  ],
  "layers": [
    {
      "id": "ref3_keyword_band_band",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "bandColor"
        },
        "cornerRadius": 18
      },
      "size": {
        "w": {
          "expr": "max(@ref3_keyword_band_word.width + bandPaddingX * 2, 240)"
        },
        "h": {
          "expr": "fontSize + 32"
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "expr": "@stage.height * 0.74"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "wipe": {
        "axis": "x",
        "from": "start"
      },
      "tracks": [
        {
          "prop": "wipe",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.3,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.04,
              "v": 1
            }
          ]
        },
        {
          "prop": "wipe",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.26,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.22,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_keyword_band_word",
      "type": "text",
      "content": {
        "text": {
          "var": "word"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Yu Gothic', sans-serif",
        "weight": 900,
        "color": {
          "var": "textColor"
        },
        "align": "center",
        "shadows": [
          {
            "color": "rgba(255,255,255,0.50)",
            "blur": 0,
            "x": 0,
            "y": 1
          },
          {
            "color": "rgba(0,0,0,0.16)",
            "blur": 4,
            "x": 0,
            "y": 2
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "expr": "@stage.height * 0.74"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.15,
              "v": 0
            },
            {
              "t": 0.35,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.22,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    }
  ]
}
