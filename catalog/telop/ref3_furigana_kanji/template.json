        "shape": "rect",
        "fill": {
          "var": "bandLeft"
        },
        "fillGradient": {
          "type": "linear-h",
          "stops": [
            {
              "at": 0,
              "color": {
                "var": "bandLeft"
              }
            },
            {
              "at": 1,
              "color": {
                "var": "bandRight"
              }
            }
          ]
