    {
      "key": "shadowColor",
      "type": "color",
      "label": "帯影色",
      "default": "rgba(36,50,75,0.22)"
    },
    {
      "key": "mainSize",
      "type": "number",
      "label": "本文サイズ",
      "default": 92
    },
    {
      "key": "padX",
      "type": "number",
      "label": "帯左右余白",
      "default": 92
    },
    {
      "key": "posY",
      "type": "number",
      "label": "表示Y位置",
      "default": 760
    },
    {
      "key": "letterSpace",
      "type": "number",
      "label": "本文字間",
      "default": 2
    }
