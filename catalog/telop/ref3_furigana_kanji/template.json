        "w": {
          "expr": "max(max(@ref3_furigana_kanji_main.width, @ref3_furigana_kanji_furigana.width) + padX * 2 - 56, 824)"
        },
        "h": {
          "expr": "max(mainSize * 0.13, 10)"
