      "id": "ref3_furigana_kanji_band_shadow",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "shadowColor"
        },
        "cornerRadius": 34
      },
      "size": {
        "w": {
          "expr": "max(max(@ref3_furigana_kanji_main.width, @ref3_furigana_kanji_furigana.width) + padX * 2, 880)"
        },
        "h": {
          "expr": "mainSize * 2.05"
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2 + 8"
        },
        "y": {
          "expr": "posY - mainSize * 0.3 + 10"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        },
        "opacity": 0.85
      },
      "wipe": {
        "axis": "x",
        "from": "start"
      },
      "tracks": [
        {
          "prop": "wipe",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "out-cubic"
            },
            {
              "t": 0.32,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.28,
              "v": 0
            }
          ]
        }
      ]
    },
