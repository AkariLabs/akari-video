{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_furigana_kanji",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.38,
    "outDur": 0.28,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "main",
      "type": "text",
      "label": "本文（漢字）",
      "default": "漢字を読もう"
    },
    {
      "key": "furigana",
      "type": "text",
      "label": "ふりがな",
      "default": "かんじをよもう"
    },
    {
      "key": "mainColor",
      "type": "color",
      "label": "本文色",
      "default": "#24324B"
    },
    {
      "key": "furiganaColor",
      "type": "color",
      "label": "ふりがな色",
      "default": "#4D6788"
    },
    {
      "key": "strokeOuter",
      "type": "color",
      "label": "外縁色",
      "default": "#FFFFFF"
    },
    {
      "key": "strokeInner",
      "type": "color",
      "label": "内縁色",
      "default": "#24324B"
    },
    {
      "key": "bandLeft",
      "type": "color",
      "label": "帯左色",
      "default": "#FFF4A8"
    },
    {
      "key": "bandRight",
      "type": "color",
      "label": "帯右色",
      "default": "#BDEEFF"
    },
    {
      "key": "accentColor",
      "type": "color",
      "label": "アクセント色",
      "default": "#FFB7C8"
