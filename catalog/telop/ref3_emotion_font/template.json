{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_emotion_font",
  "kind": "popup",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.62,
    "outDur": 0.28,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "word",
      "type": "text",
      "label": "決め台詞",
      "default": "覚悟しろ"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 150
    },
    {
      "key": "letterSpacing",
      "type": "number",
      "label": "字間",
      "default": 2
    },
    {
      "key": "gradientFrom",
      "type": "color",
      "label": "金グラデ左",
      "default": "#fff4a3"
    },
    {
      "key": "gradientTo",
      "type": "color",
      "label": "金グラデ右",
      "default": "#c98612"
    },
    {
      "key": "strokeColor",
      "type": "color",
      "label": "外縁色",
      "default": "#050505"
    },
    {
      "key": "innerStrokeColor",
      "type": "color",
      "label": "内縁色",
      "default": "#3a2200"
    },
    {
      "key": "outerStrokeWidth",
      "type": "number",
      "label": "外縁幅",
      "default": 30
    },
    {
      "key": "innerStrokeWidth",
      "type": "number",
      "label": "内縁幅",
      "default": 10
    },
    {
      "key": "glowColor",
      "type": "color",
      "label": "金グロー色",
      "default": "rgba(255,202,64,0.82)"
    },
    {
      "key": "glowBlur",
      "type": "number",
      "label": "グロー量",
      "default": 34
    },
    {
      "key": "y",
      "type": "number",
      "label": "縦位置",
      "default": 540
    }
  ],
  "layers": [
    {
      "id": "ref3_emotion_font_word",
      "type": "text",
      "content": {
        "text": {
          "var": "word"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Hiragino Mincho ProN', 'Yu Mincho', YuMincho, 'BIZ UDPMincho', 'Times New Roman', serif",
        "weight": 800,
        "color": {
          "var": "gradientFrom"
        },
        "align": "center",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "fill": {
          "type": "linear-h",
          "stops": [
            {
              "at": 0,
              "color": {
                "var": "gradientFrom"
              }
            },
            {
              "at": 0.48,
              "color": "#fff7c9"
            },
            {
              "at": 1,
              "color": {
                "var": "gradientTo"
              }
            }
          ],
          "shimmer": {
            "periodSec": 2.8,
            "width": 0.18,
            "color": "rgba(255,255,255,0.74)"
          }
        },
        "strokes": [
          {
            "color": {
              "var": "strokeColor"
            },
            "width": {
              "var": "outerStrokeWidth"
            }
          },
          {
            "color": {
              "var": "innerStrokeColor"
            },
            "width": {
              "var": "innerStrokeWidth"
            }
          }
        ],
        "shadows": [
          {
            "color": {
              "var": "glowColor"
            },
            "blur": {
              "var": "glowBlur"
            },
            "x": 0,
            "y": 0
          },
          {
            "color": "rgba(255,232,132,0.42)",
            "blur": 18,
            "x": 0,
            "y": 0
          },
          {
            "color": "rgba(0,0,0,0.74)",
            "blur": 14,
            "x": 0,
            "y": 8
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "var": "y"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 1.06,
              "ease": "out-cubic"
            },
            {
              "t": 0.62,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.18,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.28,
              "v": 0
            }
          ]
        }
      ]
    }
  ]
}
