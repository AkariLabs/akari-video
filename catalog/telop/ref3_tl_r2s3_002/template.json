{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_tl_r2s3_002",
  "kind": "lower-third",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.38,
    "outDur": 0.2,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "テキスト",
      "default": "ここがポイント！"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 72
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "文字色",
      "default": "#1A1A1A"
    },
    {
      "key": "markerColor",
      "type": "color",
      "label": "マーカー色",
      "default": "#FFE840"
    },
    {
      "key": "markerOpacity",
      "type": "number",
      "label": "マーカー不透明度",
      "default": 0.88
    },
    {
      "key": "tilt",
      "type": "number",
      "label": "マーカー傾き（度）",
      "default": -1.5
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置",
      "default": 960
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置",
      "default": 860
    },
    {
      "key": "padX",
      "type": "number",
      "label": "帯の横余白",
      "default": 28
    },
    {
      "key": "letterSpacing",
      "type": "number",
      "label": "字間",
      "default": 2
    }
  ],
  "layers": [
    {
      "id": "ref3_tl_r2s3_002_band",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "markerColor"
        },
        "cornerRadius": 4
      },
      "size": {
        "w": {
          "expr": "@ref3_tl_r2s3_002_text.width + padX * 2"
        },
        "h": {
          "expr": "fontSize * 1.25"
        }
      },
      "transform": {
        "x": {
          "var": "posX"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        },
        "rotation": {
          "var": "tilt"
        },
        "opacity": {
          "var": "markerOpacity"
        }
      },
      "wipe": {
        "axis": "x",
        "from": "start"
      },
      "tracks": [
        {
          "prop": "wipe",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.32,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.03,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r2s3_002_text",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Hiragino Sans W8', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'BIZ UDGothic', system-ui, sans-serif",
        "weight": 800,
        "color": {
          "var": "textColor"
        },
        "align": "center",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "shadow": {
          "color": "rgba(0,0,0,0.18)",
          "blur": 6,
          "x": 0,
          "y": 2
        }
      },
      "transform": {
        "x": {
          "var": "posX"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0.18,
              "v": 0
            },
            {
              "t": 0.38,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    }
  ]
}
