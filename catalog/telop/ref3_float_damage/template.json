{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_float_damage",
  "kind": "free",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 2.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.18,
    "outDur": 0.4,
    "hold": "stretch",
    "previewTotal": 3
  },
  "variables": [
    {
      "key": "damageText",
      "type": "text",
      "label": "ダメージ数値",
      "default": "9999"
    },
    {
      "key": "labelText",
      "type": "text",
      "label": "ラベル（空で非表示）",
      "default": "ダメージ!"
    },
    {
      "key": "colorTop",
      "type": "color",
      "label": "メイン色（上）",
      "default": "#FFE657"
    },
    {
      "key": "colorBottom",
      "type": "color",
      "label": "メイン色（下）",
      "default": "#FF6A00"
    },
    {
      "key": "colorStrokeOuter",
      "type": "color",
      "label": "縁色（外）",
      "default": "#FFFFFF"
    },
    {
      "key": "colorGlow",
      "type": "color",
      "label": "グロー色",
      "default": "#FF8C00"
    },
    {
      "key": "colorLabel",
      "type": "color",
      "label": "ラベル色",
      "default": "#FFFFFF"
    }
  ],
  "layers": [
    {
      "id": "ref3_float_damage_number",
      "type": "text",
      "content": {
        "text": {
          "var": "damageText"
        },
        "size": 120,
        "font": "'Impact', 'Arial Black', system-ui",
        "weight": 900,
        "color": {
          "var": "colorTop"
        },
        "align": "center",
        "fill": {
          "type": "linear-v",
          "stops": [
            {
              "at": 0,
              "color": {
                "var": "colorTop"
              }
            },
            {
              "at": 1,
              "color": {
                "var": "colorBottom"
              }
            }
          ]
        },
        "strokes": [
          {
            "color": {
              "var": "colorStrokeOuter"
            },
            "width": 14
          }
        ],
        "shadow": {
          "color": {
            "var": "colorGlow"
          },
          "blur": 32,
          "x": 0,
          "y": 0
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": 400,
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 1.6,
              "ease": "out-back"
            },
            {
              "t": 0.18,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.02,
              "v": 1
            }
          ]
        },
        {
          "prop": "y",
          "phase": "hold",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "linear"
            },
            {
              "t": 1,
              "v": -80
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.4,
              "v": 0
            }
          ]
        },
        {
          "prop": "y",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "linear"
            },
            {
              "t": 0.4,
              "v": -40
            }
          ]
        }
      ],
      "perChar": {
        "split": "grapheme",
        "stagger": 0,
        "tracks": [],
        "randomize": {
          "seed": 42,
          "dxAmp": 4,
          "dyAmp": 5,
          "rotAmp": 3,
          "sizeAmp": 0.06
        }
      }
    },
    {
      "id": "ref3_float_damage_label",
      "type": "text",
      "content": {
        "text": {
          "var": "labelText"
        },
        "size": 36,
        "font": "'Impact', 'Arial Black', system-ui",
        "weight": 700,
        "color": {
          "var": "colorLabel"
        },
        "align": "center",
        "strokes": [
          {
            "color": {
              "var": "colorGlow"
            },
            "width": 5
          }
        ],
        "shadow": {
          "color": {
            "var": "colorGlow"
          },
          "blur": 12,
          "x": 0,
          "y": 0
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "expr": "@ref3_float_damage_number.cy + @ref3_float_damage_number.height / 2 + 20"
        },
        "anchor": {
          "x": 0.5,
          "y": 0
        }
      },
      "visibleIf": {
        "expr": "has(labelText)"
      },
      "tracks": [
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0.04,
              "v": 1.4,
              "ease": "out-back"
            },
            {
              "t": 0.18,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0.04,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.06,
              "v": 1
            }
          ]
        },
        {
          "prop": "y",
          "phase": "hold",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "linear"
            },
            {
              "t": 1,
              "v": -80
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.4,
              "v": 0
            }
          ]
        },
        {
          "prop": "y",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "linear"
            },
            {
              "t": 0.4,
              "v": -40
            }
          ]
        }
      ]
    }
  ]
}
