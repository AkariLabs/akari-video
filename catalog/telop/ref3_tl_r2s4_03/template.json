{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_tl_r2s4_03",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.6,
    "outDur": 0.5,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "歌詞テキスト",
      "default": "雨の御堂筋"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 100
    },
    {
      "key": "posY",
      "type": "number",
      "label": "表示Y位置",
      "default": 870
    },
    {
      "key": "goldTop",
      "type": "color",
      "label": "金グラデ（上）",
      "default": "#B8882A"
    },
    {
      "key": "goldMid",
      "type": "color",
      "label": "金グラデ（中）",
      "default": "#F5D88A"
    },
    {
      "key": "goldBottom",
      "type": "color",
      "label": "金グラデ（下）",
      "default": "#8A5C14"
    },
    {
      "key": "outerStroke",
      "type": "color",
      "label": "外縁色（黒）",
      "default": "#1A0A00"
    },
    {
      "key": "innerStroke",
      "type": "color",
      "label": "内縁色（深紅）",
      "default": "#6B1A1A"
    },
    {
      "key": "plateColor",
      "type": "color",
      "label": "字幕帯色",
      "default": "rgba(10,5,0,0.55)"
    },
    {
      "key": "letterSpacing",
      "type": "number",
      "label": "字間",
      "default": 8
    }
  ],
  "layers": [
    {
      "id": "ref3_tl_r2s4_03_plate",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "plateColor"
        },
        "cornerRadius": 0
      },
      "size": {
        "w": 1920,
        "h": 148
      },
      "transform": {
        "x": 960,
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.4,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.6,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r2s4_03_lyric",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Hiragino Mincho ProN', 'Yu Mincho', 'MS Mincho', serif",
        "weight": 700,
        "color": "#F5D88A",
        "align": "center",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "fill": {
          "type": "linear-v",
          "stops": [
            {
              "at": 0,
              "color": {
                "var": "goldTop"
              }
            },
            {
              "at": 0.45,
              "color": {
                "var": "goldMid"
              }
            },
            {
              "at": 1,
              "color": {
                "var": "goldBottom"
              }
            }
          ],
          "shimmer": {
            "periodSec": 3.5,
            "width": 0.2,
            "color": "rgba(255,245,180,0.8)"
          }
        },
        "strokes": [
          {
            "color": {
              "var": "outerStroke"
            },
            "width": 22
          },
          {
            "color": {
              "var": "innerStroke"
            },
            "width": 7
          }
        ],
        "shadows": [
          {
            "color": "rgba(0,0,0,0.85)",
            "blur": 16,
            "x": 3,
            "y": 5
          },
          {
            "color": "rgba(180,100,20,0.35)",
            "blur": 28,
            "x": 0,
            "y": 0
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.6,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.5,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    }
  ]
}
