{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_typewriter_mono",
  "kind": "corner",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.72,
    "outDur": 0.3,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "word",
      "type": "text",
      "label": "日付テキスト",
      "default": "2026.06.12"
    },
    {
      "key": "location",
      "type": "text",
      "label": "ロケーション",
      "default": "TOKYO",
      "optional": true
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "文字色",
      "default": "#ffd9a0"
    },
    {
      "key": "caretColor",
      "type": "color",
      "label": "キャレット色",
      "default": "#ffd9a0"
    }
  ],
  "layers": [
    {
      "id": "ref3_typewriter_mono_date",
      "type": "text",
      "content": {
        "text": {
          "var": "word"
        },
        "size": 30,
        "font": "Menlo, monospace",
        "weight": 400,
        "color": {
          "var": "textColor"
        },
        "align": "right",
        "shadow": {
          "color": "rgba(0,0,0,0.45)",
          "blur": 3,
          "x": 0,
          "y": 1
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width - 60"
        },
        "y": {
          "expr": "@stage.height - 60"
        },
        "anchor": {
          "x": 1,
          "y": 1
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.08,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ],
      "perChar": {
        "split": "grapheme",
        "stagger": 0.06,
        "order": "ltr",
        "tracks": [
          {
            "prop": "opacity",
            "phase": "in",
            "keys": [
              {
                "t": 0,
                "v": 0,
                "ease": "step"
              },
              {
                "t": 0.02,
                "v": 1
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ref3_typewriter_mono_caret",
      "type": "text",
      "content": {
        "text": "|",
        "size": 30,
        "font": "Menlo, monospace",
        "weight": 400,
        "color": {
          "var": "caretColor"
        },
        "align": "left",
        "shadow": {
          "color": "rgba(0,0,0,0.45)",
          "blur": 3,
          "x": 0,
          "y": 1
        }
      },
      "transform": {
        "x": {
          "expr": "@ref3_typewriter_mono_date.right + 4"
        },
        "y": {
          "expr": "@stage.height - 60"
        },
        "anchor": {
          "x": 0,
          "y": 1
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.72,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "hold",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "step"
            },
            {
              "t": 0.5,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 1,
              "v": 1,
              "ease": "step"
            },
            {
              "t": 1.5,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 2,
              "v": 1,
              "ease": "step"
            },
            {
              "t": 2.5,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 3,
              "v": 1,
              "ease": "step"
            },
            {
              "t": 3.5,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 4,
              "v": 1,
              "ease": "step"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_typewriter_mono_location",
      "type": "text",
      "content": {
        "text": {
          "var": "location"
        },
        "size": 20,
        "font": "Menlo, monospace",
        "weight": 400,
        "color": {
          "var": "textColor"
        },
        "align": "right",
        "shadow": {
          "color": "rgba(0,0,0,0.45)",
          "blur": 3,
          "x": 0,
          "y": 1
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width - 60"
        },
        "y": {
          "expr": "@stage.height - 98"
        },
        "anchor": {
          "x": 1,
          "y": 1
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.08,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ],
      "perChar": {
        "split": "grapheme",
        "stagger": 0.06,
        "order": "ltr",
        "tracks": [
          {
            "prop": "opacity",
            "phase": "in",
            "keys": [
              {
                "t": 0,
                "v": 0,
                "ease": "step"
              },
              {
                "t": 0.02,
                "v": 1
              }
            ]
          }
        ]
      },
      "visibleIf": {
        "expr": "has(location)"
      }
    }
  ]
}
