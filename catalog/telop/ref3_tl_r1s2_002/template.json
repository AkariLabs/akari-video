{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_tl_r1s2_002",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.2,
    "outDur": 0.15,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "歌詞テキスト",
      "default": "ネオンが溺れる夜に"
    },
    {
      "key": "baseColor",
      "type": "color",
      "label": "待機文字色",
      "default": "rgba(200,180,255,0.75)"
    },
    {
      "key": "neonLeft",
      "type": "color",
      "label": "ネオングラデ 左端",
      "default": "#FF2EFF"
    },
    {
      "key": "neonRight",
      "type": "color",
      "label": "ネオングラデ 右端",
      "default": "#00F0FF"
    },
    {
      "key": "strokeColor",
      "type": "color",
      "label": "縁取り色",
      "default": "rgba(10,0,30,0.96)"
    },
    {
      "key": "glowColor",
      "type": "color",
      "label": "発光色",
      "default": "rgba(200,80,255,0.72)"
    },
    {
      "key": "plateColor",
      "type": "color",
      "label": "下帯色",
      "default": "rgba(10,0,30,0.55)"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 110
    },
    {
      "key": "posY",
      "type": "number",
      "label": "表示Y位置",
      "default": 840
    },
    {
      "key": "letterSpacing",
      "type": "number",
      "label": "字間",
      "default": 3
    }
  ],
  "layers": [
    {
      "id": "ref3_tl_r1s2_002_plate",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "plateColor"
        },
        "cornerRadius": 0
      },
      "size": {
        "w": {
          "expr": "@ref3_tl_r1s2_002_base.width + 140"
        },
        "h": {
          "expr": "fontSize + 48"
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.2,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.15,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r1s2_002_base",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Hiragino Sans W8', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'BIZ UDGothic', system-ui, sans-serif",
        "weight": 900,
        "color": {
          "var": "baseColor"
        },
        "align": "center",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "strokes": [
          {
            "color": {
              "var": "strokeColor"
            },
            "width": 20
          }
        ],
        "shadows": [
          {
            "color": "rgba(100,0,200,0.4)",
            "blur": 20,
            "x": 0,
            "y": 0
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.2,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.15,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
