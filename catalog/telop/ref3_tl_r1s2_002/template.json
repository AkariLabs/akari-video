        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Hiragino Sans W8', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'BIZ UDGothic', system-ui, sans-serif",
        "weight": 900,
        "color": {
          "var": "neonLeft"
        },
        "fill": {
          "type": "linear-h",
          "stops": [
            {
              "at": 0,
              "color": {
                "var": "neonLeft"
              }
            },
            {
              "at": 0.5,
              "color": "#AA44FF"
            },
            {
              "at": 1,
              "color": {
                "var": "neonRight"
              }
            }
          ],
          "shimmer": {
            "periodSec": 1.8,
            "width": 0.18,
            "color": "rgba(255,255,255,0.72)"
          }
        },
        "align": "center",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "strokes": [
          {
            "color": {
              "var": "strokeColor"
            },
            "width": 20
          }
        ],
        "shadows": [
          {
            "color": {
              "var": "glowColor"
            },
            "blur": 18,
            "x": 0,
            "y": 0
          },
          {
            "color": {
              "var": "glowColor"
            },
            "blur": 40,
            "x": 0,
            "y": 0
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "wipe": {
        "axis": "x",
        "from": "start"
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.2,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "wipe",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "linear"
            },
            {
              "t": 0.2,
              "v": 0.04,
              "ease": "linear"
            }
          ]
        },
        {
          "prop": "wipe",
          "phase": "hold",
          "keys": [
            {
              "t": 0,
              "v": 0.04,
              "ease": "linear"
            },
            {
              "t": 4.8,
              "v": 1,
              "ease": "linear"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.15,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    }
