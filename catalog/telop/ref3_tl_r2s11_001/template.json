{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_tl_r2s11_001",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.5,
    "outDur": 0.4,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "テキスト",
      "default": "ドキュメンタリー字幕"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 72
    },
    {
      "key": "bandColor",
      "type": "color",
      "label": "帯の色",
      "default": "rgba(10,10,10,0.88)"
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "文字色",
      "default": "#FFFFFF"
    },
    {
      "key": "accentColor",
      "type": "color",
      "label": "アクセント線色",
      "default": "#E8E8E8"
    },
    {
      "key": "padX",
      "type": "number",
      "label": "横余白",
      "default": 72
    },
    {
      "key": "padY",
      "type": "number",
      "label": "縦余白",
      "default": 24
    },
    {
      "key": "posY",
      "type": "number",
      "label": "表示Y位置",
      "default": 900
    }
  ],
  "layers": [
    {
      "id": "ref3_tl_r2s11_001_band",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "bandColor"
        }
      },
      "size": {
        "w": {
          "expr": "@ref3_tl_r2s11_001_text.width + padX * 2"
        },
        "h": {
          "expr": "fontSize + padY * 2"
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2 - (@ref3_tl_r2s11_001_text.width + padX * 2) / 2"
        },
        "y": {
          "expr": "posY - (fontSize + padY * 2) / 2"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "wipe": {
        "axis": "x",
        "from": "start"
      },
      "tracks": [
        {
          "prop": "wipe",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "out-cubic"
            },
            {
              "t": 1,
              "v": 1
            }
          ]
        },
        {
          "prop": "wipe",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "in-cubic"
            },
            {
              "t": 1,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r2s11_001_line",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "accentColor"
        }
      },
      "size": {
        "w": {
          "expr": "@ref3_tl_r2s11_001_text.width + padX * 2"
        },
        "h": 2
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2 - (@ref3_tl_r2s11_001_text.width + padX * 2) / 2"
        },
        "y": {
          "expr": "posY - (fontSize + padY * 2) / 2"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "wipe": {
        "axis": "x",
        "from": "start"
      },
      "tracks": [
        {
          "prop": "wipe",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "out-cubic"
            },
            {
              "t": 1,
              "v": 1
            }
          ]
        },
        {
          "prop": "wipe",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "in-cubic"
            },
            {
              "t": 1,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r2s11_001_text",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Hiragino Sans W3', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', system-ui, sans-serif",
        "weight": 300,
        "color": {
          "var": "textColor"
        },
        "align": "center",
        "letterSpacing": 4
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.4,
              "v": 0,
              "ease": "out-cubic"
            },
            {
              "t": 1,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "in-cubic"
            },
            {
              "t": 0.35,
              "v": 0
            }
          ]
        }
      ]
    }
  ]
}
