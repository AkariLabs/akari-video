{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_karaoke_wipe",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.18,
    "outDur": 0,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "lyric",
      "type": "text",
      "label": "歌詞",
      "default": "君の声が光になる"
    },
    {
      "key": "baseColor",
      "type": "color",
      "label": "待機文字色",
      "default": "#FFFFFF"
    },
    {
      "key": "activeColor",
      "type": "color",
      "label": "ワイプ文字色",
      "default": "#FFD84A"
    },
    {
      "key": "strokeOuter",
      "type": "color",
      "label": "外縁色",
      "default": "rgba(0,0,0,0.92)"
    },
    {
      "key": "strokeInner",
      "type": "color",
      "label": "内縁色",
      "default": "rgba(255,255,255,0.95)"
    },
    {
      "key": "activeGlow",
      "type": "color",
      "label": "ワイプ発光色",
      "default": "rgba(255,216,74,0.65)"
    },
    {
      "key": "plateColor",
      "type": "color",
      "label": "下帯色",
      "default": "rgba(0,0,0,0.42)"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 112
    },
    {
      "key": "posY",
      "type": "number",
      "label": "表示Y位置",
      "default": 835
    },
    {
      "key": "letterSpacing",
      "type": "number",
      "label": "字間",
      "default": 3
    },
    {
      "key": "platePadX",
      "type": "number",
      "label": "下帯左右余白",
      "default": 92
    },
    {
      "key": "platePadY",
      "type": "number",
      "label": "下帯上下余白",
      "default": 34
    }
  ],
  "layers": [
    {
      "id": "ref3_karaoke_wipe_plate",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "plateColor"
        },
        "cornerRadius": 18
      },
      "size": {
        "w": {
          "expr": "max(@ref3_karaoke_wipe_base.width + platePadX * 2, 900)"
        },
        "h": {
          "expr": "fontSize + platePadY * 2"
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.18,
              "v": 1,
              "ease": "linear"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_karaoke_wipe_base",
      "type": "text",
      "content": {
        "text": {
          "var": "lyric"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Hiragino Sans W8', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'BIZ UDGothic', system-ui, sans-serif",
        "weight": 900,
        "color": {
          "var": "baseColor"
        },
        "align": "center",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "strokes": [
          {
            "color": {
              "var": "strokeOuter"
            },
            "width": 18
          },
          {
            "color": {
              "var": "strokeInner"
            },
            "width": 5
          }
        ],
        "shadows": [
          {
            "color": "rgba(0,0,0,0.72)",
            "blur": 12,
            "x": 0,
            "y": 4
          },
          {
            "color": "rgba(0,0,0,0.42)",
            "blur": 26,
            "x": 0,
            "y": 8
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.18,
              "v": 1,
              "ease": "linear"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_karaoke_wipe_active",
      "type": "text",
      "content": {
        "text": {
          "var": "lyric"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Hiragino Sans W8', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'BIZ UDGothic', system-ui, sans-serif",
        "weight": 900,
        "color": {
          "var": "activeColor"
        },
        "align": "center",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "strokes": [
          {
            "color": {
              "var": "strokeOuter"
            },
            "width": 18
          },
          {
            "color": {
              "var": "strokeInner"
            },
            "width": 5
          }
        ],
        "shadows": [
          {
            "color": {
              "var": "activeGlow"
            },
            "blur": 12,
            "x": 0,
            "y": 0
          },
          {
            "color": {
              "var": "activeGlow"
            },
            "blur": 30,
            "x": 0,
            "y": 0
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "wipe": {
        "axis": "x",
        "from": "start"
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.18,
              "v": 1,
              "ease": "linear"
            }
          ]
        },
        {
          "prop": "wipe",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "linear"
            },
            {
              "t": 0.18,
              "v": 0.036,
              "ease": "linear"
            }
          ]
        },
        {
          "prop": "wipe",
          "phase": "hold",
          "keys": [
            {
              "t": 0,
              "v": 0.036,
              "ease": "linear"
            },
            {
              "t": 4.82,
              "v": 1,
              "ease": "linear"
            }
          ]
        }
      ]
    }
  ]
