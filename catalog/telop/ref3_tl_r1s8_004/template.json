{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_tl_r1s8_004",
  "kind": "popup",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.4,
    "outDur": 0.3,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "テキスト",
      "default": "シンプルが、最も美しい。"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 80
    },
    {
      "key": "letterSpacing",
      "type": "number",
      "label": "字間",
      "default": 5
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "テキスト色",
      "default": "#F5F5F5"
    },
    {
      "key": "gradTop",
      "type": "color",
      "label": "帯グラデ上",
      "default": "rgba(24,24,28,0.92)"
    },
    {
      "key": "gradBottom",
      "type": "color",
      "label": "帯グラデ下",
      "default": "rgba(14,14,18,0.82)"
    },
    {
      "key": "borderColor",
      "type": "color",
      "label": "ボーダー色",
      "default": "rgba(255,255,255,0.18)"
    },
    {
      "key": "padX",
      "type": "number",
      "label": "帯左右余白",
      "default": 72
    },
    {
      "key": "padY",
      "type": "number",
      "label": "帯上下余白",
      "default": 36
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X 中心位置",
      "default": 960
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y 中心位置",
      "default": 540
    }
  ],
  "layers": [
    {
      "id": "ref3_tl_r1s8_004_bg",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "gradTop"
        },
        "fillGradient": {
          "type": "linear-v",
          "stops": [
            {
              "at": 0,
              "color": {
                "var": "gradTop"
              }
            },
            {
              "at": 1,
              "color": {
                "var": "gradBottom"
              }
            }
          ]
        },
        "cornerRadius": 4
      },
      "size": {
        "w": {
          "expr": "padX * 2 + @ref3_tl_r1s8_004_text.width"
        },
        "h": {
          "expr": "padY * 2 + fontSize"
        }
      },
      "transform": {
        "x": {
          "var": "posX"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "y",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 20,
              "ease": "out-cubic"
            },
            {
              "t": 0.4,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.4,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "y",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "in-cubic"
            },
            {
              "t": 0.3,
              "v": -16
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r1s8_004_border",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "borderColor"
        },
        "cornerRadius": 2
      },
      "size": {
        "w": {
          "expr": "padX * 2 + @ref3_tl_r1s8_004_text.width"
        },
        "h": 1
      },
      "transform": {
        "x": {
          "var": "posX"
        },
        "y": {
          "expr": "posY - padY - fontSize / 2"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "y",
          "phase": "in",
