          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.4,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "y",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "in-cubic"
            },
            {
              "t": 0.3,
              "v": -16
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r1s8_004_text",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Hiragino Sans W3', 'Yu Gothic Light', system-ui, sans-serif",
        "weight": 300,
        "color": {
          "var": "textColor"
        },
        "align": "center",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "shadow": {
          "color": "rgba(0,0,0,0.4)",
          "blur": 20,
          "x": 0,
          "y": 4
        }
      },
      "transform": {
        "x": {
          "var": "posX"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
