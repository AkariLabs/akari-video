{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_tl_r1s1_04",
  "kind": "free",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 6,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.1,
    "outDur": 0.4,
    "hold": "stretch",
    "previewTotal": 6
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "テキスト（電文）",
      "default": "東京発緊急連絡至急返電乞フ"
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "文字色",
      "default": "#D4C89A"
    },
    {
      "key": "plateColor",
      "type": "color",
      "label": "背景板色",
      "default": "rgba(20,16,8,0.82)"
    },
    {
      "key": "caretColor",
      "type": "color",
      "label": "カーソル色",
      "default": "#D4C89A"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 64
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置",
      "default": 200
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置",
      "default": 540
    },
    {
      "key": "letterSpacing",
      "type": "number",
      "label": "字間",
      "default": 2
    }
  ],
  "layers": [
    {
      "id": "ref3_tl_r1s1_04_plate",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "plateColor"
        },
        "cornerRadius": 4
      },
      "size": {
        "w": 1540,
        "h": 108
      },
      "transform": {
        "x": {
          "var": "posX"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.1,
              "v": 1,
              "ease": "linear"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.4,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r1s1_04_text",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Courier New', 'Courier', 'Hiragino Sans W3', monospace",
        "weight": 700,
        "color": {
          "var": "textColor"
        },
        "align": "left",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "fill": {
          "type": "linear-v",
          "stops": [
            {
              "at": 0,
              "color": "#EAD87A"
            },
            {
              "at": 0.5,
              "color": "#D4C89A"
            },
            {
              "at": 1,
              "color": "#A89660"
            }
          ]
        },
        "shadow": {
          "color": "rgba(180,150,60,0.45)",
          "blur": 10,
          "x": 0,
          "y": 0
        }
      },
      "transform": {
        "x": {
          "expr": "posX + 40"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.1,
              "v": 1,
              "ease": "linear"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.4,
              "v": 0
            }
          ]
        }
      ],
      "perChar": {
        "split": "grapheme",
        "stagger": 0.06,
        "order": "ltr",
        "tracks": [
          {
            "prop": "opacity",
            "keys": [
              {
                "t": 0,
                "v": 0
              },
              {
                "t": 0.01,
                "v": 1
              }
            ]
          }
        ],
        "caret": {
          "char": "▋",
          "blinkSec": 0.45,
          "color": "#D4C89A"
        }
      }
    }
  ]
}
