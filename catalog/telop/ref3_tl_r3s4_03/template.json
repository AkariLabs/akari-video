{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_tl_r3s4_03",
  "kind": "corner",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 5,
    "bg": "transparent"
  },
  "timing": {
