    {
      "key": "starAccent",
      "type": "color",
      "label": "星のグラデ下",
      "default": "#FF6F00"
    },
    {
      "key": "labelColor",
      "type": "color",
      "label": "ラベル文字色",
      "default": "#1A1A1A"
    },
    {
      "key": "nameColor",
      "type": "color",
      "label": "名前文字色",
      "default": "#FFFFFF"
    },
    {
      "key": "starSize",
      "type": "number",
      "label": "星サイズ",
      "default": 240
    },
    {
      "key": "labelFontSize",
      "type": "number",
      "label": "ラベル文字サイズ",
      "default": 68
    },
    {
      "key": "nameFontSize",
      "type": "number",
      "label": "名前文字サイズ",
      "default": 52
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X位置",
      "default": 200
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置",
      "default": 900
    }
  ],
  "layers": [
    {
      "id": "ref3_tl_r3s4_03_star",
      "type": "shape",
      "content": {
        "shape": "star",
        "fill": {
          "var": "starColor"
        },
        "fillGradient": {
          "type": "linear-v",
          "stops": [
            {
              "at": 0,
              "color": {
                "var": "starColor"
              }
            },
            {
              "at": 1,
              "color": {
                "var": "starAccent"
              }
            }
          ],
          "shimmer": {
            "periodSec": 2.2,
            "width": 0.3,
            "color": "rgba(255,255,255,0.8)"
          }
        },
        "star": {
          "points": 8,
          "innerRatio": 0.52
        }
      },
      "size": {
        "w": {
          "var": "starSize"
        },
        "h": {
          "var": "starSize"
        }
      },
      "transform": {
        "x": {
          "var": "posX"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "rotation",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -30,
              "ease": "out-back"
            },
            {
              "t": 1,
              "v": 0
            }
          ]
        },
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0.02,
              "ease": "out-back"
            },
            {
              "t": 0.55,
              "v": 1.12,
              "ease": "out-cubic"
            },
            {
              "t": 0.75,
              "v": 0.97,
              "ease": "out-back"
            },
            {
              "t": 1,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.1,
              "v": 1
            }
          ]
        },
        {
          "prop": "scale",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "in-cubic"
            },
            {
              "t": 1,
              "v": 0.02
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.8,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r3s4_03_label",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "labelFontSize"
        },
        "font": "'Hiragino Sans W9', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'BIZ UDGothic', system-ui, sans-serif",
        "weight": 900,
        "color": {
          "var": "labelColor"
        },
        "align": "center",
        "strokes": [
          {
            "color": "rgba(0,0,0,0.4)",
            "width": 6
          }
        ],
        "shadows": [
          {
            "color": "rgba(0,0,0,0.45)",
            "blur": 8,
            "x": 2,
            "y": 3
          }
        ]
      },
      "transform": {
        "x": {
          "var": "posX"
        },
        "y": {
          "expr": "posY - nameFontSize / 2 - 4"
        },
        "anchor": {
          "x": 0.5,
          "y": 1
        }
      },
      "tracks": [
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "out-back"
            },
            {
              "t": 1,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.4,
              "v": 0
            },
            {
              "t": 1,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.6,
              "v": 0
            }
          ]
        }
      ]
    },
    {
