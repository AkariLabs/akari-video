      "type": "text",
      "content": {
        "text": {
          "var": "subText"
        },
        "size": {
          "var": "nameFontSize"
        },
        "font": "'Hiragino Sans W7', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', system-ui, sans-serif",
        "weight": 700,
        "color": {
          "var": "nameColor"
        },
        "align": "center",
        "strokes": [
          {
            "color": "rgba(0,0,0,0.9)",
            "width": 10
          }
        ],
        "shadows": [
          {
            "color": "rgba(0,0,0,0.6)",
            "blur": 10,
            "x": 2,
            "y": 4
          }
        ]
