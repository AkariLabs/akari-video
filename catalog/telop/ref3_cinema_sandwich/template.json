{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_cinema_sandwich",
  "kind": "free",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.6,
    "outDur": 0.3,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "line1",
      "type": "text",
      "label": "1行目",
      "default": "MIDNIGHT PREVIEW"
    },
    {
      "key": "line2",
      "type": "text",
      "label": "2行目",
      "default": "COMING SOON"
    },
    {
      "key": "barColor",
      "type": "color",
      "label": "黒帯色",
      "default": "#000000"
    },
    {
      "key": "line1Color",
      "type": "color",
      "label": "1行目文字色",
      "default": "#ffffff"
    },
    {
      "key": "line2Color",
      "type": "color",
      "label": "2行目文字色",
      "default": "rgba(255,255,255,0.86)"
    },
    {
      "key": "shadowColor",
      "type": "color",
      "label": "文字影色",
      "default": "rgba(0,0,0,0.55)"
    },
    {
      "key": "line1FontSize",
      "type": "number",
      "label": "1行目サイズ",
      "default": 64
    },
    {
      "key": "line2FontSize",
      "type": "number",
      "label": "2行目サイズ",
      "default": 40
    },
    {
      "key": "letterSpacing",
      "type": "number",
      "label": "字間",
      "default": 8
    }
  ],
  "layers": [
    {
      "id": "ref3_cinema_sandwich_top_bar",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "barColor"
        },
        "cornerRadius": 0
      },
      "size": {
        "w": {
          "expr": "@stage.width"
        },
        "h": 140
      },
      "transform": {
        "x": 0,
        "y": 0,
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "y",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -140,
              "ease": "out-cubic"
            },
            {
              "t": 0.6,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_cinema_sandwich_bottom_bar",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "barColor"
        },
        "cornerRadius": 0
      },
      "size": {
        "w": {
          "expr": "@stage.width"
        },
        "h": 140
      },
      "transform": {
        "x": 0,
        "y": {
          "expr": "@stage.height - 140"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "y",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 140,
              "ease": "out-cubic"
            },
            {
              "t": 0.6,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_cinema_sandwich_line1",
      "type": "text",
      "content": {
        "text": {
          "var": "line1"
        },
        "size": {
          "var": "line1FontSize"
        },
        "font": "'Helvetica Neue', 'Arial', system-ui, sans-serif",
        "weight": 300,
        "color": {
          "var": "line1Color"
        },
        "align": "center",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "shadows": [
          {
            "color": {
              "var": "shadowColor"
            },
            "blur": 8,
            "x": 0,
            "y": 3
          },
          {
            "color": "rgba(255,255,255,0.18)",
            "blur": 2,
            "x": 0,
            "y": 0
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": 500,
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ],
      "visibleIf": {
        "expr": "has(line1)"
      }
    },
    {
      "id": "ref3_cinema_sandwich_line2",
      "type": "text",
      "content": {
        "text": {
          "var": "line2"
        },
        "size": {
          "var": "line2FontSize"
        },
        "font": "'Helvetica Neue', 'Arial', system-ui, sans-serif",
        "weight": 300,
        "color": {
          "var": "line2Color"
        },
        "align": "center",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "shadows": [
          {
            "color": {
              "var": "shadowColor"
            },
            "blur": 7,
            "x": 0,
            "y": 3
          },
          {
            "color": "rgba(255,255,255,0.14)",
            "blur": 2,
            "x": 0,
            "y": 0
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": 578,
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.3,
              "v": 0
            }
          ]
        }
      ],
      "visibleIf": {
        "expr": "has(line2)"
      }
    }
  ]
}
