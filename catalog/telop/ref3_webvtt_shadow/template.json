{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_webvtt_shadow",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.18,
    "outDur": 0.2,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "字幕テキスト（メイン）",
      "default": "これはテロップのサンプルです"
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "文字色",
      "default": "#FFFFFF"
    },
    {
      "key": "shadowColor",
      "type": "color",
      "label": "影色",
      "default": "#000000"
    }
  ],
  "layers": [
    {
      "id": "ref3_webvtt_shadow_text",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": 64,
        "font": "system-ui",
        "weight": 600,
        "color": {
          "var": "textColor"
        },
        "align": "center",
        "shadow": {
          "color": {
            "var": "shadowColor"
          },
          "blur": 3,
          "x": 1,
          "y": 1
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": 920,
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.18,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0
            }
          ]
        }
      ]
    }
  ]
}
