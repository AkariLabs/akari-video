{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_thin_separator",
  "kind": "lower-third",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.5,
    "outDur": 0.4,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "name",
      "type": "text",
      "label": "人名",
      "default": "haruka mizuno"
    },
    {
      "key": "role",
      "type": "text",
      "label": "role（空で非表示）",
      "default": "creative director"
    },
    {
      "key": "nameColor",
      "type": "color",
      "label": "人名色",
      "default": "#ffffff"
    },
    {
      "key": "roleColor",
      "type": "color",
      "label": "role 色",
      "default": "rgba(255,255,255,0.82)"
    },
    {
      "key": "lineColor",
      "type": "color",
      "label": "線色",
      "default": "#ffffff"
    },
    {
      "key": "shadowColor",
      "type": "color",
      "label": "影色",
      "default": "rgba(0,0,0,0.38)"
    },
    {
      "key": "left",
      "type": "number",
      "label": "左位置",
      "default": 60
    },
    {
      "key": "baseY",
      "type": "number",
      "label": "縦位置",
      "default": 820
    },
    {
      "key": "minLineWidth",
      "type": "number",
      "label": "線の最小幅",
      "default": 300
    },
    {
      "key": "lineExtra",
      "type": "number",
      "label": "線の余白",
      "default": 18
    }
  ],
  "layers": [
    {
      "id": "ref3_thin_separator_name",
      "type": "text",
      "content": {
        "text": {
          "var": "name"
        },
        "size": 40,
        "font": "system-ui",
        "weight": 350,
        "color": {
          "var": "nameColor"
        },
        "align": "left",
        "shadow": {
          "color": {
            "var": "shadowColor"
          },
          "blur": 6,
          "x": 0,
          "y": 2
        }
      },
      "transform": {
        "x": {
          "var": "left"
        },
        "y": {
          "var": "baseY"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "out-cubic"
            },
            {
              "t": 0.5,
              "v": 1
            }
          ]
        },
        {
          "prop": "y",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 8,
              "ease": "out-cubic"
            },
            {
              "t": 0.5,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "in-cubic"
            },
            {
              "t": 0.4,
              "v": 0
            }
          ]
        },
        {
          "prop": "y",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "in-cubic"
            },
            {
              "t": 0.4,
              "v": 8
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_thin_separator_line",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "lineColor"
        },
        "cornerRadius": 0
      },
      "size": {
        "w": {
          "expr": "max(@ref3_thin_separator_name.width + lineExtra, minLineWidth)"
        },
        "h": 1
      },
      "transform": {
        "x": {
          "var": "left"
        },
        "y": {
          "expr": "baseY + 36"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "out-cubic"
            },
            {
              "t": 0.5,
              "v": 1
            }
          ]
        },
        {
          "prop": "y",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 8,
              "ease": "out-cubic"
            },
            {
              "t": 0.5,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "in-cubic"
            },
            {
              "t": 0.4,
              "v": 0
            }
          ]
        },
        {
          "prop": "y",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "in-cubic"
            },
            {
              "t": 0.4,
              "v": 8
            }
          ]
        }
      ],
      "visibleIf": {
        "expr": "has(role)"
      }
    },
    {
      "id": "ref3_thin_separator_role",
      "type": "text",
      "content": {
        "text": {
          "var": "role"
        },
        "size": 22,
        "font": "system-ui",
        "weight": 300,
        "color": {
          "var": "roleColor"
        },
        "align": "left",
        "shadow": {
          "color": {
            "var": "shadowColor"
          },
          "blur": 5,
          "x": 0,
          "y": 2
        }
      },
      "transform": {
        "x": {
          "var": "left"
        },
        "y": {
          "expr": "baseY + 66"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "out-cubic"
            },
            {
              "t": 0.5,
              "v": 1
            }
          ]
        },
        {
          "prop": "y",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 8,
              "ease": "out-cubic"
            },
            {
              "t": 0.5,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "in-cubic"
            },
            {
              "t": 0.4,
              "v": 0
            }
          ]
        },
        {
          "prop": "y",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "in-cubic"
            },
            {
              "t": 0.4,
              "v": 8
            }
          ]
        }
      ],
      "visibleIf": {
        "expr": "has(role)"
      }
    }
  ]
}
