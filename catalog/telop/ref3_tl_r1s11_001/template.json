{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_tl_r1s11_001",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.6,
    "outDur": 0.5,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "テキスト",
      "default": "逃げられない"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 96
    },
    {
      "key": "bloodTop",
      "type": "color",
      "label": "血色 上端",
      "default": "#8B0000"
    },
    {
      "key": "bloodMid",
      "type": "color",
      "label": "血色 中間",
      "default": "#C0000A"
    },
    {
      "key": "bloodBottom",
      "type": "color",
      "label": "血色 下端（垂れ先）",
      "default": "#3A0000"
    },
    {
      "key": "strokeColor",
      "type": "color",
      "label": "縁取り色",
      "default": "#1A0000"
    },
    {
      "key": "glowColor",
      "type": "color",
      "label": "血の光",
      "default": "rgba(180,0,0,0.55)"
    },
    {
      "key": "posY",
      "type": "number",
      "label": "表示Y位置",
      "default": 820
    }
  ],
  "layers": [
    {
      "id": "ref3_tl_r1s11_001_plate",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": "rgba(10,0,0,0.62)",
        "cornerRadius": 4
      },
      "size": {
        "w": {
          "expr": "@stage.width"
        },
        "h": {
          "expr": "fontSize * 1.6"
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.6,
              "v": 1,
              "ease": "in-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.5,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r1s11_001_text",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Hiragino Mincho ProN', 'Yu Mincho', 'BIZ UDMincho', Georgia, serif",
        "weight": 900,
        "color": "#C0000A",
        "align": "center",
        "fill": {
          "type": "linear-v",
          "stops": [
            {
              "at": 0,
              "color": {
                "var": "bloodTop"
              }
            },
            {
              "at": 0.45,
              "color": {
                "var": "bloodMid"
              }
            },
            {
              "at": 1,
              "color": {
                "var": "bloodBottom"
              }
            }
          ]
        },
        "strokes": [
          {
            "color": {
              "var": "strokeColor"
            },
            "width": 14
          }
        ],
        "shadows": [
          {
            "color": {
              "var": "glowColor"
            },
            "blur": 24,
            "x": 0,
            "y": 6
          },
          {
            "color": "rgba(0,0,0,0.85)",
            "blur": 8,
            "x": 0,
            "y": 3
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "perChar": {
        "split": "grapheme",
        "stagger": 0.04,
        "order": "ltr",
        "tracks": [
          {
            "prop": "opacity",
            "phase": "in",
            "keys": [
              {
                "t": 0,
                "v": 0
              },
              {
                "t": 0.35,
                "v": 1,
                "ease": "out-cubic"
              }
            ]
          }
        ],
        "randomize": {
          "seed": 666,
          "dyAmp": 8,
          "rotAmp": 3
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.6,
              "v": 1,
              "ease": "in-cubic"
            }
          ]
        },
        {
          "prop": "y",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -18,
              "ease": "out-cubic"
            },
            {
              "t": 0.6,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.5,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    }
  ]
}
