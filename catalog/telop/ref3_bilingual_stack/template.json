        "w": {
          "expr": "max(max(@ref3_bilingual_stack_jp_text.width, @ref3_bilingual_stack_en_text.width) + padX * 2 + lineWidth + 18, 560)"
        },
        "h": {
          "expr": "jpSize + enSize + padY * 2 + 18"
        }
      },
      "transform": {
        "x": {
          "var": "blockX"
        },
        "y": {
          "var": "blockY"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "y",
          "phase": "in",
          "keys": [
