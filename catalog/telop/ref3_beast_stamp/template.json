{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_beast_stamp",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.1,
    "outDur": 0.08,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "word",
      "type": "text",
      "label": "スタンプ語句",
      "default": "NO WAY!"
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "本文色",
      "default": "#FFFFFF"
    },
    {
      "key": "strokeColor",
      "type": "color",
      "label": "縁取り色",
      "default": "#000000"
    }
  ],
  "layers": [
    {
      "id": "ref3_beast_stamp_text",
      "type": "text",
      "content": {
        "text": {
          "var": "word"
        },
        "size": 130,
        "font": "Impact, \"Arial Black\", system-ui, sans-serif",
        "weight": 900,
        "color": {
          "var": "textColor"
        },
        "align": "center",
        "strokes": [
          {
            "color": {
              "var": "strokeColor"
            },
            "width": 10
          }
        ],
        "shadow": {
          "color": "rgba(0,0,0,0.78)",
          "blur": 28,
          "x": 8,
          "y": 12
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "expr": "@stage.height * 0.65"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        },
        "rotation": -2
      },
      "tracks": [
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 1.4,
              "ease": "out-back"
            },
            {
              "t": 0.1,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.03,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.08,
              "v": 0
            }
          ]
        }
      ]
    }
  ]
}
