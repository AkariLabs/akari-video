{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_tl_r1s9_004",
  "kind": "lower-third",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.6,
    "outDur": 0.5,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "氏名",
      "default": "AKIRA KUROSAWA"
    },
    {
      "key": "role",
      "type": "text",
      "label": "役職・肩書き",
      "default": "DIRECTOR"
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "氏名文字色",
      "default": "#FFFFFF"
    },
    {
      "key": "roleColor",
      "type": "color",
      "label": "役職文字色",
      "default": "rgba(255,255,255,0.65)"
    },
    {
      "key": "accentTopColor",
      "type": "color",
      "label": "アクセントライン 上端色",
      "default": "#C8A96E"
    },
    {
      "key": "accentBottomColor",
      "type": "color",
      "label": "アクセントライン 下端色",
      "default": "rgba(180,140,60,0.30)"
    },
    {
      "key": "shadowColor",
      "type": "color",
      "label": "影色",
      "default": "rgba(0,0,0,0.70)"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "氏名文字サイズ",
      "default": 64
    },
    {
      "key": "roleFontSize",
      "type": "number",
      "label": "役職文字サイズ",
      "default": 32
    },
    {
      "key": "letterSpacing",
      "type": "number",
      "label": "字間",
      "default": 6
    },
    {
      "key": "posX",
      "type": "number",
      "label": "X 位置",
      "default": 180
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y 位置（名前基準）",
      "default": 880
    }
  ],
  "layers": [
    {
      "id": "ref3_tl_r1s9_004_accent",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "accentTopColor"
        },
        "fillGradient": {
          "type": "linear-v",
          "stops": [
            {
              "at": 0,
              "color": {
                "var": "accentTopColor"
              }
            },
            {
              "at": 1,
              "color": {
                "var": "accentBottomColor"
              }
            }
          ]
        }
      },
      "size": {
        "w": 2,
        "h": {
          "expr": "fontSize + roleFontSize + 20"
        }
      },
      "transform": {
        "x": {
          "var": "posX"
        },
        "y": {
          "expr": "posY - roleFontSize - 12"
        },
        "anchor": {
          "x": 0.5,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.6,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.5,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r1s9_004_role",
      "type": "text",
      "content": {
        "text": {
          "var": "role"
        },
        "size": {
          "var": "roleFontSize"
        },
        "font": "'Helvetica Neue', 'Arial', 'Hiragino Kaku Gothic ProN', system-ui, sans-serif",
        "weight": 300,
        "color": {
          "var": "roleColor"
        },
        "align": "left",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "shadow": {
          "color": {
            "var": "shadowColor"
          },
          "blur": 10,
          "x": 0,
          "y": 2
        }
      },
      "transform": {
        "x": {
          "expr": "posX + 18"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0,
          "y": 1
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.6,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "y",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 10,
              "ease": "out-cubic"
            },
            {
              "t": 0.6,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.5,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r1s9_004_name",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Helvetica Neue', 'Arial', 'Hiragino Kaku Gothic ProN', system-ui, sans-serif",
        "weight": 300,
        "color": {
          "var": "textColor"
        },
        "align": "left",
        "letterSpacing": {
          "var": "letterSpacing"
        },
        "shadow": {
          "color": {
            "var": "shadowColor"
          },
          "blur": 16,
          "x": 0,
          "y": 4
        }
      },
      "transform": {
        "x": {
          "expr": "posX + 18"
        },
        "y": {
          "expr": "posY + 10"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.6,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "y",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 16,
              "ease": "out-cubic"
            },
            {
              "t": 0.6,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.5,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    }
  ]
}
