{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_beat_stamp",
  "kind": "popup",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.2,
    "outDur": 0.12,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "word",
      "type": "text",
      "label": "スタンプ語句",
      "default": "BEAT!"
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "文字色",
      "default": "#000000"
    },
    {
      "key": "strokeColor",
      "type": "color",
      "label": "縁色",
      "default": "#FFFFFF"
    }
  ],
  "layers": [
    {
      "id": "ref3_beat_stamp_word",
      "type": "text",
      "content": {
        "text": {
          "var": "word"
        },
        "size": 190,
        "font": "Impact, \"Arial Black\", system-ui, sans-serif",
        "weight": 900,
        "color": {
          "var": "textColor"
        },
        "align": "center",
        "strokes": [
          {
            "color": {
              "var": "strokeColor"
            },
            "width": 12
          }
        ],
        "shadow": {
          "color": "rgba(0,0,0,0.35)",
          "blur": 10,
          "x": 0,
          "y": 6
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "expr": "@stage.height / 2"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 1.3,
              "ease": "out-back"
            },
            {
              "t": 0.12,
              "v": 0.95,
              "ease": "inout-cubic"
            },
            {
              "t": 0.2,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.03,
              "v": 1
            }
          ]
        },
        {
          "prop": "scale",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1,
              "ease": "in-cubic"
            },
            {
              "t": 0.12,
              "v": 1.15
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.12,
              "v": 0
            }
          ]
        }
      ]
    }
  ]
}
