      "type": "number",
      "label": "文字サイズ",
      "default": 150
    },
    {
      "key": "letterSpacing",
      "type": "number",
      "label": "字間",
      "default": 3
    },
    {
      "key": "yPosition",
      "type": "number",
      "label": "縦位置",
      "default": 560
    },
    {
      "key": "tilt",
