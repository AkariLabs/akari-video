                "var": "grainDark"
              }
            },
            {
              "at": 0.5,
              "color": {
                "var": "grainLight"
              }
            },
            {
              "at": 0.61,
              "color": {
                "var": "grainMid"
              }
            },
            {
              "at": 0.74,
              "color": {
