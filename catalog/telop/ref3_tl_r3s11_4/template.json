          "var": "color_bg"
        },
        "cornerRadius": 3
      },
      "size": {
        "w": {
          "expr": "@ref3_tl_r3s11_4_name.width + padX * 2 + 40"
        },
        "h": {
          "expr": "nameFontSize + titleFontSize + padY * 2 + 12"
        }
      },
      "transform": {
        "x": {
          "var": "posX"
        },
        "y": {
          "expr": "posY - nameFontSize - titleFontSize - padY * 2 - 12"
        },
        "anchor": {
          "x": 0,
          "y": 0
        }
      },
      "tracks": [
        {
          "prop": "x",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": -60,
              "ease": "out-cubic"
            },
            {
              "t": 1,
              "v": 0
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.3,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
