{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_arib_plate",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.2,
    "outDur": 0.2,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "字幕本文",
      "default": "ただいま音声を字幕でお伝えしています"
    },
    {
      "key": "plateColor",
      "type": "color",
      "label": "プレート色",
      "default": "rgba(0,0,0,0.5)"
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "文字色",
      "default": "#ffffff"
    }
  ],
  "layers": [
    {
      "id": "ref3_arib_plate_band",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "plateColor"
        },
        "cornerRadius": 0
      },
      "size": {
        "w": {
          "expr": "@stage.width"
        },
        "h": 54
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": 999,
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.2,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_arib_plate_text",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": 42,
        "font": "'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'BIZ UDGothic', system-ui, sans-serif",
        "weight": 600,
        "color": {
          "var": "textColor"
        },
        "align": "center"
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": 999,
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.2,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0
            }
          ]
        }
      ]
    }
  ]
}
