{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_isometric_block",
  "kind": "popup",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
