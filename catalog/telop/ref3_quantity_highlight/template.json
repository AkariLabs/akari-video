{
  "format": "atf",
  "version": "0.1",
  "id": "ref3_quantity_highlight",
  "kind": "caption",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.4,
    "outDur": 0.4,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "ingredient",
      "type": "text",
      "label": "材料名テキスト",
      "default": "じゃがいも"
    },
    {
      "key": "quantity",
      "type": "text",
      "label": "分量テキスト",
      "default": "2個"
    },
    {
      "key": "quantityColor",
      "type": "color",
      "label": "分量強調色",
      "default": "#FFD700"
    },
    {
      "key": "bandOpacity",
      "type": "number",
      "label": "帯の透明度",
      "default": 0.65
    },
    {
      "key": "ingredientColor",
      "type": "color",
      "label": "材料名色",
      "default": "#FFFFFF",
      "optional": true
    }
  ],
  "layers": [
    {
      "id": "ref3_quantity_highlight_band",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": "#000000",
        "cornerRadius": 60
      },
      "size": {
        "w": {
          "expr": "max(@ref3_quantity_highlight_ingredient.width + @ref3_quantity_highlight_quantity.width + 196, 620)"
        },
        "h": 120
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "expr": "@stage.height / 2"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        },
        "opacity": {
          "var": "bandOpacity"
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.4,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.4,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_quantity_highlight_ingredient",
      "type": "text",
      "content": {
        "text": {
          "var": "ingredient"
        },
        "size": 64,
        "font": "'Hiragino Maru Gothic ProN', sans-serif",
        "weight": 400,
        "color": {
          "var": "ingredientColor"
        },
        "align": "right",
        "stroke": {
          "color": "rgba(0,0,0,0.45)",
          "width": 3
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2 - 18"
        },
        "y": {
          "expr": "@stage.height / 2 + 2"
        },
        "anchor": {
          "x": 1,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.4,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.4,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_quantity_highlight_quantity",
      "type": "text",
      "content": {
        "text": {
          "var": "quantity"
        },
        "size": 88,
        "font": "'Hiragino Maru Gothic ProN', sans-serif",
        "weight": 800,
        "color": {
          "var": "quantityColor"
        },
        "align": "left",
        "strokes": [
          {
            "color": "rgba(0,0,0,0.85)",
            "width": 12
          },
          {
            "color": "rgba(0,0,0,0.55)",
            "width": 4
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2 + 18"
        },
        "y": {
          "expr": "@stage.height / 2"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.4,
              "v": 1
            }
          ]
        },
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0.9,
              "ease": "out-cubic"
            },
            {
              "t": 0.4,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.4,
              "v": 0
            }
          ]
        }
      ]
    }
  ]
}
