{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_anger_shake",
  "kind": "popup",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 4.5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.2,
    "outDur": 0.18,
    "hold": "stretch",
    "previewTotal": 5
  },
  "variables": [
    {
      "key": "word",
      "type": "text",
      "label": "本文",
      "default": "ふざけるな!!"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 116
    },
    {
      "key": "redTop",
      "type": "color",
      "label": "背景上色",
      "default": "#FF3636"
    },
    {
      "key": "redBottom",
      "type": "color",
      "label": "背景下色",
      "default": "#5A0000"
    },
    {
      "key": "bandColor",
      "type": "color",
      "label": "座布団色",
      "default": "rgba(0,0,0,0.68)"
    }
  ],
  "layers": [
    {
      "id": "ref3_anger_shake_bg",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": "#910000",
        "fillGradient": {
          "type": "linear-v",
          "stops": [
            {
              "at": 0,
              "color": {
                "var": "redTop"
              }
            },
            {
              "at": 1,
              "color": {
                "var": "redBottom"
              }
            }
          ]
        },
        "cornerRadius": 0
      },
      "size": {
        "w": {
          "expr": "@stage.width"
        },
        "h": 300
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": 540,
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.03,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.18,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_anger_shake_band",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "bandColor"
        },
        "cornerRadius": 0
      },
      "size": {
        "w": {
          "expr": "min(max(@ref3_anger_shake_word.width + 180, 760), @stage.width)"
        },
        "h": {
          "expr": "@ref3_anger_shake_word.height + 88"
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": 540,
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 1.35,
              "ease": "out-back"
            },
            {
              "t": 0.2,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.03,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.18,
              "v": 0
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_anger_shake_word",
      "type": "text",
      "content": {
        "text": {
          "var": "word"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Hiragino Sans W8', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'BIZ UDGothic', system-ui, sans-serif",
        "weight": 900,
        "color": "#ffffff",
        "align": "center",
        "strokes": [
          {
            "color": "#000000",
            "width": 24
          },
          {
            "color": "#ffffff",
            "width": 10
          }
        ],
        "shadows": [
          {
            "color": "rgba(0,0,0,0.85)",
            "blur": 18,
            "x": 5,
            "y": 7
          },
          {
            "color": "rgba(255,255,255,0.24)",
            "blur": 10,
            "x": -3,
            "y": -3
          }
        ]
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": 540,
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "scale",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 1.35,
              "ease": "out-back"
            },
            {
              "t": 0.2,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "step"
            },
            {
              "t": 0.03,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.18,
              "v": 0
            }
          ]
        }
      ],
      "perChar": {
        "split": "grapheme",
        "stagger": 0,
        "tracks": [],
        "loop": {
          "shake": {
            "ampX": 5,
            "periodSec": 0.2
          }
        }
      }
    }
  ]
}
