{
  "format": "atf",
  "version": "0.2",
  "id": "ref3_tl_r2s0_004",
  "kind": "lower-third",
  "stage": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration": 5,
    "bg": "transparent"
  },
  "timing": {
    "inDur": 0.45,
    "outDur": 0.25,
    "hold": "stretch",
    "previewTotal": 6
  },
  "variables": [
    {
      "key": "text",
      "type": "text",
      "label": "ヒント・ポイント本文",
      "default": "変数名には短くて明確な名前を付けると読みやすくなります"
    },
    {
      "key": "label",
      "type": "text",
      "label": "ラベル（POINT / TIP / NOTE 等）",
      "default": "POINT"
    },
    {
      "key": "bandColor",
      "type": "color",
      "label": "帯グラデ 左色",
      "default": "#0D47A1"
    },
    {
      "key": "bandColorRight",
      "type": "color",
      "label": "帯グラデ 右色",
      "default": "#1976D2"
    },
    {
      "key": "labelBgColor",
      "type": "color",
      "label": "ラベル背景色",
      "default": "#FFC107"
    },
    {
      "key": "labelTextColor",
      "type": "color",
      "label": "ラベル文字色",
      "default": "#1A1A1A"
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "ヒント文字色",
      "default": "#FFFFFF"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "本文文字サイズ",
      "default": 54
    },
    {
      "key": "labelFontSize",
      "type": "number",
      "label": "ラベル文字サイズ",
      "default": 36
    },
    {
      "key": "posY",
      "type": "number",
      "label": "Y位置（帯中心）",
      "default": 920
    },
    {
      "key": "bandHeight",
      "type": "number",
      "label": "帯の高さ",
      "default": 100
    }
  ],
  "layers": [
    {
      "id": "ref3_tl_r2s0_004_band",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "bandColor"
        },
        "fillGradient": {
          "type": "linear-h",
          "stops": [
            {
              "at": 0,
              "color": {
                "var": "bandColor"
              }
            },
            {
              "at": 1,
              "color": {
                "var": "bandColorRight"
              }
            }
          ],
          "shimmer": {
            "periodSec": 3.5,
            "width": 0.18,
            "color": "rgba(255,255,255,0.22)"
          }
        }
      },
      "size": {
        "w": {
          "expr": "@stage.width"
        },
        "h": {
          "var": "bandHeight"
        }
      },
      "transform": {
        "x": 0,
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "wipe": {
        "axis": "x",
        "from": "start"
      },
      "tracks": [
        {
          "prop": "wipe",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0,
              "ease": "out-cubic"
            },
            {
              "t": 0.4,
              "v": 1
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.25,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r2s0_004_label_bg",
      "type": "shape",
      "content": {
        "shape": "rect",
        "fill": {
          "var": "labelBgColor"
        },
        "cornerRadius": 6
      },
      "size": {
        "w": {
          "expr": "labelFontSize * 4.5"
        },
        "h": {
          "expr": "bandHeight - 20"
        }
      },
      "transform": {
        "x": 48,
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.2,
              "v": 0
            },
            {
              "t": 0.45,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r2s0_004_label_text",
      "type": "text",
      "content": {
        "text": {
          "var": "label"
        },
        "size": {
          "var": "labelFontSize"
        },
        "font": "'Arial Black', 'Hiragino Sans W8', system-ui, sans-serif",
        "weight": 900,
        "color": {
          "var": "labelTextColor"
        },
        "align": "center",
        "letterSpacing": 3
      },
      "transform": {
        "x": {
          "expr": "48 + labelFontSize * 2.25"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.2,
              "v": 0
            },
            {
              "t": 0.45,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    },
    {
      "id": "ref3_tl_r2s0_004_text",
      "type": "text",
      "content": {
        "text": {
          "var": "text"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Hiragino Sans W4', 'BIZ UDGothic', system-ui, sans-serif",
        "weight": 500,
        "color": {
          "var": "textColor"
        },
        "align": "left",
        "letterSpacing": 1,
        "shadow": {
          "color": "rgba(0,0,0,0.4)",
          "blur": 8,
          "x": 0,
          "y": 2
        }
      },
      "size": {
        "w": {
          "expr": "@stage.width - labelFontSize * 4.5 - 128"
        },
        "h": {
          "expr": "fontSize * 1.5"
        }
      },
      "clip": {
        "type": "inset"
      },
      "transform": {
        "x": {
          "expr": "48 + labelFontSize * 4.5 + 32"
        },
        "y": {
          "var": "posY"
        },
        "anchor": {
          "x": 0,
          "y": 0.5
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
          "keys": [
            {
              "t": 0,
              "v": 0
            },
            {
              "t": 0.2,
              "v": 0
            },
            {
              "t": 0.45,
              "v": 1,
              "ease": "out-cubic"
            }
          ]
        },
        {
          "prop": "opacity",
          "phase": "out",
          "keys": [
            {
              "t": 0,
              "v": 1
            },
            {
              "t": 0.2,
              "v": 0,
              "ease": "in-cubic"
            }
          ]
        }
      ]
    }
  ]
}
