  "variables": [
    {
      "key": "word",
      "type": "text",
      "label": "本文",
      "default": "消えたはずの声"
    },
    {
      "key": "fontSize",
      "type": "number",
      "label": "文字サイズ",
      "default": 132
    },
    {
      "key": "edgeColor",
      "type": "color",
      "label": "縁色",
      "default": "#ffffff"
    },
    {
      "key": "glowStrength",
      "type": "number",
      "label": "グロー強度",
      "default": 0.82
    },
    {
      "key": "padding",
      "type": "number",
      "label": "余白",
      "default": 34
    }
  ],
  "layers": [
    {
      "id": "ref3_hollow_ghost_glow",
      "type": "text",
      "content": {
        "text": {
          "var": "word"
        },
        "size": {
          "var": "fontSize"
        },
        "font": "'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'BIZ UDGothic', system-ui, sans-serif",
        "weight": 800,
        "color": "transparent",
        "align": "center",
        "strokes": [
          {
            "color": {
              "var": "edgeColor"
            },
            "width": 2
          }
        ],
        "shadows": [
          {
            "color": "#ffffff",
            "blur": 40,
            "x": 0,
            "y": 0
          }
        ],
        "letterSpacing": 2
      },
      "size": {
        "w": {
          "expr": "@ref3_hollow_ghost_text.width + padding * 2"
        },
        "h": {
          "expr": "@ref3_hollow_ghost_text.height + padding * 2"
        }
      },
      "transform": {
        "x": {
          "expr": "@stage.width / 2"
        },
        "y": {
          "expr": "@stage.height * 0.54"
        },
        "anchor": {
          "x": 0.5,
          "y": 0.5
        },
        "opacity": {
          "var": "glowStrength"
        }
      },
      "tracks": [
        {
          "prop": "opacity",
          "phase": "in",
