{
  "version": 2,
  "output": { "width": 1920, "height": 1080, "fps": 30 },
  "sources": [
    { "id": "main", "path": "assets/talk.mp4" },
    { "id": "music", "path": "assets/music.wav" }
  ],
  "tracks": [
    {
      "id": "a1",
      "lane": "audio",
      "items": [
        { "id": "music-1", "at": 0, "duration": 300, "source": { "kind": "media", "src": "music", "in": 0, "out": 10 } }
      ]
    },
    {
      "id": "v-main",
      "lane": "visual",
      "items": [
        { "id": "clip-1", "at": 0, "duration": 300, "source": { "kind": "media", "src": "main", "in": 12, "out": 22 } }
      ]
    },
    { "id": "captions", "lane": "visual", "content": { "from": "captions.json" } },
    {
      "id": "v-filter",
      "lane": "visual",
      "items": [
        { "id": "filter-1", "at": 0, "duration": 300, "source": { "kind": "filter", "filter": { "type": "invert" } } }
      ]
    },
    {
      "id": "v-html",
      "lane": "visual",
      "items": [
        { "id": "html-1", "at": 30, "duration": 60, "source": { "kind": "html", "path": "overlays/title.html" } }
      ]
    },
    {
      "id": "v-telop",
      "lane": "visual",
      "name": "最前面へ入れ替え済み",
      "items": [
        { "id": "telop-1", "at": 45, "duration": 75, "source": { "kind": "telop", "preset": "name", "baked": "assets/layers/name.mov" } }
      ]
    }
  ]
}
