{
  "name": "@akari-video/edit-store",
  "version": "0.1.0",
  "description": "AKARI Video — edit.json / captions.json のテキスト手術と lint ゲート付き書き込み層（shell と preview-server の共有カーネル）",
  "private": true,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./lib/project": "./lib/project.js",
    "./lib/write-gate": "./lib/write-gate.js",
    "./lib/migrate": "./lib/migrate/index.js",
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./src/caption-visual-contract.json": "./src/caption-visual-contract.json"
  },
  "scripts": {
    "build": "npm run gen:textstyle-catalog && tsc -b && npm run bundle:webview",
    "bundle:webview": "esbuild src/webview-kernel.ts --bundle --format=iife --global-name=AkariEditKernel --outfile=lib/webview-kernel.js --target=chrome122 --platform=browser",
    "clean": "rimraf lib",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:textstyle-catalog": "node scripts/gen-textstyle-catalog.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "rimraf": "^5.0.0",
    "esbuild": "^0.24.0"
  }
}
