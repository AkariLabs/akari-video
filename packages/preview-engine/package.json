{
  "name": "@akari-video/preview-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Shell-agnostic TS preview engine (level 3, Chromium-internal). E1-E4 decode path plus E5 thumbnail scrub layer. See README.md for public API.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "bench:build": "esbuild bench/renderer/bench.ts --bundle --format=iife --outfile=bench/renderer/bench.bundle.js --target=chrome122",
    "bench:start": "npm run bench:build && cd bench && npm start"
  },
  "dependencies": {
    "@webav/av-cliper": "1.2.8",
    "@webav/mp4box.js": "^0.5.7"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
