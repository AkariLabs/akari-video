{
  "version": 2,
  "output": { "width": 1920, "height": 1080, "fps": 30 },
  "sources": [
    { "id": "main", "path": "assets/talk.mp4" },
    { "id": "sfx", "path": "assets/hit.wav" },
    { "id": "voice", "path": "assets/narration.wav" },
    { "id": "music", "path": "assets/music.wav" }
  ],
  "tracks": [
    {
      "id": "a-sfx",
      "lane": "audio",
      "name": "効果音",
      "role": "sfx",
      "items": [
        {
          "id": "hit-1",
          "at": 30,
          "duration": 15,
          "source": { "kind": "media", "src": "sfx", "in": 0.25, "out": 0.75, "gain_db": -6 }
        }
      ]
    },
    {
      "id": "a-narration",
      "lane": "audio",
      "name": "ナレーション",
      "role": "narration",
      "items": [
        {
          "id": "n-0001",
          "at": 60,
          "duration": 90,
          "script": "AKARI Videoへようこそ",
          "source": { "kind": "media", "src": "voice", "in": 0, "out": 3, "gain_db": 1.5 }
        }
      ]
    },
    {
      "id": "a-bgm",
      "lane": "audio",
      "name": "BGM",
      "role": "bgm",
      "items": [
        {
          "id": "music-1",
          "at": 0,
          "duration": 300,
          "source": { "kind": "media", "src": "music", "in": 0, "out": 10, "gain_db": -18, "fade_in": 1.25, "fade_out": 2.5, "ducking": true }
        }
      ]
    },
    {
      "id": "v-main",
      "lane": "visual",
      "name": "本編",
      "items": [
        {
          "id": "clip-1",
          "at": 0,
          "duration": 300,
          "source": { "kind": "media", "src": "main", "in": 12, "out": 22 }
        }
      ]
    },
    {
      "id": "captions",
      "lane": "visual",
      "name": "字幕",
      "content": { "from": "captions.json" }
    },
    {
      "id": "v-filter",
      "lane": "visual",
      "name": "色補正",
      "items": [
        {
          "id": "filter-1",
          "at": 0,
          "duration": 300,
          "source": { "kind": "filter", "filter": { "type": "saturation", "value": 1.1 } }
        }
      ]
    },
    {
      "id": "v-html",
      "lane": "visual",
      "name": "HTML",
      "items": [
        {
          "id": "html-1",
          "at": 30,
          "duration": 60,
          "source": { "kind": "html", "path": "overlays/title.html" }
        }
      ]
    },
    {
      "id": "v-telop",
      "lane": "visual",
      "name": "テロップ（最前面へ入れ替え済み）",
      "items": [
        {
          "id": "telop-1",
          "at": 45,
          "duration": 75,
          "source": {
            "kind": "telop",
            "preset": "ref3_name_rounded",
            "params": { "name": "AKARI" },
            "baked": "assets/layers/name-rounded.mov"
          }
        }
      ]
    }
  ]
}
