{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akari-video:schema:skill-renames:v1",
  "title": "AKARI Video skill rename table",
  "description": "One row per renamed skill. Old project copies and old catalog lookups are resolved through this table.",
  "type": "object",
  "required": [
    "version",
    "renames"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "renames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "since"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "since": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
