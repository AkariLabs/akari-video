{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akari-video:schema:asset-meta:v0",
  "title": "AKARI Video Asset Metadata v0",
  "description": "AKARI Video 素材ライブラリの meta.json 契約 v0。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "title",
    "description",
    "when_to_use",
    "tags",
    "knobs",
    "ai_usage",
    "requires",
    "provenance",
    "author",
    "license",
    "price"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {
      "type": "string",
      "$comment": "2026-07-29 に主題（3d/motion/telop/thumbnail…）から配布物の形へ切り替えた。overlay=時間を持つ HTML 断片 / still=時間を持たない HTML シート / scene3d=glTF+Three.js またはベイクレシピ / audio=音声トラックに載るバイナリ / broll=映像トラックに載る実写バイナリ / font=書体バイナリ。主題は tags に逃がす（カテゴリを増やさない）。",
      "enum": ["overlay", "still", "scene3d", "audio", "broll", "font"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "when_to_use": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "knobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knob"
      }
    },
    "ai_usage": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "license": {
      "$ref": "#/$defs/license"
    },
    "price": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0 }
      ]
    },
    "matched_by": {
      "$comment": "drop-folder タイトル正規化照合の来歴フィールド（2026-07-22 導入）。将来の照合経路追加時は enum を拡張する。",
      "enum": ["title-normalized"]
    },
    "version": {
      "$comment": "素材の版（2026-07-30 導入。data-contract-versioning 契約 §3 の宿題を果たすもの）。初版は 1。ツマミの削除・改名・type/unit 変更・範囲の縮小、クラス構造やスロットの変更は破壊的変更として bump する。ラベル・説明・tags・ai_usage の更新では上げない。harness/knob-diff.mjs が bump 漏れを検出する。",
      "type": "integer",
      "minimum": 1
    },
    "min_app_version": {
      "$comment": "この素材が要求する AKARI Video の最低版（任意）。古い版で開いたら推測せず正直に止まるための宣言（versioning 契約 原則 3 と同型）。特定版を要求しない素材では省略する。",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "min_overlay_runtime_version": {
      "$comment": "この素材のライブ編集機能が要求する @akari-video/overlay-runtime の最低版（任意。2026-08-06 層ミラー data-mirror 規約の導入で新設）。min_app_version と同じ哲学 — 満たさない runtime では該当機能を推測で動かさない。初期表示だけなら未満でも正しく出る素材（例: 全層同一テキスト焼き込み出荷のミラー素材）はその旨を ai_usage / provenance に書く。",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "remote": {
      "type": "boolean",
      "description": "true の場合、このエントリはカタログ上のみに存在し実体ファイルを持たない。source ブロックが実体の代わりになる（2026-07-14 追記・任意フィールド）。"
    },
    "source": {
      "$ref": "#/$defs/source"
    }
  },
  "$defs": {
    "knob": {
      "type": "object",
      "description": "型固有の追加属性は将来の契約で定義する。v0 では既知属性だけを型検証する。バインド先は cssVar（オーバーレイ素材）か param（3D ベイクレシピ、2026-07-14 追記）のどちらか一方を必須とする。",
      "required": ["type", "group"],
      "oneOf": [
        { "required": ["cssVar"], "not": { "required": ["param"] } },
        { "required": ["param"], "not": { "required": ["cssVar"] } }
      ],
      "properties": {
        "cssVar": {
          "type": "string",
          "pattern": "^--[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "param": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": ["text", "color", "slider", "dropdown", "checkbox", "media"]
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "generator"],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "generator": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "pattern": "\\S" }
          ]
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "scope",
        "attribution_required",
        "ai_training_allowed"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "attribution_required": {
          "type": "boolean"
        },
        "ai_training_allowed": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "description": "カタログ（remote: true）エントリの取得元情報。2026-07-14 追記・任意フィールド。",
      "additionalProperties": false,
      "required": ["url", "acquisition", "license_at_source", "attribution_required"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "acquisition": {
          "type": "string",
          "enum": ["direct", "login", "purchase"]
        },
        "license_at_source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "attribution_required": {
          "type": "boolean"
        },
        "preview_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    }
  }
}
