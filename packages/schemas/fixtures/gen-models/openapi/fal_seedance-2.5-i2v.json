              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bytedance/seedance-2.5/image-to-video": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
