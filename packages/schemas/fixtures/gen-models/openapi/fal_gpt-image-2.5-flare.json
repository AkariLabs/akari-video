{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for openai/gpt-image-2.5/flare/text-to-image",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the openai/gpt-image-2.5/flare/text-to-image queue.",
    "x-fal-metadata": {
      "endpointId": "openai/gpt-image-2.5/flare/text-to-image",
      "category": "text-to-image",
      "playgroundUrl": "<url-removed>",
      "documentationUrl": "<url-removed>",
      "about": "Generate images with the selected GPT Image 2.5 model."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "GptImage25FlareTextToImageInput": {
        "properties": {
          "quality": {
            "enum": [
              "auto",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "high",
            "type": "string",
            "description": "Quality for the generated image. Higher settings increase detail, latency, and token usage. Use 'auto' to let the model choose.",
            "title": "Quality"
          },
          "image_size": {
            "default": "landscape_4_3",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9",
                  "auto"
                ],
                "type": "string"
              }
            ],
            "title": "Image Size",
            "description": "The size of the generated image. Supports preset names, explicit {width, height}, or 'auto' to let the model pick the best size. Concrete sizes must have both dimensions as multiples of 16, max edge 3840px, aspect ratio <= 3:1, total pixels between 655,360 and 8,294,400."
          },
          "num_images": {
            "minimum": 1,
            "default": 1,
            "maximum": 10,
            "type": "integer",
            "description": "Number of images to generate",
            "title": "Number of Images"
          },
          "prompt": {
            "minLength": 1,
            "maxLength": 32000,
            "description": "The prompt for image generation",
            "title": "Prompt",
            "type": "string"
          },
          "background": {
            "enum": [
              "auto",
              "transparent",
              "opaque"
            ],
            "default": "auto",
            "type": "string",
            "description": "Background for the generated image",
            "title": "Background"
          },
          "sync_mode": {
            "default": false,
            "type": "boolean",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "title": "Sync Mode"
          },
          "output_format": {
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "default": "png",
            "type": "string",
            "description": "Output format for the images",
            "title": "Output Format"
          },
          "output_compression": {
            "anyOf": [
              {
                "minimum": 0,
                "maximum": 100,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Compression",
            "description": "Compression level from 0 to 100. Only supported when output_format is 'jpeg' or 'webp'."
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "image_size",
          "background",
          "quality",
          "num_images",
          "output_format",
          "output_compression",
          "sync_mode"
        ],
        "type": "object",
        "description": "GPT Image 2.5 generation inputs, kept separate from GPT Image 2.",
        "title": "GPTImage25TextToImageRequest",
        "required": [
          "prompt"
        ]
      },
      "GptImage25FlareTextToImageOutput": {
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "type": "array",
            "description": "The generated images.",
            "title": "Images"
          }
        },
        "x-fal-order-properties": [
          "images"
        ],
        "type": "object",
        "title": "ImageResponse",
        "required": [
          "images"
        ]
      },
      "ImageSize": {
        "properties": {
          "height": {
            "default": 512,
            "maximum": 14142,
            "type": "integer",
            "description": "The height of the generated image.",
            "title": "Height",
            "exclusiveMinimum": 0
          },
          "width": {
            "default": 512,
            "maximum": 14142,
            "type": "integer",
            "description": "The width of the generated image.",
            "title": "Width",
            "exclusiveMinimum": 0
          }
        },
        "type": "object",
        "title": "ImageSize",
        "x-fal-order-properties": [
          "width",
          "height"
        ]
      },
      "ImageFile": {
        "properties": {
          "content_type": {
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height",
            "description": "The height of the image"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width",
            "description": "The width of the image"
          },
          "file_size": {
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size"
          },
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name"
          },
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "type": "object",
        "title": "ImageFile",
        "required": [
          "url"
        ]
      }
    }
  },
  "paths": {
    "/openai/gpt-image-2.5/flare/text-to-image/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/openai/gpt-image-2.5/flare/text-to-image/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openai/gpt-image-2.5/flare/text-to-image": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GptImage25FlareTextToImageInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/openai/gpt-image-2.5/flare/text-to-image/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GptImage25FlareTextToImageOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
