{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akari-video:schema:edit:v1",
  "title": "AKARI Video edit.json v0/v1",
  "description": "単一ソースの v0 と、sources[] と cuts[].src を使うマルチソース v1 の公開契約。",
  "oneOf": [
    { "$ref": "#/$defs/editV0" },
    { "$ref": "#/$defs/editV1" }
  ],
  "$defs": {
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "output": {
      "type": "object",
      "additionalProperties": true,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "$ref": "#/$defs/positiveNumber" },
        "height": { "$ref": "#/$defs/positiveNumber" },
        "fps": { "$ref": "#/$defs/positiveNumber" }
      }
    },
    "sourceV0": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "proxy": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "pattern": "\\S" }
          ]
        }
      }
    },
    "sourceV1": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "path", "proxy"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "proxy": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "pattern": "\\S" }
          ]
        }
      }
    },
    "narrationProvenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "engine": { "type": "string" },
        "voice": { "type": "string" },
        "credit": { "type": "string" },
        "generated_at": { "type": "string" }
      },
      "$comment": "provider は voicevox/fal/elevenlabs/human を契約文書で例示するのみで enum 強制はしない。provider === voicevox のときの credit 必須は validate-edit.mjs で検証する（兄弟値比較のため）。"
    },
    "narrationItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "path", "t", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^n-\\d{4}$" },
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t": { "$ref": "#/$defs/seconds" },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 },
        "script": { "type": "string" },
        "reading": { "type": "string" },
        "provenance": { "$ref": "#/$defs/narrationProvenance" }
      }
    },
    "bgm": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 },
        "ducking": { "type": "boolean" }
      }
    },
    "sfxItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "t"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t": { "$ref": "#/$defs/seconds" },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": true,
      "$comment": "bgm/sfx は docs/contract-2026-07-14-edit-json-v1-audio.md の確定契約どおり型定義済み（bgm はオブジェクト単数・sfx は配列。§6）。",
      "properties": {
        "narration": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrationItem" }
        },
        "bgm": { "$ref": "#/$defs/bgm" },
        "sfx": {
          "type": "array",
          "items": { "$ref": "#/$defs/sfxItem" }
        }
      }
    },
    "cutV0": {
      "type": "object",
      "additionalProperties": true,
      "required": ["in", "out"],
      "properties": {
        "in": { "$ref": "#/$defs/seconds" },
        "out": { "$ref": "#/$defs/seconds" }
      },
      "not": { "required": ["src"] },
      "$comment": "out > in は JSON Schema 標準だけでは兄弟値を比較できないため validate-edit.mjs でも検証する。"
    },
    "cutV1": {
      "type": "object",
      "additionalProperties": true,
      "required": ["src", "in", "out"],
      "properties": {
        "src": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "in": { "$ref": "#/$defs/seconds" },
        "out": { "$ref": "#/$defs/seconds" }
      },
      "$comment": "src の参照整合と out > in は validate-edit.mjs でも検証する。"
    },
    "overlayItem": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "track": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 }
      }
    },
    "editV0": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "output", "source"],
      "properties": {
        "version": { "const": 0 },
        "output": { "$ref": "#/$defs/output" },
        "source": { "$ref": "#/$defs/sourceV0" },
        "cuts": {
          "type": "array",
          "items": { "$ref": "#/$defs/cutV0" }
        },
        "overlays": {
          "type": "array",
          "items": { "$ref": "#/$defs/overlayItem" }
        },
        "audio": { "$ref": "#/$defs/audio" }
      },
      "not": { "required": ["sources"] }
    },
    "editV1": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "output", "sources"],
      "properties": {
        "version": { "const": 1 },
        "output": { "$ref": "#/$defs/output" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceV1" }
        },
        "cuts": {
          "type": "array",
          "items": { "$ref": "#/$defs/cutV1" }
        },
        "overlays": {
          "type": "array",
          "items": { "$ref": "#/$defs/overlayItem" }
        },
        "audio": { "$ref": "#/$defs/audio" }
      },
      "not": { "required": ["source"] }
    }
  }
}
