{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akari-video:schema:edit:v1",
  "title": "AKARI Video edit.json v0/v1",
  "description": "単一ソースの v0 と、sources[] と cuts[].src を使うマルチソース v1 の公開契約。",
  "oneOf": [
    { "$ref": "#/$defs/editV0" },
    { "$ref": "#/$defs/editV1" }
  ],
  "$defs": {
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "look": {
      "type": "object",
      "additionalProperties": true,
      "required": ["lut"],
      "properties": {
        "lut": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #4。lut はプリセット参照名（presets/luts/ 配下）または .cube への相対パス。intensity 省略時 1.0。"
    },
    "output": {
      "type": "object",
      "additionalProperties": true,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "$ref": "#/$defs/positiveNumber" },
        "height": { "$ref": "#/$defs/positiveNumber" },
        "fps": { "$ref": "#/$defs/positiveNumber" },
        "look": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/look" }] },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quality": { "enum": ["master", "high", "standard", "light"] },
            "encoder": { "enum": ["auto", "videotoolbox", "x264"] }
          }
        }
      }
    },
    "chromaKey": {
      "type": "object",
      "additionalProperties": true,
      "required": ["color"],
      "properties": {
        "color": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "similarity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blend": { "type": "number", "minimum": 0, "maximum": 1 },
        "background": { "type": "string", "minLength": 1, "pattern": "\\S" }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #2。background は色文字列（#rrggbb 等）または画像/動画パス。similarity/blend 省略時はそれぞれ 0.2/0.1。"
    },
    "sourceV0": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "proxy": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "pattern": "\\S" }
          ]
        },
        "chroma_key": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/chromaKey" }] }
      }
    },
    "sourceV1": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "path", "proxy"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "proxy": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "pattern": "\\S" }
          ]
        },
        "chroma_key": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/chromaKey" }] }
      }
    },
    "narrationProvenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "engine": { "type": "string" },
        "voice": { "type": "string" },
        "credit": { "type": "string" },
        "generated_at": { "type": "string" }
      },
      "$comment": "provider は voicevox/fal/elevenlabs/human を契約文書で例示するのみで enum 強制はしない。provider === voicevox のときの credit 必須は validate-edit.mjs で検証する（兄弟値比較のため）。"
    },
    "narrationItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "path", "t", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^n-\\d{4}$" },
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t": { "$ref": "#/$defs/seconds" },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 },
        "script": { "type": "string" },
        "reading": { "type": "string" },
        "provenance": { "$ref": "#/$defs/narrationProvenance" }
      }
    },
    "bgm": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 },
        "ducking": { "type": "boolean" },
        "in": { "$ref": "#/$defs/seconds" },
        "fadeIn": { "$ref": "#/$defs/seconds" },
        "fadeOut": { "$ref": "#/$defs/seconds" }
      },
      "$comment": "fadeIn/fadeOut は秒・省略時 0（フェードなし）。BGM は timeline 全体尺にループ+トリムされるため、どちらかが timeline 尺/2 を超えて指定された場合は尺/2 にクランプされる（render-cut が実装、edit-lint がクランプ発生時に warning を出す）。in は BGM ファイル内の開始オフセット（素材秒・省略時 0）— ループ・fadeIn/fadeOut の既存意味論には影響しない（不変）。"
    },
    "sfxItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "t"],
      "properties": {
        "track": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t": { "$ref": "#/$defs/seconds" },
        "in": { "$ref": "#/$defs/seconds" },
        "out": { "$ref": "#/$defs/positiveNumber" },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 }
      },
      "$comment": "再生区間 = 素材の [in, out)。in は素材秒・省略時 0（素材頭から）。out は素材秒・省略時 素材末尾まで。タイムライン上の開始は従来どおり t（timeline 秒）・表示尺 = out − in。out > in が必須（edit-lint が検証）。実尺越えは消費側（render-cut / preview）が素材末尾へクランプする。"
    },
    "audioMaster": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "denoise": { "enum": ["off", "std", "strong"] },
        "loudnorm": { "type": "number", "minimum": -70, "maximum": 0 },
        "true_peak_dbtp": { "type": "number", "minimum": -9, "maximum": 0 }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #5。denoise 省略時 off（無処理）。loudnorm 省略時 -14（既定ターゲット LUFS）— master オブジェクトが存在する時点でラウドネス正規化は既定で有効という実装判断（司令塔裁定。denoise には off という無効化用の値があるが loudnorm には無いため）。"
    },
    "audio": {
      "type": "object",
      "additionalProperties": true,
      "$comment": "bgm/sfx は docs/contract-2026-07-14-edit-json-v1-audio.md の確定契約どおり型定義済み（bgm はオブジェクト単数・sfx は配列。§6）。master は docs/contract-2026-07-22-render-basics.md #5。",
      "properties": {
        "narration": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrationItem" }
        },
        "bgm": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bgm" }] },
        "sfx": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "#/$defs/sfxItem" } }
          ]
        },
        "master": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/audioMaster" }] }
      }
    },
    "beatItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "t", "kind", "strength"],
      "properties": {
        "id": { "type": "string", "pattern": "^b-\\d{4}$" },
        "src": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t": { "$ref": "#/$defs/seconds" },
        "kind": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "basis": { "type": "string" }
      },
      "$comment": "docs/contract-2026-07-22-edit-json-v1-beats.md（見せ場マーカー）。t は timeline 秒ではなく (src, source 秒) アンカー（同 §3）。kind は hook/turn/punchline/reveal/emotion を契約文書で例示するのみで enum 強制はしない。id のファイル内一意性と src の参照整合（v1: sources[].id に存在すること / v0: src 自体を使用できないこと）は兄弟値の突き合わせが要るため JSON Schema では表現せず validate-edit.mjs と edit-lint が検証する（cutV1.src と同じ扱い）。"
    },
    "emphasisWordItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "t_start", "t_end", "word", "emotion"],
      "properties": {
        "id": { "type": "string", "pattern": "^e-\\d{4}$" },
        "src": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t_start": { "$ref": "#/$defs/seconds" },
        "t_end": { "$ref": "#/$defs/seconds" },
        "word": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "emotion": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "style_hint": { "type": "string" }
      },
      "$comment": "docs/contract-2026-07-23-edit-json-v1-emphasis-words.md（語レベル演出）。t_start/t_end は timeline 秒ではなく (src, source 秒) アンカー（同 §3）であり、analysis の transcriptSegment.words / captions.json の words[] の実測時刻を写す（同 §4）。emotion は joy/pain/surprise/anger/sadness/emphasis を、style_hint は one-char-bang/size-pulse/color-accent を契約文書で例示するのみで enum 強制はしない。t_end > t_start・id のファイル内一意性・src の参照整合（v1: sources[].id に存在すること / v0: src 自体を使用できないこと）は兄弟値の突き合わせが要るため JSON Schema では表現せず validate-edit.mjs と edit-lint が検証する（cutV0.out > in / cutV1.src と同じ扱い）。"
    },
    "direction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["preset"],
      "properties": {
        "preset": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "intensity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "overrides": { "type": "object" }
      },
      "$comment": "docs/contract-2026-07-23-edit-json-v1-direction.md（演出宣言）。配列ではなくオブジェクト = 宣言はファイルに 1 つ（同 §1）。preset は youtube-long-standard/shorts-high-energy/calm-explainer を契約文書で例示するのみで enum 強制はしない（narration provider と同じ流儀）。intensity は output.look.intensity（[0,1] の実数）とは別物で、整数 [0, 100]・既定 50（同 §4）。overrides は語彙未定義のため type object のみを見る（同 §6）。"
    },
    "transitionOut": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "duration"],
      "properties": {
        "type": { "enum": ["dissolve", "fade-black", "fade-white"] },
        "duration": { "$ref": "#/$defs/positiveNumber" }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #3。v0 は指定されたカット境界のみ xfade 経路（残裁定3）。ffmpeg xfade の transition 名へ直接対応: dissolve/fadeblack/fadewhite。"
    },
    "cutTransform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "scale": { "$ref": "#/$defs/positiveNumber" },
        "rotate": { "type": "number" }
      },
      "$comment": "cuts[].transform 用。layerTransform と同語彙・同意味論（x/y=px 省略時0・scale=正の数 省略時1・rotate=度 省略時0）。layerTransform は additionalProperties:true のため既存 layerItem 検証結果を変えないよう独立した $def にしている（cuts 側は未知キーを拒否）。"
    },
    "cutCrop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #6。出力キャンバス相対（0..1）の静的クロップ窓。x+w<=1 / y+h<=1（窓がキャンバス内に収まる）は兄弟値比較のため validate-edit.mjs で検証する。"
    },
    "cutFramingKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "scale"],
      "properties": {
        "t": { "$ref": "#/$defs/seconds" },
        "scale": { "$ref": "#/$defs/positiveNumber" },
        "cx": { "type": "number", "minimum": 0, "maximum": 1 },
        "cy": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #6。t はカット内秒（速度適用後のローカル時間）。cx/cy 省略時 0.5（画角中心）。scale < 1 はレンダ側で 1 にクランプされる（クロップ実装はキャンバス外へは広げられないため）。"
    },
    "cutFraming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crop": { "$ref": "#/$defs/cutCrop" },
        "keyframes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/cutFramingKeyframe" }
        }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #6（cuts[].framing）。keyframes は 2 点でズーム（開始/終了）・3 点以上で段階縮小（区間ごと線形補間）。crop と keyframes を両方宣言した場合は keyframes を優先する（crop は 1 点ズームの縮退形であり両立に意味がないため）。t の昇順・重複禁止は兄弟値比較のため validate-edit.mjs で検証する。"
    },
    "cutFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_sec", "duration_sec"],
      "properties": {
        "at_sec": { "$ref": "#/$defs/seconds" },
        "duration_sec": { "$ref": "#/$defs/positiveNumber" }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #7（cuts[].freeze）。at_sec はカット内秒（速度適用後）でフレームを静止する時刻。duration_sec だけカット尺が伸びる（コンテンツを削らない）。at_sec がカットの再生尺を超えないことは兄弟値比較のため validate-edit.mjs で検証する。v0 は gap-aware タイムライン（明示 at/track）との併用不可（同ファイル #7 に明記）。"
    },
    "cutFx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "enum": ["noise", "particles", "vignette", "flare", "color-overlay"] },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "id": { "const": "color-overlay" } },
            "required": ["id"]
          },
          "then": {
            "required": ["params"],
            "properties": {
              "params": { "required": ["color"] }
            }
          }
        }
      ],
      "$comment": "docs/contract-2026-08-05-fx-v0.md（画面 FX 小語彙 v0。旧実装 FX 479 の移植ではなく新規 5 id）。intensity は全 id 共通ツマミ（省略時 1・0 は恒等）。params.color は vignette では black/white の選択（既定 black）、color-overlay では必須（フェード赤・黒マット相当を 1 id でカバーするため色指定なしに意味を持たない）。noise/particles/flare は params を使わない。"
    },
    "cutV0": {
      "type": "object",
      "additionalProperties": true,
      "required": ["in", "out"],
      "properties": {
        "at": { "$ref": "#/$defs/seconds" },
        "track": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "in": { "$ref": "#/$defs/seconds" },
        "out": { "$ref": "#/$defs/seconds" },
        "speed": { "$ref": "#/$defs/positiveNumber" },
        "transform": { "$ref": "#/$defs/cutTransform" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "transition_out": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/transitionOut" }] },
        "framing": { "$ref": "#/$defs/cutFraming" },
        "freeze": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cutFreeze" }] },
        "fx": { "type": "array", "items": { "$ref": "#/$defs/cutFx" } }
      },
      "not": { "required": ["src"] },
      "$comment": "out > in は JSON Schema 標準だけでは兄弟値を比較できないため validate-edit.mjs でも検証する。speed 省略時 1.0（等速）。fx は配列順 = 適用順（複数重ね掛け可）。"
    },
    "cutV1": {
      "type": "object",
      "additionalProperties": true,
      "required": ["src", "in", "out"],
      "properties": {
        "at": { "$ref": "#/$defs/seconds" },
        "track": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "src": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "in": { "$ref": "#/$defs/seconds" },
        "out": { "$ref": "#/$defs/seconds" },
        "speed": { "$ref": "#/$defs/positiveNumber" },
        "transform": { "$ref": "#/$defs/cutTransform" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "transition_out": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/transitionOut" }] },
        "framing": { "$ref": "#/$defs/cutFraming" },
        "freeze": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cutFreeze" }] },
        "fx": { "type": "array", "items": { "$ref": "#/$defs/cutFx" } }
      },
      "$comment": "src の参照整合と out > in は validate-edit.mjs でも検証する。speed 省略時 1.0（等速）。fx は配列順 = 適用順（複数重ね掛け可）。"
    },
    "overlayItem": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "track": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 }
      }
    },
    "layerTransform": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "scale": { "$ref": "#/$defs/positiveNumber" },
        "rotate": { "type": "number" }
      }
    },
    "layerBlendMode": {
      "type": "string",
      "enum": ["normal", "screen", "multiply", "add", "difference", "darken", "lighten", "overlay", "hardlight", "softlight"],
      "$comment": "ffmpeg blend= の c0_mode 名に対応（normal は render-cut 側の合成語彙で overlay= 直合成を意味し、ffmpeg blend= フィルタは経由しない）。"
    },
    "layerVideoChromaKey": {
      "type": "object",
      "additionalProperties": true,
      "required": ["color"],
      "properties": {
        "color": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "similarity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blend": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "$comment": "kind===video レイヤーの背景置換用（ffmpeg chromakey= 準拠: color/similarity/blend）。R1（render-basics）の source.chroma_key と語彙は揃えるが $defs は独立させている（並行実装の衝突回避・rebase 時に統合を検討）。"
    },
    "layerCrop": {
      "type": "object",
      "additionalProperties": true,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "$comment": "PiP レイヤーの空間クロップ（切り抜き）。0..1 正規化・ソースフレーム相対・静的（時間変化なし）。px 絶対は採らない（比率切替ラウンドの教訓）。x+w<=1・y+h<=1 は宣言的なレンジでは表現できないため validate-edit.mjs のセマンティック検証で担保する。適用順は render-cut/src/layers.mjs の合成チェーンで crop→scale→rotate→opacity→overlay（契約 contract-2026-08-02-preview-parity.md）。"
    },
    "layerPerspective": {
      "type": "object",
      "additionalProperties": true,
      "required": ["corners"],
      "properties": {
        "corners": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      },
      "$comment": "PiP レイヤーの corner-pin パース変形（案 A・v0）。SSOT は 4 隅の正規化座標のみ:corners=[TL,TR,BL,BR]（各 [x,y] は 0..1・crop 適用後の層ボックス相対）・静的（時間変化なし。キーフレームは transform 全般の共通設計として別起票）。プリセット（右奥/左奥/上奥/下奥）+ 角度ツマミはオーサリング側（UI）で 4 隅へ展開してから保存する。退化四角形（面積ほぼ0）の拒否は validate-edit.mjs のセマンティック検証で担保する。適用順は render-cut/src/layers.mjs の合成チェーンで crop→scale→perspective→rotate→opacity→overlay（契約 contract-2026-08-02-preview-parity.md §2.4.4）。書き出しは ffmpeg perspective（透明パディング→内側へコーナーピン→元サイズへクロップ戻し）、プレビュー（shell/Web 両面）は同じ 4 隅から computeLayerPerspectiveVisual が CSS matrix3d を導出し、共に Heckbert のユニット正方形→四角形射影変換を使う（意図的なコード重複 — §2.2.1 と同じ方針。3 実装は同じ参照点でユニットテストして数値一致を担保）。"
    },
    "layerItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "t", "duration", "kind", "src"],
      "properties": {
        "track": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t": { "$ref": "#/$defs/seconds" },
        "duration": { "$ref": "#/$defs/positiveNumber" },
        "kind": { "enum": ["baked", "video"] },
        "src": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "preset": { "type": "string" },
        "params": { "type": "object" },
        "transform": { "$ref": "#/$defs/layerTransform" },
        "crop": { "$ref": "#/$defs/layerCrop" },
        "perspective": { "$ref": "#/$defs/layerPerspective" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blend": { "$ref": "#/$defs/layerBlendMode" },
        "chroma_key": { "$ref": "#/$defs/layerVideoChromaKey" }
      },
      "$comment": "契約 contract-2026-07-22-prerender-rail-and-assets.md §1.2。kind===baked は R2b の bake CLI が生成するアルファ付き mov（preset/params は再 bake 用の来歴）。kind===video は実映像（PinP 等）。chroma_key は kind===video のときのみ意味を持つ（validate-edit.mjs で検証）。crop は kind を問わず使える静的空間クロップ（#layerCrop）。perspective は kind を問わず使える静的 corner-pin パース変形（#layerPerspective）。render-cut は cuts 合成後のベース映像へ t 順に合成する。"
    },
    "trackState": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "muted": { "type": "boolean" },
        "hidden": { "type": "boolean" }
      }
    },
    "tracks": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cuts": { "type": "array", "items": { "$ref": "#/$defs/trackState" } },
        "overlays": { "type": "array", "items": { "$ref": "#/$defs/trackState" } },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/trackState" } },
        "audio": { "type": "array", "items": { "$ref": "#/$defs/trackState" } }
      }
    },
    "timelineTrack": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "kind": { "enum": ["cuts", "layers", "overlays", "captions", "audio"] },
        "ref": { "$ref": "#/$defs/nonNegativeInteger" },
        "label": { "type": "string" },
        "muted": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "locked": { "type": "boolean" }
      },
      "$comment": "timeline.tracks[] の器。配列順は画面の下から上。既存の tracks/trackState とは別契約。"
    },
    "timeline": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tracks"],
      "properties": {
        "tracks": {
          "type": "array",
          "items": { "$ref": "#/$defs/timelineTrack" }
        }
      }
    },
    "editV0": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "output", "source"],
      "properties": {
        "tracks": { "$ref": "#/$defs/tracks" },
        "timeline": { "$ref": "#/$defs/timeline" },
        "version": { "const": 0 },
        "output": { "$ref": "#/$defs/output" },
        "source": { "$ref": "#/$defs/sourceV0" },
        "cuts": {
          "type": "array",
          "items": { "$ref": "#/$defs/cutV0" }
        },
        "overlays": {
          "type": "array",
          "items": { "$ref": "#/$defs/overlayItem" }
        },
        "audio": { "$ref": "#/$defs/audio" },
        "layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/layerItem" }
        },
        "beats": {
          "type": "array",
          "items": { "$ref": "#/$defs/beatItem" }
        },
        "emphasis_words": {
          "type": "array",
          "items": { "$ref": "#/$defs/emphasisWordItem" }
        },
        "direction": { "$ref": "#/$defs/direction" }
      },
      "not": { "required": ["sources"] }
    },
    "editV1": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "output", "sources"],
      "properties": {
        "tracks": { "$ref": "#/$defs/tracks" },
        "timeline": { "$ref": "#/$defs/timeline" },
        "version": { "const": 1 },
        "output": { "$ref": "#/$defs/output" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceV1" }
        },
        "cuts": {
          "type": "array",
          "items": { "$ref": "#/$defs/cutV1" }
        },
        "overlays": {
          "type": "array",
          "items": { "$ref": "#/$defs/overlayItem" }
        },
        "audio": { "$ref": "#/$defs/audio" },
        "layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/layerItem" }
        },
        "beats": {
          "type": "array",
          "items": { "$ref": "#/$defs/beatItem" }
        },
        "emphasis_words": {
          "type": "array",
          "items": { "$ref": "#/$defs/emphasisWordItem" }
        },
        "direction": { "$ref": "#/$defs/direction" }
      },
      "not": { "required": ["source"] }
    }
  }
}
