{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akari-video:schema:edit:v1",
  "title": "AKARI Video edit.json v0/v1",
  "description": "単一ソースの v0 と、sources[] と cuts[].src を使うマルチソース v1 の公開契約。",
  "oneOf": [
    { "$ref": "#/$defs/editV0" },
    { "$ref": "#/$defs/editV1" }
  ],
  "$defs": {
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "look": {
      "type": "object",
      "additionalProperties": true,
      "required": ["lut"],
      "properties": {
        "lut": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #4。lut はカタログ参照名（catalog/luts/ 配下）または .cube への相対パス。intensity 省略時 1.0。"
    },
    "output": {
      "type": "object",
      "additionalProperties": true,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "$ref": "#/$defs/positiveNumber" },
        "height": { "$ref": "#/$defs/positiveNumber" },
        "fps": { "$ref": "#/$defs/positiveNumber" },
        "look": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/look" }] }
      }
    },
    "chromaKey": {
      "type": "object",
      "additionalProperties": true,
      "required": ["color"],
      "properties": {
        "color": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "similarity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blend": { "type": "number", "minimum": 0, "maximum": 1 },
        "background": { "type": "string", "minLength": 1, "pattern": "\\S" }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #2。background は色文字列（#rrggbb 等）または画像/動画パス。similarity/blend 省略時はそれぞれ 0.2/0.1。"
    },
    "sourceV0": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "proxy": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "pattern": "\\S" }
          ]
        },
        "chroma_key": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/chromaKey" }] }
      }
    },
    "sourceV1": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "path", "proxy"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "proxy": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "pattern": "\\S" }
          ]
        },
        "chroma_key": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/chromaKey" }] }
      }
    },
    "narrationProvenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "engine": { "type": "string" },
        "voice": { "type": "string" },
        "credit": { "type": "string" },
        "generated_at": { "type": "string" }
      },
      "$comment": "provider は voicevox/fal/elevenlabs/human を契約文書で例示するのみで enum 強制はしない。provider === voicevox のときの credit 必須は validate-edit.mjs で検証する（兄弟値比較のため）。"
    },
    "narrationItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "path", "t", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^n-\\d{4}$" },
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t": { "$ref": "#/$defs/seconds" },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 },
        "script": { "type": "string" },
        "reading": { "type": "string" },
        "provenance": { "$ref": "#/$defs/narrationProvenance" }
      }
    },
    "bgm": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 },
        "ducking": { "type": "boolean" },
        "in": { "$ref": "#/$defs/seconds" },
        "fadeIn": { "$ref": "#/$defs/seconds" },
        "fadeOut": { "$ref": "#/$defs/seconds" }
      },
      "$comment": "fadeIn/fadeOut は秒・省略時 0（フェードなし）。BGM は timeline 全体尺にループ+トリムされるため、どちらかが timeline 尺/2 を超えて指定された場合は尺/2 にクランプされる（render-cut が実装、edit-lint がクランプ発生時に warning を出す）。in は BGM ファイル内の開始オフセット（素材秒・省略時 0）— ループ・fadeIn/fadeOut の既存意味論には影響しない（不変）。"
    },
    "sfxItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "t"],
      "properties": {
        "track": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t": { "$ref": "#/$defs/seconds" },
        "in": { "$ref": "#/$defs/seconds" },
        "out": { "$ref": "#/$defs/positiveNumber" },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 }
      },
      "$comment": "再生区間 = 素材の [in, out)。in は素材秒・省略時 0（素材頭から）。out は素材秒・省略時 素材末尾まで。タイムライン上の開始は従来どおり t（timeline 秒）・表示尺 = out − in。out > in が必須（edit-lint が検証）。実尺越えは消費側（render-cut / preview）が素材末尾へクランプする。"
    },
    "audioMaster": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "denoise": { "enum": ["off", "std", "strong"] },
        "loudnorm": { "type": "number", "minimum": -70, "maximum": 0 }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #5。denoise 省略時 off（無処理）。loudnorm 省略時 -14（既定ターゲット LUFS）— master オブジェクトが存在する時点でラウドネス正規化は既定で有効という実装判断（司令塔裁定。denoise には off という無効化用の値があるが loudnorm には無いため）。"
    },
    "audio": {
      "type": "object",
      "additionalProperties": true,
      "$comment": "bgm/sfx は docs/contract-2026-07-14-edit-json-v1-audio.md の確定契約どおり型定義済み（bgm はオブジェクト単数・sfx は配列。§6）。master は docs/contract-2026-07-22-render-basics.md #5。",
      "properties": {
        "narration": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrationItem" }
        },
        "bgm": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bgm" }] },
        "sfx": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "#/$defs/sfxItem" } }
          ]
        },
        "master": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/audioMaster" }] }
      }
    },
    "beatItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "t", "kind", "strength"],
      "properties": {
        "id": { "type": "string", "pattern": "^b-\\d{4}$" },
        "src": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t": { "$ref": "#/$defs/seconds" },
        "kind": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "basis": { "type": "string" }
      },
      "$comment": "docs/contract-2026-07-22-edit-json-v1-beats.md（見せ場マーカー）。t は timeline 秒ではなく (src, source 秒) アンカー（同 §3）。kind は hook/turn/punchline/reveal/emotion を契約文書で例示するのみで enum 強制はしない。id のファイル内一意性と src の参照整合（v1: sources[].id に存在すること / v0: src 自体を使用できないこと）は兄弟値の突き合わせが要るため JSON Schema では表現せず validate-edit.mjs と edit-lint が検証する（cutV1.src と同じ扱い）。"
    },
    "emphasisWordItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "t_start", "t_end", "word", "emotion"],
      "properties": {
        "id": { "type": "string", "pattern": "^e-\\d{4}$" },
        "src": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t_start": { "$ref": "#/$defs/seconds" },
        "t_end": { "$ref": "#/$defs/seconds" },
        "word": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "emotion": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "style_hint": { "type": "string" }
      },
      "$comment": "docs/contract-2026-07-23-edit-json-v1-emphasis-words.md（語レベル演出）。t_start/t_end は timeline 秒ではなく (src, source 秒) アンカー（同 §3）であり、analysis の transcriptSegment.words / captions.json の words[] の実測時刻を写す（同 §4）。emotion は joy/pain/surprise/anger/sadness/emphasis を、style_hint は one-char-bang/size-pulse/color-accent を契約文書で例示するのみで enum 強制はしない。t_end > t_start・id のファイル内一意性・src の参照整合（v1: sources[].id に存在すること / v0: src 自体を使用できないこと）は兄弟値の突き合わせが要るため JSON Schema では表現せず validate-edit.mjs と edit-lint が検証する（cutV0.out > in / cutV1.src と同じ扱い）。"
    },
    "direction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["preset"],
      "properties": {
        "preset": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "intensity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "overrides": { "type": "object" }
      },
      "$comment": "docs/contract-2026-07-23-edit-json-v1-direction.md（演出宣言）。配列ではなくオブジェクト = 宣言はファイルに 1 つ（同 §1）。preset は youtube-long-standard/shorts-high-energy/calm-explainer を契約文書で例示するのみで enum 強制はしない（narration provider と同じ流儀）。intensity は output.look.intensity（[0,1] の実数）とは別物で、整数 [0, 100]・既定 50（同 §4）。overrides は語彙未定義のため type object のみを見る（同 §6）。"
    },
    "transitionOut": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "duration"],
      "properties": {
        "type": { "enum": ["dissolve", "fade-black", "fade-white"] },
        "duration": { "$ref": "#/$defs/positiveNumber" }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #3。v0 は指定されたカット境界のみ xfade 経路（残裁定3）。ffmpeg xfade の transition 名へ直接対応: dissolve/fadeblack/fadewhite。"
    },
    "cutTransform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "scale": { "$ref": "#/$defs/positiveNumber" },
        "rotate": { "type": "number" }
      },
      "$comment": "cuts[].transform 用。layerTransform と同語彙・同意味論（x/y=px 省略時0・scale=正の数 省略時1・rotate=度 省略時0）。layerTransform は additionalProperties:true のため既存 layerItem 検証結果を変えないよう独立した $def にしている（cuts 側は未知キーを拒否）。"
    },
    "cutV0": {
      "type": "object",
      "additionalProperties": true,
      "required": ["in", "out"],
      "properties": {
        "at": { "$ref": "#/$defs/seconds" },
        "track": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "in": { "$ref": "#/$defs/seconds" },
        "out": { "$ref": "#/$defs/seconds" },
        "speed": { "$ref": "#/$defs/positiveNumber" },
        "transform": { "$ref": "#/$defs/cutTransform" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "transition_out": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/transitionOut" }] }
      },
      "not": { "required": ["src"] },
      "$comment": "out > in は JSON Schema 標準だけでは兄弟値を比較できないため validate-edit.mjs でも検証する。speed 省略時 1.0（等速）。"
    },
    "cutV1": {
      "type": "object",
      "additionalProperties": true,
      "required": ["src", "in", "out"],
      "properties": {
        "at": { "$ref": "#/$defs/seconds" },
        "track": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "src": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "in": { "$ref": "#/$defs/seconds" },
        "out": { "$ref": "#/$defs/seconds" },
        "speed": { "$ref": "#/$defs/positiveNumber" },
        "transform": { "$ref": "#/$defs/cutTransform" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "transition_out": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/transitionOut" }] }
      },
      "$comment": "src の参照整合と out > in は validate-edit.mjs でも検証する。speed 省略時 1.0（等速）。"
    },
    "overlayItem": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "track": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 }
      }
    },
    "layerTransform": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "scale": { "$ref": "#/$defs/positiveNumber" },
        "rotate": { "type": "number" }
      }
    },
    "layerBlendMode": {
      "type": "string",
      "enum": ["normal", "screen", "multiply", "add", "difference", "darken", "lighten", "overlay", "hardlight", "softlight"],
      "$comment": "ffmpeg blend= の c0_mode 名に対応（normal は render-cut 側の合成語彙で overlay= 直合成を意味し、ffmpeg blend= フィルタは経由しない）。"
    },
    "layerVideoChromaKey": {
      "type": "object",
      "additionalProperties": true,
      "required": ["color"],
      "properties": {
        "color": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "similarity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blend": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "$comment": "kind===video レイヤーの背景置換用（ffmpeg chromakey= 準拠: color/similarity/blend）。R1（render-basics）の source.chroma_key と語彙は揃えるが $defs は独立させている（並行実装の衝突回避・rebase 時に統合を検討）。"
    },
    "layerItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "t", "duration", "kind", "src"],
      "properties": {
        "track": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t": { "$ref": "#/$defs/seconds" },
        "duration": { "$ref": "#/$defs/positiveNumber" },
        "kind": { "enum": ["baked", "video"] },
        "src": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "preset": { "type": "string" },
        "params": { "type": "object" },
        "transform": { "$ref": "#/$defs/layerTransform" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blend": { "$ref": "#/$defs/layerBlendMode" },
        "chroma_key": { "$ref": "#/$defs/layerVideoChromaKey" }
      },
      "$comment": "契約 contract-2026-07-22-prerender-rail-and-assets.md §1.2。kind===baked は R2b の bake CLI が生成するアルファ付き mov（preset/params は再 bake 用の来歴）。kind===video は実映像（PinP 等）。chroma_key は kind===video のときのみ意味を持つ（validate-edit.mjs で検証）。render-cut は cuts 合成後のベース映像へ t 順に合成する。"
    },
    "trackState": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "muted": { "type": "boolean" },
        "hidden": { "type": "boolean" }
      }
    },
    "tracks": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cuts": { "type": "array", "items": { "$ref": "#/$defs/trackState" } },
        "overlays": { "type": "array", "items": { "$ref": "#/$defs/trackState" } },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/trackState" } },
        "audio": { "type": "array", "items": { "$ref": "#/$defs/trackState" } }
      }
    },
    "timelineTrack": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "kind": { "enum": ["cuts", "layers", "overlays", "captions", "audio"] },
        "ref": { "$ref": "#/$defs/nonNegativeInteger" },
        "label": { "type": "string" },
        "muted": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "locked": { "type": "boolean" }
      },
      "$comment": "timeline.tracks[] の器。配列順は画面の下から上。既存の tracks/trackState とは別契約。"
    },
    "timeline": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tracks"],
      "properties": {
        "tracks": {
          "type": "array",
          "items": { "$ref": "#/$defs/timelineTrack" }
        }
      }
    },
    "editV0": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "output", "source"],
      "properties": {
        "tracks": { "$ref": "#/$defs/tracks" },
        "timeline": { "$ref": "#/$defs/timeline" },
        "version": { "const": 0 },
        "output": { "$ref": "#/$defs/output" },
        "source": { "$ref": "#/$defs/sourceV0" },
        "cuts": {
          "type": "array",
          "items": { "$ref": "#/$defs/cutV0" }
        },
        "overlays": {
          "type": "array",
          "items": { "$ref": "#/$defs/overlayItem" }
        },
        "audio": { "$ref": "#/$defs/audio" },
        "layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/layerItem" }
        },
        "beats": {
          "type": "array",
          "items": { "$ref": "#/$defs/beatItem" }
        },
        "emphasis_words": {
          "type": "array",
          "items": { "$ref": "#/$defs/emphasisWordItem" }
        },
        "direction": { "$ref": "#/$defs/direction" }
      },
      "not": { "required": ["sources"] }
    },
    "editV1": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "output", "sources"],
      "properties": {
        "tracks": { "$ref": "#/$defs/tracks" },
        "timeline": { "$ref": "#/$defs/timeline" },
        "version": { "const": 1 },
        "output": { "$ref": "#/$defs/output" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceV1" }
        },
        "cuts": {
          "type": "array",
          "items": { "$ref": "#/$defs/cutV1" }
        },
        "overlays": {
          "type": "array",
          "items": { "$ref": "#/$defs/overlayItem" }
        },
        "audio": { "$ref": "#/$defs/audio" },
        "layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/layerItem" }
        },
        "beats": {
          "type": "array",
          "items": { "$ref": "#/$defs/beatItem" }
        },
        "emphasis_words": {
          "type": "array",
          "items": { "$ref": "#/$defs/emphasisWordItem" }
        },
        "direction": { "$ref": "#/$defs/direction" }
      },
      "not": { "required": ["source"] }
    }
  }
}
