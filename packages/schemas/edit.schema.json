{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akari-video:schema:edit:v1",
  "title": "AKARI Video edit.json v0/v1",
  "description": "単一ソースの v0 と、sources[] と cuts[].src を使うマルチソース v1 の公開契約。",
  "oneOf": [
    { "$ref": "#/$defs/editV0" },
    { "$ref": "#/$defs/editV1" },
    { "$ref": "#/$defs/editV2" }
  ],
  "$defs": {
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "frames": {
      "type": "integer",
      "minimum": 0,
      "$comment": "notes-2026-08-18-timeline-latency-and-track-model.md §10 / §10-1。出力側の位置と尺は映像・音声とも 0 以上の整数フレームで宣言する。"
    },
    "itemAtV2": {
      "$ref": "#/$defs/frames",
      "$comment": "notes-2026-08-18-timeline-latency-and-track-model.md §10。v2 Phase 0 では絶対フレーム整数だけを受け付ける。将来はこの $def を oneOf: [frames, string] に拡張し、明示的な相対参照を追加する。"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "look": {
      "type": "object",
      "additionalProperties": true,
      "required": ["lut"],
      "properties": {
        "lut": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #4。lut はプリセット参照名（presets/luts/ 配下）または .cube への相対パス。intensity 省略時 1.0。"
    },
    "output": {
      "type": "object",
      "additionalProperties": true,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "$ref": "#/$defs/positiveNumber" },
        "height": { "$ref": "#/$defs/positiveNumber" },
        "fps": { "$ref": "#/$defs/positiveNumber" },
        "look": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/look" }] },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quality": { "enum": ["master", "high", "standard", "light"] },
            "encoder": { "enum": ["auto", "videotoolbox", "x264"] }
          }
        }
      }
    },
    "outputV2": {
      "type": "object",
      "additionalProperties": true,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "$ref": "#/$defs/positiveNumber" },
        "height": { "$ref": "#/$defs/positiveNumber" },
        "fps": { "type": "integer", "minimum": 1 },
        "look": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/look" }] },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quality": { "enum": ["master", "high", "standard", "light"] },
            "encoder": { "enum": ["auto", "videotoolbox", "x264"] }
          }
        }
      },
      "$comment": "notes-2026-08-18-timeline-latency-and-track-model.md §10-1。v2 の出力 fps は 1 以上の整数に固定する。29.97 / 23.976 が必要になった時点で有理数 {num, den} へ拡張する。既存 output は v0/v1 の互換契約として変更しない。"
    },
    "chromaKey": {
      "type": "object",
      "additionalProperties": true,
      "required": ["color"],
      "properties": {
        "color": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "similarity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blend": { "type": "number", "minimum": 0, "maximum": 1 },
        "background": { "type": "string", "minLength": 1, "pattern": "\\S" }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #2。background は色文字列（#rrggbb 等）または画像/動画パス。similarity/blend 省略時はそれぞれ 0.2/0.1。"
    },
    "sourceV0": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "proxy": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "pattern": "\\S" }
          ]
        },
        "chroma_key": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/chromaKey" }] }
      },
      "$comment": "docs/contract-2026-08-12-still-image-cut-source-v0.md 裁定1: path が静止画拡張子（png/jpe?g/webp/bmp/gif、大小無視）のとき、cuts[] はこのソースを静止画として扱う。判定は拡張子のみで、この $def に isStatic 等の新フィールドは足さない（packages/render-cut/src/layers.mjs の IMAGE_LAYER_SOURCE_PATTERN と同一集合）。静止画ソースは v0 の「cuts 空 = source 全体」を適用できない（画像に尺が無いため）ため cuts の明示が必須（edit-lint の cuts.still-image-cuts-required が検証）。"
    },
    "sourceV1": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "path", "proxy"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "proxy": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "pattern": "\\S" }
          ]
        },
        "chroma_key": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/chromaKey" }] }
      },
      "$comment": "docs/contract-2026-08-12-still-image-cut-source-v0.md 裁定1: path が静止画拡張子（sourceV0 と同一集合）のとき、cuts[].src でこの source を参照するカットは静止画として扱われる（video/image のソース混在が v1 の主眼）。cuts[].in は 0 推奨・out - in が表示尺（cuts[].freeze/speed は動作はするが無意味なため edit-lint が警告する）。"
    },
    "sourceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "proxy": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "pattern": "\\S" }
          ]
        },
        "chroma_key": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/chromaKey" }] }
      }
    },
    "narrationProvenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "engine": { "type": "string" },
        "voice": { "type": "string" },
        "credit": { "type": "string" },
        "generated_at": { "type": "string" }
      },
      "$comment": "provider は voicevox/fal/elevenlabs/human を契約文書で例示するのみで enum 強制はしない。provider === voicevox のときの credit 必須は validate-edit.mjs で検証する（兄弟値比較のため）。"
    },
    "narrationItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "path", "t", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^n-\\d{4}$" },
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t": { "$ref": "#/$defs/seconds" },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 },
        "script": { "type": "string" },
        "reading": { "type": "string" },
        "provenance": { "$ref": "#/$defs/narrationProvenance" }
      }
    },
    "bgm": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 },
        "ducking": { "type": "boolean" },
        "in": { "$ref": "#/$defs/seconds" },
        "fadeIn": { "$ref": "#/$defs/seconds" },
        "fadeOut": { "$ref": "#/$defs/seconds" }
      },
      "$comment": "fadeIn/fadeOut は秒・省略時 0（フェードなし）。BGM は timeline 全体尺にループ+トリムされるため、どちらかが timeline 尺/2 を超えて指定された場合は尺/2 にクランプされる（render-cut が実装、edit-lint がクランプ発生時に warning を出す）。in は BGM ファイル内の開始オフセット（素材秒・省略時 0）— ループ・fadeIn/fadeOut の既存意味論には影響しない（不変）。"
    },
    "sfxItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "t"],
      "properties": {
        "track": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t": { "$ref": "#/$defs/seconds" },
        "in": { "$ref": "#/$defs/seconds" },
        "out": { "$ref": "#/$defs/positiveNumber" },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 },
        "fade_in": { "$ref": "#/$defs/seconds" },
        "fade_out": { "$ref": "#/$defs/seconds" }
      },
      "$comment": "再生区間 = 素材の [in, out)。in は素材秒・省略時 0（素材頭から）。out は素材秒・省略時 素材末尾まで。タイムライン上の開始は従来どおり t（timeline 秒）・表示尺 = out − in。out > in が必須（edit-lint が検証）。実尺越えは消費側（render-cut / preview）が素材末尾へクランプする。fade_in/fade_out は秒・省略時 0（フェードなし。docs/contract-2026-07-25-r6-audio-tracks-and-trim.md §2 追記、audio-clip-fades task）。フェード対象はこのクリップの実効再生窓 [t, t + 実効尺)（実効尺 = out − in、in/out 省略時は素材尺）。audio.bgm.fadeIn/fadeOutと同じ『実効尺の半分まで』クランプ規則を適用する（render-cut が実装、edit-lint がクランプ発生時に warning を出す）。"
    },
    "audioMaster": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "denoise": { "enum": ["off", "std", "strong"] },
        "loudnorm": { "type": "number", "minimum": -70, "maximum": 0 },
        "true_peak_dbtp": { "type": "number", "minimum": -9, "maximum": 0 }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #5。denoise 省略時 off（無処理）。loudnorm 省略時 -14（既定ターゲット LUFS）— master オブジェクトが存在する時点でラウドネス正規化は既定で有効という実装判断（司令塔裁定。denoise には off という無効化用の値があるが loudnorm には無いため）。"
    },
    "audio": {
      "type": "object",
      "additionalProperties": true,
      "$comment": "bgm/sfx は docs/contract-2026-07-14-edit-json-v1-audio.md の確定契約どおり型定義済み（bgm はオブジェクト単数・sfx は配列。§6）。master は docs/contract-2026-07-22-render-basics.md #5。",
      "properties": {
        "narration": {
          "type": "array",
          "items": { "$ref": "#/$defs/narrationItem" }
        },
        "bgm": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bgm" }] },
        "sfx": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "#/$defs/sfxItem" } }
          ]
        },
        "master": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/audioMaster" }] }
      }
    },
    "beatItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "t", "kind", "strength"],
      "properties": {
        "id": { "type": "string", "pattern": "^b-\\d{4}$" },
        "src": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t": { "$ref": "#/$defs/seconds" },
        "kind": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "basis": { "type": "string" }
      },
      "$comment": "docs/contract-2026-07-22-edit-json-v1-beats.md（見せ場マーカー）。t は timeline 秒ではなく (src, source 秒) アンカー（同 §3）。kind は hook/turn/punchline/reveal/emotion を契約文書で例示するのみで enum 強制はしない。id のファイル内一意性と src の参照整合（v1: sources[].id に存在すること / v0: src 自体を使用できないこと）は兄弟値の突き合わせが要るため JSON Schema では表現せず validate-edit.mjs と edit-lint が検証する（cutV1.src と同じ扱い）。"
    },
    "emphasisWordItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "t_start", "t_end", "word", "emotion"],
      "properties": {
        "id": { "type": "string", "pattern": "^e-\\d{4}$" },
        "src": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "t_start": { "$ref": "#/$defs/seconds" },
        "t_end": { "$ref": "#/$defs/seconds" },
        "word": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "emotion": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "style_hint": { "type": "string" }
      },
      "$comment": "docs/contract-2026-07-23-edit-json-v1-emphasis-words.md（語レベル演出）。t_start/t_end は timeline 秒ではなく (src, source 秒) アンカー（同 §3）であり、analysis の transcriptSegment.words / captions.json の words[] の実測時刻を写す（同 §4）。emotion は joy/pain/surprise/anger/sadness/emphasis を、style_hint は one-char-bang/size-pulse/color-accent を契約文書で例示するのみで enum 強制はしない。t_end > t_start・id のファイル内一意性・src の参照整合（v1: sources[].id に存在すること / v0: src 自体を使用できないこと）は兄弟値の突き合わせが要るため JSON Schema では表現せず validate-edit.mjs と edit-lint が検証する（cutV0.out > in / cutV1.src と同じ扱い）。"
    },
    "direction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["preset"],
      "properties": {
        "preset": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "intensity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "overrides": { "type": "object" }
      },
      "$comment": "docs/contract-2026-07-23-edit-json-v1-direction.md（演出宣言）。配列ではなくオブジェクト = 宣言はファイルに 1 つ（同 §1）。preset は youtube-long-standard/shorts-high-energy/calm-explainer を契約文書で例示するのみで enum 強制はしない（narration provider と同じ流儀）。intensity は output.look.intensity（[0,1] の実数）とは別物で、整数 [0, 100]・既定 50（同 §4）。overrides は語彙未定義のため type object のみを見る（同 §6）。"
    },
    "transitionOut": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "duration"],
      "properties": {
        "type": { "enum": ["dissolve", "fade-black", "fade-white", "reveal-down", "reveal-up"] },
        "duration": { "$ref": "#/$defs/positiveNumber" }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #3。v0 は指定されたカット境界のみ xfade 経路（残裁定3）。ffmpeg xfade の transition 名へ直接対応: dissolve/fadeblack/fadewhite/revealdown/revealup。reveal-down / reveal-up は前カットが丸ごとその方向へ動いて画面外へ抜け、空いた側から次カットが現れる（2026-08-14 追加）。"
    },
    "cutTransform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "scale": { "$ref": "#/$defs/positiveNumber" },
        "rotate": { "type": "number" }
      },
      "$comment": "cuts[].transform 用。layerTransform と同語彙・同意味論（x/y=px 省略時0・scale=正の数 省略時1・rotate=度 省略時0）。layerTransform は additionalProperties:true のため既存 layerItem 検証結果を変えないよう独立した $def にしている（cuts 側は未知キーを拒否）。"
    },
    "cutCrop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #6。出力キャンバス相対（0..1）の静的クロップ窓。x+w<=1 / y+h<=1（窓がキャンバス内に収まる）は兄弟値比較のため validate-edit.mjs で検証する。"
    },
    "cutFramingKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "scale"],
      "properties": {
        "t": { "$ref": "#/$defs/seconds" },
        "scale": { "$ref": "#/$defs/positiveNumber" },
        "cx": { "type": "number", "minimum": 0, "maximum": 1 },
        "cy": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #6。t はカット内秒（速度適用後のローカル時間）。cx/cy 省略時 0.5（画角中心）。scale < 1 はレンダ側で 1 にクランプされる（クロップ実装はキャンバス外へは広げられないため）。"
    },
    "cutFraming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crop": { "$ref": "#/$defs/cutCrop" },
        "keyframes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/cutFramingKeyframe" }
        }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #6（cuts[].framing）。keyframes は 2 点でズーム（開始/終了）・3 点以上で段階縮小（区間ごと線形補間）。crop と keyframes を両方宣言した場合は keyframes を優先する（crop は 1 点ズームの縮退形であり両立に意味がないため）。t の昇順・重複禁止は兄弟値比較のため validate-edit.mjs で検証する。"
    },
    "cutFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_sec", "duration_sec"],
      "properties": {
        "at_sec": { "$ref": "#/$defs/seconds" },
        "duration_sec": { "$ref": "#/$defs/positiveNumber" }
      },
      "$comment": "docs/contract-2026-07-22-render-basics.md #7（cuts[].freeze）。at_sec はカット内秒（速度適用後）でフレームを静止する時刻。duration_sec だけカット尺が伸びる（コンテンツを削らない）。at_sec がカットの再生尺を超えないことは兄弟値比較のため validate-edit.mjs で検証する。v0 は gap-aware タイムライン（明示 at/track）との併用不可（同ファイル #7 に明記）。"
    },
    "cutFx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": { "type": "string", "minLength": 1 }
          }
        }
      },
      "$comment": "docs/contract-2026-08-05-fx-v0.md（画面 FX 小語彙 v0 の技術仕様。旧実装 FX 479 の移植ではなく新規 5 id として起票）。2026-08-11 撤去: v0 の 5 id（noise/particles/vignette/flare/color-overlay）はオーナー裁定により製品面から撤去し、id の enum を string へ緩和した（データ契約の三原則 — 受け口を広げる方向の互換。docs/contract-2026-07-17-data-contract-versioning.md）。presets/fx/ の FX_BUILDERS に未登録の id はスキーマ上は valid のまま、render 側が警告 + no-op で通す（packages/render-cut/src/fx.mjs）。intensity は全 id 共通ツマミ（省略時 1・0 は恒等）。params.color は色を使う fx が任意で使う置き場（形は維持）。"
    },
    "cutV0": {
      "type": "object",
      "additionalProperties": true,
      "required": ["in", "out"],
      "properties": {
        "at": { "$ref": "#/$defs/seconds" },
        "track": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "in": { "$ref": "#/$defs/seconds" },
        "out": { "$ref": "#/$defs/seconds" },
        "speed": { "$ref": "#/$defs/positiveNumber" },
        "transform": { "$ref": "#/$defs/cutTransform" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "transition_out": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/transitionOut" }] },
        "framing": { "$ref": "#/$defs/cutFraming" },
        "freeze": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cutFreeze" }] },
        "fx": { "type": "array", "items": { "$ref": "#/$defs/cutFx" } }
      },
      "not": { "required": ["src"] },
